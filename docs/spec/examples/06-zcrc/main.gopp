package main

import (
	"fmt"
	"os"

	"github.com/madler/zlib/zlib.h" // header of a cdep locked in gopp.mod; package name: zlib
)

func main() {
	data := os.ReadFile!("input.txt")
	fmt.Printf("size:    %d bytes\n", len(data))

	// uLong is uint64 on Linux (a typedef in package zlib), uInt is uint32.
	// The []byte passes to the `const Bytef*` parameter as its data pointer.
	crc := zlib.crc32(0, data, uint32(len(data)))
	fmt.Printf("crc32:   %08x\n", crc)

	// the same checksum, fed in chunks of 7 bytes
	var running uint64
	for i := 0; i < len(data); i += 7 {
		chunk := data[i:min(i+7, len(data))] // view []byte: no copy
		running = zlib.crc32(running, chunk, uint32(len(chunk)))
	}
	fmt.Printf("chunked: %08x\n", running)

	// the temporary []byte lives until the end of the statement
	fmt.Printf("check:   %08x\n", zlib.crc32(0, []byte("123456789"), 9))
}
