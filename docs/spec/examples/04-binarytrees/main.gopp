package main

import (
	"fmt"
	"mem"
)

const (
	minDepth = 4
	maxDepth = 10
)

// Node owns its children: dropping the root frees the whole tree.
// A leaf has no children: pointers are never nil, so the links are Options.
type Node struct {
	Left, Right Option[Unique[Node]]
}

func bottomUp(depth int) Unique[Node] {
	if depth <= 0 {
		return NewUnique(Node{})
	}
	// The two temporaries move into the literal, and the literal into NewUnique.
	return NewUnique(Node{Left: bottomUp(depth - 1), Right: bottomUp(depth - 1)})
}

func (n *Node) check() int {
	// The fields are borrowed as Option[*Node] (no copy), then checked.
	var l, r Option[*Node] = n.Left, n.Right
	if l == nil || r == nil {
		return 1
	}
	return 1 + l.check() + r.check() // l and r are *Node here
}

// ANode lives in an arena: borrow-carrying structs of *ANode are arena-safe (OWN-B1, OWN-B5).
type ANode struct {
	Left, Right Option[*ANode]
}

func bottomUpArena(a *mem.Arena, depth int) *ANode {
	n := mem.ArenaNew[ANode](a)
	n.Left, n.Right = nil, nil // do not rely on the arena zeroing its memory
	if depth > 0 {
		n.Left = bottomUpArena(a, depth-1)
		n.Right = bottomUpArena(a, depth-1)
	}
	return n
}

func (n *ANode) check() int {
	l, r := n.Left, n.Right // trivial: plain copies
	if l == nil || r == nil {
		return 1
	}
	return 1 + l.check() + r.check()
}

func main() {
	{
		stretch := bottomUp(maxDepth + 1)
		fmt.Printf("stretch tree of depth %d\t check: %d\n", maxDepth+1, stretch.check())
	} // stretch is dropped here: all its nodes are freed

	long := bottomUp(maxDepth) // lives until main ends

	var arena mem.Arena
	defer arena.Free() // arena also frees on drop (SLC-3); defer Free() exercises PAN-3 alongside Reset()

	for depth := minDepth; depth <= maxDepth; depth += 2 {
		iterations := 1 << uint(maxDepth-depth+minDepth)
		check := 0
		for i := 0; i < iterations; i++ {
			arena.Reset() // frees every node of the previous tree at once
			check += bottomUpArena(&arena, depth).check()
		}
		fmt.Printf("%d\t trees of depth %d\t check: %d\n", iterations, depth, check)
	}

	fmt.Printf("long lived tree of depth %d\t check: %d\n", maxDepth, long.check())
}
