package main

import (
	"cmp"
	"fmt"
	"slices"
	"sync"
)

type Job struct {
	ID   int
	Text string // immutable shared handle (OWN-C2): Send and Sync
}

type Result struct {
	ID   int
	Text string
	Sum  int
}

// jobs and results are shared handles: passing them lends a handle, not the queue.
func work(jobs chan Job, results chan Result) {
	for job := range jobs { // each receive transfers a Job out of the channel
		sum := 0
		for i := 0; i < len(job.Text); i++ {
			sum += int(job.Text[i])
		}
		// job is on its last use here, so job.Text transfers with 0 retain/release.
		results <- Result{ID: job.ID, Text: job.Text, Sum: sum}
	}
}

func main() {
	words := []string{"alpha", "beta", "gamma", "delta", "epsilon", "zeta", "eta", "theta"}

	jobs := make(chan Job, 4)
	results := make(chan Result, 16)

	var wg sync.WaitGroup
	for w := 0; w < 3; w++ {
		wg.Add(1)
		// `go work(jobs, results, &wg)` would be an error: raw pointer to a local (CON-2).
		// The closure keeps wg, jobs and results in shared cells instead.
		go func() {
			defer wg.Done()
			work(jobs, results)
		}()
	}
	go func() {
		wg.Wait()
		close(results)
	}()

	for i, w := range words {
		jobs <- Job{ID: i, Text: w}
	}
	close(jobs)

	var all []Result
	for r := range results {
		all = append(all, r) // r is on its last use: auto-moved into all
	}
	slices.SortFunc(all, func(a, b Result) int { return cmp.Compare(a.ID, b.ID) })

	total := 0
	for _, r := range all { // r is lent
		fmt.Printf("%d %-8s sum=%d\n", r.ID, r.Text, r.Sum)
		total += r.Sum
	}
	fmt.Println("total:", total)
}
