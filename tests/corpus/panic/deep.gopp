package main

type Node struct {
	value int
	kids  []Node
}

func sum(n Node, path []int) int {
	if len(path) == 0 {
		return n.value
	}
	return n.value + sum(n.kids[path[0]], path[1:])
}

func main() {
	tree := Node{1, []Node{{2, nil}, {3, []Node{{4, nil}}}}}
	println(sum(tree, nil), sum(tree, []int{0}), sum(tree, []int{1, 0}))
	println(sum(tree, []int{1, 0, 2}))
}
