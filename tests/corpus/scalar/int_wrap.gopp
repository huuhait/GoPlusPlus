package main

func main() {
	var a int8 = 127
	a++
	var b int16 = -32768
	b--
	var c int32 = 2147483647
	c += 2
	var d int64 = 9223372036854775807
	d++
	println(a, b, c, d)

	var e uint8 = 0
	e--
	var f uint16 = 65535
	f += 2
	var g uint32 = 0
	g -= 3
	var h uint64 = 18446744073709551615
	h++
	println(e, f, g, h)

	var m int8 = -128
	println(-m, m*m, m/-1, m%-1)
	var n int32 = 46341
	println(n*n, n*n*n)
	var u uint8 = 200
	println(u+u, u*u, u<<1, u>>1, ^u)

	x := 1
	for i := 0; i < 70; i++ {
		x *= 3
	}
	println(x)
	var y uint = 1
	for i := 0; i < 70; i++ {
		y = y*5 + 1
	}
	println(y)
}
