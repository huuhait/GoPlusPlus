package main

func sqrt(x float64) float64 {
	z := x / 2
	for i := 0; i < 30; i++ {
		z -= (z*z - x) / (2 * z)
	}
	return z
}

func main() {
	a, b := 0.1, 0.2
	println(a+b, a+b == 0.3, a*b, a/b, a-b)
	println(sqrt(2), sqrt(144), sqrt(1e-10))
	var f32 float32 = 16777216
	println(f32+1, f32+2, float32(0.1), float64(float32(0.1)))
	zero := 0.0
	inf := 1 / zero
	nan := zero / zero
	println(inf, -inf, nan, inf-inf, inf > 1e308, nan == nan, nan != nan, nan < 1)
	big, tiny := 1e308, 5e-324
	println(big*10, -big*10, tiny/2, tiny, 1e-320)
	sum := 0.0
	for i := 1; i <= 1000; i++ {
		sum += 1 / float64(i*i)
	}
	println(sum)
	x := 1.0
	for i := 0; i < 60; i++ {
		x /= 2
	}
	println(x, 1+x == 1, 1+x*256 == 1)
	println(float32(1)/3, 2.5*4, -0.0, 1/(-zero), 100.0, 123456789.0, 1e21, 1e-7)
}
