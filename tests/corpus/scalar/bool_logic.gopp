package main

func t(trace *string, name string) bool {
	*trace += name
	return true
}

func f(trace *string, name string) bool {
	*trace += name
	return false
}

func n(trace *string, name string, v int) int {
	*trace += name
	return v
}

func main() {
	trace := ""
	println(t(&trace, "a") || f(&trace, "b"), trace)
	trace = ""
	println(f(&trace, "a") && t(&trace, "b"), trace)
	trace = ""
	println(f(&trace, "a") || t(&trace, "b") && f(&trace, "c") || t(&trace, "d"), trace)
	trace = ""
	println(!(t(&trace, "a") && !f(&trace, "b")) == f(&trace, "c"), trace)
	trace = ""
	println(n(&trace, "x", 1)+n(&trace, "y", 2)*n(&trace, "z", 3), trace)
	trace = ""
	xs := []int{n(&trace, "p", 1), n(&trace, "q", 2), n(&trace, "r", 3)}
	println(xs[n(&trace, "i", 0)]+xs[n(&trace, "j", 2)], trace)
	trace = ""
	if n(&trace, "m", 5) > 3 && n(&trace, "n", 1) < 0 || n(&trace, "o", 0) == 0 {
		println("taken", trace)
	}
	a, b := true, false
	println(a && b, a || b, !a, a != b, a == !b, (a || b) && !(a && b))
	count := 0
	for i := 0; i < 20; i++ {
		if i%2 == 0 && i%3 == 0 || i > 17 {
			count++
		}
	}
	println(count)
}
