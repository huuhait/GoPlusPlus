package main

var trace string

func t(name string) bool {
	trace += name
	return true
}

func f(name string) bool {
	trace += name
	return false
}

func n(name string, v int) int {
	trace += name
	return v
}

func main() {
	println(t("a") || f("b"), trace)
	trace = ""
	println(f("a") && t("b"), trace)
	trace = ""
	println(f("a") || t("b") && f("c") || t("d"), trace)
	trace = ""
	println(!(t("a") && !f("b")) == f("c"), trace)
	trace = ""
	println(n("x", 1)+n("y", 2)*n("z", 3), trace)
	trace = ""
	xs := []int{n("p", 1), n("q", 2), n("r", 3)}
	println(xs[n("i", 0)]+xs[n("j", 2)], trace)
	trace = ""
	if n("m", 5) > 3 && n("n", 1) < 0 || n("o", 0) == 0 {
		println("taken", trace)
	}
	a, b := true, false
	println(a && b, a || b, !a, a != b, a == !b, (a || b) && !(a && b))
	count := 0
	for i := 0; i < 20; i++ {
		if i%2 == 0 && i%3 == 0 || i > 17 {
			count++
		}
	}
	println(count)
}
