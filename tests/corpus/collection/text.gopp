package main

func split(s string, sep byte) []string {
	var out []string
	start := 0
	for i := 0; i < len(s); i++ {
		if s[i] == sep {
			out = append(out, s[start:i])
			start = i + 1
		}
	}
	return append(out, s[start:])
}

func join(parts []string, sep string) string {
	out := ""
	for i, p := range parts {
		if i > 0 {
			out += sep
		}
		out += p
	}
	return out
}

func trim(s string) string {
	for len(s) > 0 && s[0] == ' ' {
		s = s[1:]
	}
	for len(s) > 0 && s[len(s)-1] == ' ' {
		s = s[:len(s)-1]
	}
	return s
}

func itoa(n int) string {
	if n == 0 {
		return "0"
	}
	neg := n < 0
	if neg {
		n = -n
	}
	var buf []byte
	for n > 0 {
		buf = append(buf, byte('0'+n%10))
		n /= 10
	}
	if neg {
		buf = append(buf, '-')
	}
	for i, j := 0, len(buf)-1; i < j; i, j = i+1, j-1 {
		buf[i], buf[j] = buf[j], buf[i]
	}
	return string(buf)
}

func hex(data []byte) string {
	const digits = "0123456789abcdef"
	out := make([]byte, 0, len(data)*2)
	for _, b := range data {
		out = append(out, digits[b>>4], digits[b&15])
	}
	return string(out)
}

func main() {
	parts := split("a,b,,c d, e ", ',')
	println(len(parts), join(parts, "|"))
	for _, p := range parts {
		println("[" + trim(p) + "]")
	}
	println(itoa(0), itoa(-45), itoa(1234567890), itoa(7)+itoa(8))
	println(hex([]byte("Go++")), hex(nil) == "", hex([]byte{0, 255, 16}))
	csv := "name,age\nann,30\nbob,25"
	total := 0
	for i, line := range split(csv, '\n') {
		fields := split(line, ',')
		if i == 0 {
			println(len(fields), fields[1])
			continue
		}
		n := 0
		for _, c := range fields[1] {
			n = n*10 + int(c-'0')
		}
		total += n
	}
	println(total)
	palindromes := 0
	for _, w := range split("level noon abc racecar ab a", ' ') {
		ok := true
		for i, j := 0, len(w)-1; i < j; i, j = i+1, j-1 {
			ok = ok && w[i] == w[j]
		}
		if ok {
			palindromes++
		}
	}
	println(palindromes)
}
