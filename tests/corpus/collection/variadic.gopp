package main

func sum(xs ...int) int {
	total := 0
	for _, x := range xs {
		total += x
	}
	return total
}

func join(sep string, parts ...string) string {
	out := ""
	for i, p := range parts {
		if i > 0 {
			out += sep
		}
		out += p
	}
	return out
}

func count(args ...interface{}) (ints, strs, others int) {
	for _, a := range args {
		switch a.(type) {
		case int:
			ints++
		case string:
			strs++
		default:
			others++
		}
	}
	return
}

func first(def int, xs ...int) int {
	if len(xs) == 0 {
		return def
	}
	return xs[0]
}

func wrap(xs ...int) int { return sum(xs...) + len(xs) }

func main() {
	println(sum(), sum(1), sum(1, 2, 3), sum([]int{4, 5, 6}...))
	nums := []int{10, 20}
	println(sum(nums...), wrap(nums...), wrap(), wrap(1, 2, 3))
	println(join(", ", "a", "b", "c"), join("-"), join("+", []string{"x", "y"}...))
	i, s, o := count(1, "a", 2.5, 'c', "b", nil, true, 7)
	println(i, s, o)
	println(first(-1), first(-1, 5, 6), first(0, nums...))
	nums = append(nums, nums...)
	nums = append(nums[:1], nums[2:]...)
	println(len(nums), sum(nums...))
}
