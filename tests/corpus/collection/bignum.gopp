package main

func mulSmall(digits []int, k int) []int {
	out := make([]int, 0, len(digits)+2)
	carry := 0
	for _, d := range digits {
		v := d*k + carry
		out = append(out, v%10)
		carry = v / 10
	}
	for carry > 0 {
		out = append(out, carry%10)
		carry /= 10
	}
	return out
}

func add(a, b []int) []int {
	var out []int
	carry := 0
	for i := 0; i < len(a) || i < len(b) || carry > 0; i++ {
		v := carry
		if i < len(a) {
			v += a[i]
		}
		if i < len(b) {
			v += b[i]
		}
		out = append(out, v%10)
		carry = v / 10
	}
	return out
}

func text(digits []int) string {
	out := make([]byte, len(digits))
	for i, d := range digits {
		out[len(digits)-1-i] = byte('0' + d)
	}
	return string(out)
}

func main() {
	fact := []int{1}
	for k := 2; k <= 40; k++ {
		fact = mulSmall(fact, k)
	}
	println(text(fact), len(fact))
	a, b := []int{0}, []int{1}
	for i := 0; i < 150; i++ {
		a, b = b, add(a, b)
	}
	println(text(a))
	pow := []int{1}
	sum := 0
	for i := 0; i < 200; i++ {
		pow = mulSmall(pow, 2)
	}
	for _, d := range pow {
		sum += d
	}
	println(text(pow), sum)
}
