package main

func lcs(a, b string) int {
	t := make([][]int, len(a)+1)
	for i := range t {
		t[i] = make([]int, len(b)+1)
	}
	for i := 1; i <= len(a); i++ {
		for j := 1; j <= len(b); j++ {
			if a[i-1] == b[j-1] {
				t[i][j] = t[i-1][j-1] + 1
			} else {
				t[i][j] = max(t[i-1][j], t[i][j-1])
			}
		}
	}
	return t[len(a)][len(b)]
}

func edit(a, b string) int {
	prev := make([]int, len(b)+1)
	for j := range prev {
		prev[j] = j
	}
	for i := 1; i <= len(a); i++ {
		cur := make([]int, len(b)+1)
		cur[0] = i
		for j := 1; j <= len(b); j++ {
			cost := 1
			if a[i-1] == b[j-1] {
				cost = 0
			}
			cur[j] = min(prev[j]+1, cur[j-1]+1, prev[j-1]+cost)
		}
		prev = cur
	}
	return prev[len(b)]
}

func knapsack(weights, values []int, limit int) int {
	best := make([]int, limit+1)
	for i, w := range weights {
		for c := limit; c >= w; c-- {
			best[c] = max(best[c], best[c-w]+values[i])
		}
	}
	return best[limit]
}

func ways(coins []int, amount int) int {
	t := make([]int, amount+1)
	t[0] = 1
	for _, c := range coins {
		for a := c; a <= amount; a++ {
			t[a] += t[a-c]
		}
	}
	return t[amount]
}

func main() {
	println(lcs("AGGTAB", "GXTXAYB"), lcs("", "abc"), lcs("same", "same"))
	println(edit("kitten", "sitting"), edit("", "abc"), edit("flaw", "lawn"))
	println(knapsack([]int{1, 3, 4, 5}, []int{1, 4, 5, 7}, 7), knapsack(nil, nil, 10))
	println(ways([]int{1, 2, 5}, 11), ways([]int{2}, 3), ways([]int{1, 5, 10, 25, 50}, 100))
	memo := map[int]int{}
	var calls int
	for n := 1; n <= 50; n++ {
		a, b := memo[n-1], memo[n-2]
		if n <= 2 {
			a, b = 1, 0
		}
		memo[n] = a + b
		calls++
	}
	println(memo[50], calls, len(memo))
}
