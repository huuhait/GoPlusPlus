package main

func order() {
	for i := 0; i < 3; i++ {
		defer func() { print("d", i, " ") }()
	}
	print("body ")
}

func result() (n int) {
	defer func() { n *= 2 }()
	defer func() { n += 3 }()
	return 4
}

func args() {
	x := 1
	defer func(v int) { println("arg", v, "now", x) }(x)
	x = 2
}

func cleanup(log *[]string, name string) func() {
	*log = append(*log, "open "+name)
	return func() {}
}

func nested() string {
	out := ""
	func() {
		defer func() { out += "a" }()
		func() {
			defer func() { out += "b" }()
			out += "c"
		}()
		out += "d"
	}()
	return out
}

func early(n int) (out string) {
	defer func() { out += "!" }()
	if n < 0 {
		return "neg"
	}
	defer func() { out += "?" }()
	return "pos"
}

func main() {
	order()
	println()
	println(result())
	args()
	var log []string
	done := cleanup(&log, "f")
	done()
	println(len(log), log[0])
	println(nested(), early(-1), early(1))
	total := 0
	for i := 1; i <= 3; i++ {
		func() {
			defer func() { total += i }()
			total *= 2
		}()
	}
	println(total)
}
