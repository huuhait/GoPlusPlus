package main

var table = func() [5]int {
	var t [5]int
	for i := range t {
		t[i] = i * i
	}
	return t
}()

var greeting = func(name string) string { return "hi " + name }("there")

func main() {
	println(table[4], greeting)
	x := func() int { return 42 }()
	y := func(a, b int) int { return a * b }(6, 7)
	println(x, y, x == y)
	s := func(parts ...string) string {
		out := ""
		for _, p := range parts {
			out += p
		}
		return out
	}("a", "b", "c")
	println(s)
	n := 0
	func() {
		n++
		func() {
			n += 10
			func() { n += 100 }()
		}()
	}()
	println(n)
	q, r := func(a, b int) (int, int) { return a / b, a % b }(17, 5)
	println(q, r)
	sign := func(v int) string {
		switch {
		case v < 0:
			return "neg"
		case v > 0:
			return "pos"
		}
		return "zero"
	}
	println(sign(-3), sign(0), sign(8))
	total := 0
	for i := 0; i < 4; i++ {
		total += func(k int) int { return k * k }(i)
	}
	println(total, func() bool { return total > 10 }())
	println(func(f func(int) int) int { return f(f(2)) }(func(v int) int { return v * v * v }))
}
