package main

func main() {
	var squares []func() int
	for i := 0; i < 4; i++ {
		squares = append(squares, func() int { return i * i })
	}
	for _, f := range squares {
		print(f(), " ")
	}
	println()
	var names []func() string
	for _, name := range []string{"a", "b", "c"} {
		names = append(names, func() string { return name + name })
	}
	println(names[0](), names[1](), names[2]())
	var sums []func(int) int
	for i := range 3 {
		base := i * 10
		sums = append(sums, func(x int) int { return base + x + i })
	}
	println(sums[0](1), sums[1](1), sums[2](1))
	total := 0
	for i := 0; i < 5; i++ {
		add := func() { total += i }
		add()
		add()
	}
	println(total)
	var pairs []func() (int, string)
	for i, s := range []string{"x", "y"} {
		pairs = append(pairs, func() (int, string) { return i, s })
	}
	n, s := pairs[1]()
	m, t := pairs[0]()
	println(n, s, m, t)
	grid := [][]func() int{}
	for r := 0; r < 2; r++ {
		var row []func() int
		for c := 0; c < 2; c++ {
			row = append(row, func() int { return r*2 + c })
		}
		grid = append(grid, row)
	}
	println(grid[0][0](), grid[0][1](), grid[1][0](), grid[1][1]())
}
