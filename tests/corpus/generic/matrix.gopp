package main

type Number interface{ ~int | ~float64 }

type Matrix[T Number] struct {
	rows, cols int
	cells      []T
}

func New[T Number](rows, cols int) Matrix[T] {
	return Matrix[T]{rows, cols, make([]T, rows*cols)}
}

func Identity[T Number](n int) Matrix[T] {
	m := New[T](n, n)
	for i := 0; i < n; i++ {
		m.Set(i, i, 1)
	}
	return m
}

func (m Matrix[T]) At(r, c int) T { return m.cells[r*m.cols+c] }

func (m *Matrix[T]) Set(r, c int, v T) { m.cells[r*m.cols+c] = v }

func (m Matrix[T]) Mul(o Matrix[T]) Matrix[T] {
	out := New[T](m.rows, o.cols)
	for i := 0; i < m.rows; i++ {
		for j := 0; j < o.cols; j++ {
			var sum T
			for k := 0; k < m.cols; k++ {
				sum += m.At(i, k) * o.At(k, j)
			}
			out.Set(i, j, sum)
		}
	}
	return out
}

func (m Matrix[T]) Trace() T {
	var sum T
	for i := 0; i < m.rows && i < m.cols; i++ {
		sum += m.At(i, i)
	}
	return sum
}

func Power[T Number](m Matrix[T], n int) Matrix[T] {
	out := Identity[T](m.rows)
	for ; n > 0; n-- {
		out = out.Mul(m)
	}
	return out
}

func main() {
	m := New[int](2, 2)
	m.Set(0, 0, 1)
	m.Set(0, 1, 1)
	m.Set(1, 0, 1)
	p := Power(m, 40)
	println(p.At(0, 1), p.Trace(), Identity[int](3).Trace())
	f := New[float64](2, 2)
	f.Set(0, 0, 0.5)
	f.Set(1, 1, 0.25)
	f.Set(0, 1, 1)
	g := Power(f, 3)
	println(g.At(0, 0), g.At(1, 1), g.At(0, 1), g.Trace())
	wide := New[int](1, 3)
	tall := New[int](3, 1)
	for i := 0; i < 3; i++ {
		wide.Set(0, i, i+1)
		tall.Set(i, 0, i+4)
	}
	println(wide.Mul(tall).At(0, 0), tall.Mul(wide).At(2, 2), len(tall.Mul(wide).cells))
}
