package main

type Shape interface {
	Area() int
	Perimeter() int
}

type Named interface {
	Name() string
}

type NamedShape interface {
	Shape
	Named
}

type Rect struct{ w, h int }

func (r Rect) Area() int      { return r.w * r.h }
func (r Rect) Perimeter() int { return 2 * (r.w + r.h) }
func (r Rect) Name() string   { return "rect" }

type Square struct{ side int }

func (s Square) Area() int      { return s.side * s.side }
func (s Square) Perimeter() int { return 4 * s.side }
func (s Square) Name() string   { return "square" }

type Line struct{ length int }

func (l Line) Area() int      { return 0 }
func (l Line) Perimeter() int { return l.length }

func total(shapes []Shape) (area, perimeter int) {
	for _, s := range shapes {
		area += s.Area()
		perimeter += s.Perimeter()
	}
	return
}

func describe(s NamedShape) string { return s.Name() }

func largest(shapes []Shape) Shape {
	best := shapes[0]
	for _, s := range shapes[1:] {
		if s.Area() > best.Area() {
			best = s
		}
	}
	return best
}

func main() {
	shapes := []Shape{Rect{2, 3}, Square{4}, Line{7}, Rect{1, 1}}
	a, p := total(shapes)
	println(a, p)
	println(describe(Rect{1, 2}), describe(Square{1}))
	big := largest(shapes)
	println(big.Area(), big.Perimeter())
	var ns NamedShape = Square{3}
	var s Shape = ns
	var n Named = ns
	println(s.Area(), n.Name(), ns.Perimeter())
	shapes = append(shapes, ns)
	a, p = total(shapes)
	println(a, p, len(shapes))
}
