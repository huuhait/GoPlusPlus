package main

type Celsius float64

type Point struct{ x, y int }

type Stringer interface{ String() string }

func (p Point) String() string { return "point" }

func kind(v interface{}) string {
	switch x := v.(type) {
	case nil:
		return "nil"
	case int:
		if x < 0 {
			return "negative int"
		}
		return "int"
	case int8, int16, int32, int64:
		return "sized int"
	case string:
		return "string of " + string(rune('0'+len(x)))
	case bool:
		if x {
			return "yes"
		}
		return "no"
	case float64:
		return "float"
	case Celsius:
		return "celsius"
	case Stringer:
		return "stringer " + x.String()
	case []int:
		return "ints"
	case error:
		return "error " + x.Error()
	case func() int:
		return "func"
	}
	return "other"
}

type failure struct{}

func (failure) Error() string { return "failed" }

func main() {
	values := []interface{}{nil, 1, -1, int8(1), int64(1), "abc", true, false, 1.5, Celsius(1.5), Point{1, 2}, []int{1}, failure{}, uint(1), [2]int{}, map[string]int{}}
	for _, v := range values {
		println(kind(v))
	}
	println(kind(func() int { return 1 }), kind(struct{}{}), kind('a'), kind(byte(1)))
}
