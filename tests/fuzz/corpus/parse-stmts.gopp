package p

func f() {
	x := 1
	x = 2
	x += 3
	x++
	y--
	a, b := 1, 2
	a, b = b, a
	ch <- x
	go g(x)
	defer h()
	var v int
	const k = 1
	type L int
	{
		nested()
	}
lbl:
	for {
		break lbl
		continue lbl
	}
	goto lbl
	return
	return x, y
	fallthrough
	;
	_ = <-ch
	*p = 1
	p.x, q[1] = 1, 2
}
