package p

macro Swap(a expr, b expr) {
	tmp := a
	a = b
	b = tmp
}
macro Twice(x expr) {
	#Do(x)
	#Do(x)
}
macro Nothing() {}
macro func Derive(t reflect.Type) []string {
	return nil
}
macro func Gen(name string, n int) {
}
