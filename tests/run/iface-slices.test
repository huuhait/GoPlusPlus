// REQUIRES: host-linux-amd64 || host-linux-arm64
// RUN: %python %S/Inputs/run-golden.py --src %s %S/golden/iface-slices.out
// P04.06 with P04.25 (ADR-0029): methods and interfaces with slices. A value
// receiver of a slice type is a borrowed `[]T` and passes as (ptr, len),
// directly and through an itab (the thunk makes the pair from the boxed
// four-word slice); a pointer receiver of one grows the caller's slice; a
// borrowed `[]T` parameter and a variadic one of an interface method go as
// pairs through the itab slot; a slice (32 bytes) and a struct holding
// slices are boxed and asserted back whole. The expected output is what
// `go run` prints for this very file (Inputs/regen-goldens.py).
package main

type IntSlice []int

func (s IntSlice) Sum() int {
	t := 0
	for _, v := range s {
		t += v
	}
	return t
}

func (s IntSlice) First() int { return s[0] }

func (s *IntSlice) Push(v int) { *s = append(*s, v) }

type Summer interface {
	Sum() int
	First() int
}

type Acc struct{ n int }

func (a Acc) Total(xs []int, more ...int) int {
	t := a.n
	for _, v := range xs {
		t += v
	}
	return t + len(more)
}

type Totaler interface{ Total(xs []int, more ...int) int }

type Bag struct {
	Name  string
	Items []int
	Tags  [][]int
}

func main() {
	s := make(IntSlice, 3, 10)
	s[0], s[1], s[2] = 1, 2, 3
	println(s.Sum(), s.First(), len(s))
	var i Summer = s.Clone() // (the box owns its value: P04.09)
	println(i.Sum(), i.First())
	p := &s
	p.Push(4)
	println(p.Sum(), len(s))
	var j Summer = p
	println(j.Sum(), j.First())
	var t Totaler = Acc{100}
	println(t.Total([]int{1, 2}), t.Total(s, 7, 8), t.Total(nil))
	b := Bag{"b", []int{5, 6}, [][]int{{1}, {2, 3}}}
	var a any = b
	if bb, ok := a.(Bag); ok {
		println(bb.Name, len(bb.Items), bb.Items[1], len(bb.Tags[1]), bb.Tags[1][1])
	}
	var x any = s
	if xs, ok := x.(IntSlice); ok {
		println(len(xs), xs[3])
	}
	switch v := x.(type) {
	case []int:
		println("plain", len(v))
	case IntSlice:
		println("named", len(v))
	}
}
