// REQUIRES: host-linux-amd64, qemu-aarch64
// RUN: %gopp build -target=linux/arm64 -crt-dir=%aarch64_sysroot/lib %S/Inputs/generics/basics.gopp -o %t.basics
// RUN: %python %S/Inputs/run-golden.py --qemu %aarch64_sysroot %t.basics %S/Inputs/generics/basics.out 0
// RUN: %gopp build -target=linux/arm64 -crt-dir=%aarch64_sysroot/lib %S/Inputs/generics/types.gopp -o %t.types
// RUN: %python %S/Inputs/run-golden.py --qemu %aarch64_sysroot %t.types %S/Inputs/generics/types.out 0
// RUN: %gopp build -target=linux/arm64 -crt-dir=%aarch64_sysroot/lib %S/Inputs/generics/iface.gopp -o %t.iface
// RUN: %python %S/Inputs/run-golden.py --qemu %aarch64_sysroot %t.iface %S/Inputs/generics/iface.out 0
// RUN: %gopp build -target=linux/arm64 -crt-dir=%aarch64_sysroot/lib %S/Inputs/generics-gopp/option.gopp -o %t.option
// RUN: %python %S/Inputs/run-golden.py --qemu %aarch64_sysroot %t.option %S/Inputs/generics-gopp/option.out 0
// P04.08 on linux/arm64 under QEMU: four of the programs of generics-diff.test (functions, types, interfaces, Option of a type parameter) give the same output as on amd64.
