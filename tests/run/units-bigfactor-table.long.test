// REQUIRES: long, host-linux-amd64 || host-linux-arm64
// RUN: %python %S/Inputs/gen-units-bigtable.py --check %s %S/golden/units-bigfactor-table.long.out --rows 96
// RUN: %python %S/Inputs/run-golden.py --src %s %S/golden/units-bigfactor-table.long.out 0
// RUN: %if qemu-aarch64 %{ %gopp build -target=linux/arm64 -crt-dir=%aarch64_sysroot/lib %s -o %t.arm64 %}
// RUN: %if qemu-aarch64 %{ %python %S/Inputs/run-golden.py --qemu %aarch64_sysroot %t.arm64 %S/golden/units-bigfactor-table.long.out 0 %}
// GOLDEN: by-hand
// P04.24 (TODO item 1): written by Inputs/gen-units-bigtable.py (see there); do
// not edit. Plain code against generic code for random rationals made of the SI
// and CODATA factors and for the float32 and float64 boundaries; the golden is
// computed by the script with exact fractions.
package main

