// KM^4 / M^4: the factor 1000^4 = 10^12 (a descriptor's factor is exact up
// to 4096 bits each way: (KM/M)^8 and more in units-bigfactor.test; past
// them, the panic of Inputs/panics-gopp/unit-range-factor.gopp).
func Top4[U unit, V unit](a float64[U], b float64[V]) float64 {
	return Ratio(a*a*a*a, b*b*b*b)
}

func main() {
	println(Top4(1.0[KM], 1.0[M]))
	println(S200(1.0[KM], 1.0[M]), S199(1.0[KM], 1.0[M]))
	println(P200(1.0[KM]), P200(1.0[M]))
}
