// REQUIRES: host-linux-amd64 || host-linux-arm64
// RUN: %python %S/Inputs/run-golden.py --src %s %S/golden/units-dict-chain.out 0
// RUN: %if qemu-aarch64 %{ %gopp build -target=linux/arm64 -crt-dir=%aarch64_sysroot/lib %s -o %t.arm64 %}
// RUN: %if qemu-aarch64 %{ %python %S/Inputs/run-golden.py --qemu %aarch64_sysroot %t.arm64 %S/golden/units-dict-chain.out 0 %}
// GOLDEN: by-hand
// P04.24 (GEN-14, ADR-0025 Amendment): the unit descriptors travel through
// long chains. 200 generics that swap their two units (S0..S200: after an even
// number of swaps the units are as they were: Ratio(1 KM, 1 M) = 1000; after
// an odd number, Ratio(1 M, 1 KM) = 1/1000 = 0.001); 200 generics that each
// pass `U*S/S` on (the descriptor is multiplied by S and divided by S again at
// every level, a net 1: the unit is KM at the end: 1000); and (KM/M)^4 =
// 10^12. Each function is
// one instance with one descriptor for each unit parameter, however deep.
package main

unit M
unit S
unit KM = 1000 M

func Ratio[U unit, V unit](a float64[U], b float64[V]) float64 { return float64(a / b) }

func S0[U unit, V unit](a float64[U], b float64[V]) float64 { return Ratio(a, b) }
func S1[U unit, V unit](a float64[U], b float64[V]) float64 { return S0[V, U](b, a) }
func S2[U unit, V unit](a float64[U], b float64[V]) float64 { return S1[V, U](b, a) }
func S3[U unit, V unit](a float64[U], b float64[V]) float64 { return S2[V, U](b, a) }
func S4[U unit, V unit](a float64[U], b float64[V]) float64 { return S3[V, U](b, a) }
func S5[U unit, V unit](a float64[U], b float64[V]) float64 { return S4[V, U](b, a) }
func S6[U unit, V unit](a float64[U], b float64[V]) float64 { return S5[V, U](b, a) }
func S7[U unit, V unit](a float64[U], b float64[V]) float64 { return S6[V, U](b, a) }
func S8[U unit, V unit](a float64[U], b float64[V]) float64 { return S7[V, U](b, a) }
func S9[U unit, V unit](a float64[U], b float64[V]) float64 { return S8[V, U](b, a) }
func S10[U unit, V unit](a float64[U], b float64[V]) float64 { return S9[V, U](b, a) }
func S11[U unit, V unit](a float64[U], b float64[V]) float64 { return S10[V, U](b, a) }
