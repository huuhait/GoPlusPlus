package main

// P04.18: results of many shapes, in registers or through a hidden pointer
// (the convention decides; the program must not notice). Valid Go.

type Pair struct{ a, b int }
type Mix struct {
	f float64
	n int32
	b bool
	s string
}
type Big struct{ a, b, c, d, e, f, g, h, i, j int }
type Fl struct{ x, y, z, w float64 }

func two(a, b int) (int, int)                 { return b, a }
func three(a int) (int, int, int)             { return a, a + 1, a + 2 }
func mixed(a float64) (float64, int, float64) { return a, 1, a * 2 }
func five(a int) (int, int, int, int, int)    { return a, a + 1, a + 2, a + 3, a + 4 }
func nine(a int) (int, int, int, int, int, int, int, int, int) {
	return a, a + 1, a + 2, a + 3, a + 4, a + 5, a + 6, a + 7, a + 8
}
func floats(a float64) (float64, float64, float64, float64, float64) {
	return a, a * 2, a * 3, a * 4, a * 5
}
func str(s string) (string, int)             { return s + "!", len(s) }
func strs(a, b string) (string, string, int) { return b + "", a + "", len(a) + len(b) }
func pair(p, q Pair) Pair                    { return Pair{p.a + q.a, p.b + q.b} }
func mix(m Mix) Mix                          { return Mix{m.f, m.n + 1, m.b, m.s + "?"} }
func big(a int) Big                          { return Big{a, a + 1, a + 2, a + 3, a + 4, a + 5, a + 6, a + 7, a + 8, a + 9} }
func fl(a float64) Fl                        { return Fl{a, a + 1, a + 2, a + 3} }
func small(a int8, b uint16, c bool) (int8, uint16, bool) {
	return a + 1, b + 1, !c
}
func arr(a [2]int) [2]int             { return [2]int{a[1], a[0]} }
func arr3(a [3]int) [3]int            { a[0] = 9; return a }
func nested(p Pair) (Pair, Pair, int) { return p, Pair{p.b, p.a}, p.a + p.b }
func none()                           {}
func unit(a struct{}) struct{}        { return a }
func chain(a int) (int, int)          { x, y := two(a, a+1); return two(x, y) }

func main() {
	println(two(1, 2))
	println(three(1))
	println(mixed(1.5))
	println(five(10))
	println(nine(20))
	println(floats(0.5))
	println(str("abc"))
	println(strs("x", "yz"))
	println(pair(Pair{1, 2}, Pair{3, 4}).a, pair(Pair{1, 2}, Pair{3, 4}).b)
	m := mix(Mix{1.5, 7, true, "m"})
	println(m.f, m.n, m.b, m.s)
	b := big(100)
	println(b.a, b.e, b.j)
	f := fl(1)
	println(f.x, f.y, f.z, f.w)
	println(small(127, 65535, true))
	println(arr([2]int{1, 2})[0])
	a3 := [3]int{1, 2, 3}
	println(arr3(a3)[0], a3[0])
	n1, n2, n3 := nested(Pair{5, 6})
	println(n1.a, n1.b, n2.a, n2.b, n3)
	none()
	unit(struct{}{})
	println(chain(1))
}
