package main

// append growth: the stand-in of strings and slices (24 bytes, with a pointer)
// Generated by Inputs/gen-coll.py; the expected output is `go run`'s.

var dummy int

var s_str []struct{ p *int; a, b int }

func one_str() {
	println("str")
	last := -1
	for i := 1; i <= 2500; i++ {
		s_str = append(s_str, struct{ p *int; a, b int }{})
		if cap(s_str) != last {
			last = cap(s_str)
			println(i, last)
		}
	}
	s_str = nil
}

var s_strs []struct{ p *int; a, b int }

func one_strs() {
	println("strs")
	last := -1
	for i := 1; i <= 2500; i++ {
		s_strs = append(s_strs, struct{ p *int; a, b int }{})
		if cap(s_strs) != last {
			last = cap(s_strs)
			println(i, last)
		}
	}
	s_strs = nil
}

func main() {
	one_str()
	one_strs()
}
