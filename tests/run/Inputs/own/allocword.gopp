package main

// P04.09 (the allocator-word items of TODO P04.09, ADR-0029): drops free
// through the value's own allocator word. Dropping a slice or a map made in
// the counting allocator (1) makes its frees there and none in the global
// allocator (0); the same values made by `make` free into the global one and
// not into the counting one; dropping a borrowed `[]T` parameter or a view
// frees nothing; `clone` of a counting slice allocates in the counting
// allocator, of a `make` slice in the global one, and of a borrowed
// parameter that holds a counting slice in the global one (the word was
// dropped, ADR-0029 point 7); growth frees the old buffer with the slice's
// own word. Built with -test-intrinsics; Go++ only: the output is "ok".

@Extern("C") func gopp_test_make_slice_int(which int, n int, c int) []int
@Extern("C") func gopp_test_make_map_ii(which int) map[int]int
@Extern("C") func gopp_test_count(which int, what int) int

var fails int

// The calls of allocator `which`: allocs and frees.
func allocs(which int) int { return gopp_test_count(which, 0) }
func frees(which int) int  { return gopp_test_count(which, 2) }

func want(name string, got, w int) {
	if got != w {
		println("FAIL", name, got, "want", w)
		fails++
	}
}

func dropCounting() {
	s := gopp_test_make_slice_int(1, 3, 4)
	m := gopp_test_make_map_ii(1)
	for i := 0; i < 20; i++ { // the map grows: its tables are made again
		m[i] = i
	}
	_ = len(s) + len(m)
}

func dropGlobal() {
	s := make([]int, 3, 4)
	m := make(map[int]int)
	for i := 0; i < 20; i++ {
		m[i] = i
	}
	_ = len(s) + len(m)
}

func borrow(xs []int) int { return len(xs) }

func view(v View[[]int]) int { return len(v) }

func cloneBorrowed(xs []int) []int { return xs.Clone() }

func main() {
	g0, gf0, a0, af0 := allocs(0), frees(0), allocs(1), frees(1)
	dropCounting()
	want("counting: global allocs", allocs(0)-g0, 0)
	want("counting: global frees", frees(0)-gf0, 0)
	want("counting: one free per allocation", frees(1)-af0, allocs(1)-a0)

	g0, gf0, a0, af0 = allocs(0), frees(0), allocs(1), frees(1)
	dropGlobal()
	want("global: counting calls", allocs(1)-a0+frees(1)-af0, 0)
	want("global: one free per allocation", frees(0)-gf0, allocs(0)-g0)

	s := gopp_test_make_slice_int(1, 5, 5)
	g0, gf0, a0, af0 = allocs(0), frees(0), allocs(1), frees(1)
	n := borrow(s) + view(s) + len(s[1:3])
	want("borrowed and views free nothing", frees(0)-gf0+frees(1)-af0, 0)

	c := s.Clone()
	want("clone of a counting slice", allocs(1)-a0, 1)
	want("clone of a counting slice: global", allocs(0)-g0, 0)
	g0, a0 = allocs(0), allocs(1)
	cb := cloneBorrowed(s)
	want("clone of a borrowed parameter: global", allocs(0)-g0, 1)
	want("clone of a borrowed parameter: counting", allocs(1)-a0, 0)
	d := make([]int, 2)
	g0, a0 = allocs(0), allocs(1)
	dc := d.Clone()
	want("clone of a make slice: global", allocs(0)-g0, 1)
	want("clone of a make slice: counting", allocs(1)-a0, 0)

	g0, gf0, a0, af0 = allocs(0), frees(0), allocs(1), frees(1)
	s = append(s, 1) // grows: the old buffer goes back to allocator 1
	want("growth: counting allocs", allocs(1)-a0, 1)
	want("growth: counting frees", frees(1)-af0, 1)
	want("growth: global", allocs(0)-g0+frees(0)-gf0, 0)
	_ = n + len(c) + len(cb) + len(dc)
	if fails == 0 {
		println("ok")
	}
}
