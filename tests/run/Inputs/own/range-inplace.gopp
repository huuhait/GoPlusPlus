package main

// P04.09 (RNG-1, ADR-0018 amendment point 5): a borrowed range variable of an
// owning element is the element itself, so the first write to a nil map
// through it (`d.Index["x"] = 1`, a borrowed parameter `put(d)`, a value
// receiver `d.Put()`) makes the map in the collection: a slice, an array and
// a map's values. A range variable of a trivial element stays a copy (`x = 0`
// leaves the slice as it was). Go prints 0 for the first five lines (its
// range variable is a copy): Go++ only, written by hand (range-inplace.out).

type Doc struct {
	N     int
	Index map[string]int
}

func put(d Doc) { d.Index["x"] = 1 }

func (d Doc) Put() { d.Index["y"] = 2 }

func main() {
	docs := make([]Doc, 2)
	for _, d := range docs {
		d.Index["x"] = 1
	}
	println(len(docs[0].Index), len(docs[1].Index))
	docs2 := make([]Doc, 2)
	for _, d := range docs2 {
		put(d)
	}
	println(len(docs2[0].Index))
	docs3 := make([]Doc, 2)
	for _, d := range docs3 {
		d.Put()
	}
	println(len(docs3[0].Index))
	xs := []int{1, 2, 3}
	for _, x := range xs {
		x = 0
		_ = x
	}
	println(xs[0], xs[1], xs[2])
	arr := [2]Doc{}
	for _, d := range arr {
		d.Index["z"] = 3
	}
	println(len(arr[1].Index))
	m := map[string]Doc{"a": {}}
	for _, d := range m {
		d.Index["w"] = 4
	}
	println(len(m["a"].Index))
}
