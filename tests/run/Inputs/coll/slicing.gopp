package main

// Slicing of arrays (2 and 3 indexes), pointers to arrays, slices and strings
// at every legal bound. Only lengths and contents are printed: the capacity of
// a borrowed slice is its length in Go++ (SLC-12).

func sum(xs []int) int {
	t := 0
	for _, x := range xs {
		t = t*31 + x + 1
	}
	return t
}

func main() {
	var a [9]int
	for i := range a {
		a[i] = i * i
	}
	cnt := 0
	for lo := 0; lo <= 9; lo++ {
		for hi := lo; hi <= 9; hi++ {
			s := a[lo:hi]
			println(lo, hi, len(s), sum(s))
			cnt++
		}
		s := a[lo:]
		println(lo, len(s), sum(s))
	}
	for hi := 0; hi <= 9; hi++ {
		s := a[:hi]
		println(hi, len(s), sum(s))
	}
	println(len(a[:]), sum(a[:]))
	for lo := 0; lo <= 9; lo++ {
		for hi := lo; hi <= 9; hi++ {
			for mx := hi; mx <= 9; mx++ {
				s := a[lo:hi:mx]
				println(lo, hi, mx, len(s), sum(s))
			}
		}
	}
	// through a pointer to an array (a borrowed slice in Go++, SLC-8, whose
	// capacity is its length, SLC-12: so the capacity is not printed;
	// run/core-reslice.test has it)
	p := &a
	for lo := 0; lo <= 9; lo += 2 {
		for hi := lo; hi <= 9; hi += 3 {
			s := p[lo:hi]
			println(lo, hi, len(s), sum(s))
		}
	}
	for lo := 0; lo <= 9; lo += 2 {
		for hi := lo; hi <= 9; hi += 3 {
			for mx := hi; mx <= 9; mx += 2 {
				s := p[lo:hi:mx]
				println(lo, hi, mx, len(s), sum(s))
			}
		}
	}
	// slices of slices
	xs := make([]int, 7, 20)
	for i := range xs {
		xs[i] = 100 + i
	}
	for lo := 0; lo <= 7; lo++ {
		for hi := lo; hi <= 7; hi++ {
			s := xs[lo:hi]
			println(lo, hi, len(s), sum(s))
			t := s[len(s)/2:]
			println(len(t), sum(t))
		}
	}
	// strings
	str := "h\xc3\xa9llo, \xe4\xb8\x96\xe7\x95\x8c!"
	for lo := 0; lo <= len(str); lo++ {
		for hi := lo; hi <= len(str); hi++ {
			t := str[lo:hi]
			println(lo, hi, len(t), t == str[lo:hi], t < "m")
		}
	}
	e := str[len(str):]
	println(len(e), e == "", len(str[:0]), str[3:3] == "")
	println(str[1:4], str[:3], str[5:])
	// elements through a slice made by slicing are the elements of the array
	b := a[2:6]
	b[0] = -1
	b[3] = -2
	println(a[2], a[5], len(b), sum(b), sum(a[:]))
	c := b[1:3]
	c[1] = 77
	println(a[4], len(c))
}
