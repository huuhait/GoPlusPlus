package main

// append growth: element types with pointers
// Generated by Inputs/gen-coll.py; the expected output is `go run`'s.

var dummy int

var caps = []int{0, 1, 2, 3, 4, 5, 7, 8, 9, 15, 16, 17, 31, 32, 33, 63, 64, 65, 100, 127, 128, 255, 256, 257, 300, 511, 512, 513}
var adds = []int{1, 2, 3, 5, 8, 17, 100, 129, 255, 256, 600}
var bigcaps = []int{0, 1, 2, 3, 5, 8, 17, 33, 65, 129}
var bigadds = []int{1, 3, 17, 100, 129}

var s_ptr []*int

func one_ptr() {
	println("ptr")
	last := -1
	for i := 1; i <= 2500; i++ {
		s_ptr = append(s_ptr, &dummy)
		if cap(s_ptr) != last {
			last = cap(s_ptr)
			println(i, last)
		}
	}
	s_ptr = nil
}

var b_ptr []*int

func bulk_ptr() {
	println("bulk", "ptr")
	for _, c := range caps {
		for _, n := range adds {
			xs := make([]*int, 0, c)
			for i := 0; i < c; i++ {
				xs = append(xs, &dummy)
			}
			ys := make([]*int, 0, n)
			for i := 0; i < n; i++ {
				ys = append(ys, &dummy)
			}
			b_ptr = append(xs, ys...)
			println(c, n, len(b_ptr), cap(b_ptr))
		}
	}
	b_ptr = nil
}

