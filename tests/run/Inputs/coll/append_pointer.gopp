var s_sp []struct{ p *int; a int }

func one_sp() {
	println("sp")
	last := -1
	for i := 1; i <= 2500; i++ {
		s_sp = append(s_sp, struct{ p *int; a int }{&dummy, 1})
		if cap(s_sp) != last {
			last = cap(s_sp)
			println(i, last)
		}
	}
	s_sp = nil
}

var b_sp []struct{ p *int; a int }

func bulk_sp() {
	println("bulk", "sp")
	for _, c := range caps {
		for _, n := range adds {
			xs := make([]struct{ p *int; a int }, 0, c)
			for i := 0; i < c; i++ {
				xs = append(xs, struct{ p *int; a int }{&dummy, 1})
			}
			ys := make([]struct{ p *int; a int }, 0, n)
			for i := 0; i < n; i++ {
				ys = append(ys, struct{ p *int; a int }{&dummy, 1})
			}
			b_sp = append(xs, ys...)
			println(c, n, len(b_sp), cap(b_sp))
		}
	}
	b_sp = nil
}

