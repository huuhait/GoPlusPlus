package main

// append growth: element types without pointers
// Generated by Inputs/gen-coll.py; the expected output is `go run`'s.

var dummy int

var caps = []int{0, 1, 2, 3, 4, 5, 7, 8, 9, 15, 16, 17, 31, 32, 33, 63, 64, 65, 100, 127, 128, 255, 256, 257, 300, 511, 512, 513}
var adds = []int{1, 2, 3, 5, 8, 17, 100, 129, 255, 256, 600}
var bigcaps = []int{0, 1, 2, 3, 5, 8, 17, 33, 65, 129}
var bigadds = []int{1, 3, 17, 100, 129}

var s_u8 []byte

func one_u8() {
	println("u8")
	last := -1
	for i := 1; i <= 2500; i++ {
		s_u8 = append(s_u8, 0)
		if cap(s_u8) != last {
			last = cap(s_u8)
			println(i, last)
		}
	}
	s_u8 = nil
}

var b_u8 []byte

func bulk_u8() {
	println("bulk", "u8")
	for _, c := range caps {
		for _, n := range adds {
			xs := make([]byte, 0, c)
			for i := 0; i < c; i++ {
				xs = append(xs, 0)
			}
			ys := make([]byte, 0, n)
			for i := 0; i < n; i++ {
				ys = append(ys, 0)
			}
			b_u8 = append(xs, ys...)
			println(c, n, len(b_u8), cap(b_u8))
		}
	}
	b_u8 = nil
}

