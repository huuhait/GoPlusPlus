package main

// Every form of invalid and edge UTF-8 through range, []rune, string(rune),
// string([]rune) and []byte round trips. The byte strings are built from
// bytes, so the source file is plain ASCII.

func show(name string, b []byte) {
	s := string(b)
	println(name, len(s))
	for i, r := range s {
		println(" ", i, r)
	}
	rs := []rune(s)
	println(" runes", len(rs))
	for _, r := range rs {
		print(" ", r)
	}
	println()
	back := string(rs)
	println(" back", len(back), back == s)
	bs := []byte(s)
	println(" bytes", len(bs), string(bs) == s)
}

func main() {
	cases := [][]byte{
		{},
		{0x41},
		{0x7f},
		{0xc2, 0x80},
		{0xdf, 0xbf},
		{0xe0, 0xa0, 0x80},
		{0xef, 0xbf, 0xbf},
		{0xf0, 0x90, 0x80, 0x80},
		{0xf4, 0x8f, 0xbf, 0xbf},
		// a lone continuation byte, at the start, the middle and the end
		{0x80},
		{0xbf, 0x41},
		{0x41, 0x80, 0x42},
		{0x41, 0xbf},
		// a truncated 2, 3 and 4 byte sequence, at the end and before ASCII
		{0xc2},
		{0xc2, 0x41},
		{0xe2},
		{0xe2, 0x82},
		{0xe2, 0x82, 0x41},
		{0xe2, 0x41, 0x82},
		{0xf0},
		{0xf0, 0x9f},
		{0xf0, 0x9f, 0x98},
		{0xf0, 0x9f, 0x98, 0x41},
		{0xf0, 0x9f, 0x41, 0x98},
		// overlong forms
		{0xc0, 0x80},
		{0xc1, 0xbf},
		{0xe0, 0x80, 0x80},
		{0xe0, 0x9f, 0xbf},
		{0xf0, 0x80, 0x80, 0x80},
		{0xf0, 0x8f, 0xbf, 0xbf},
		// surrogates
		{0xed, 0xa0, 0x80},
		{0xed, 0xbf, 0xbf},
		{0xed, 0x9f, 0xbf},
		{0xee, 0x80, 0x80},
		// above U+10FFFF
		{0xf4, 0x90, 0x80, 0x80},
		{0xf5, 0x80, 0x80, 0x80},
		{0xf7, 0xbf, 0xbf, 0xbf},
		{0xf8, 0x88, 0x80, 0x80, 0x80},
		{0xfc, 0x84, 0x80, 0x80, 0x80, 0x80},
		{0xfe},
		{0xff},
		{0xff, 0xfe, 0xfd},
		// mixes
		{0x68, 0xc3, 0xa9, 0x6c, 0x6c, 0x6f, 0xe4, 0xb8, 0x96, 0xf0, 0x9f, 0x98, 0x80},
		{0xe4, 0xb8, 0x96, 0xff, 0xe4, 0xb8, 0x96},
		{0xc3, 0xc3, 0xa9},
		{0xe4, 0xb8, 0xe4, 0xb8, 0x96},
		{0xf0, 0x9f, 0xf0, 0x9f, 0x98, 0x80},
	}
	for i, c := range cases {
		show("case", c)
		println(i)
	}

	// string(rune) over edge values
	vals := []int64{
		-1 << 63, -1 << 32, -2, -1, 0, 1, 0x41, 0x7f, 0x80, 0x7ff, 0x800,
		0xd7ff, 0xd800, 0xdbff, 0xdc00, 0xdfff, 0xe000, 0xfffd, 0xfffe, 0xffff,
		0x10000, 0x10ffff, 0x110000, 0x7fffffff, 0x80000000, 1 << 32,
		1<<32 + 0x41, 1<<62, 1<<63 - 1,
	}
	for _, v := range vals {
		s := string(rune(v))
		println(v, len(s))
		for _, b := range []byte(s) {
			print(" ", b)
		}
		println()
	}
	var u8 uint8 = 200
	var u16 uint16 = 0xd800
	var i32 int32 = 0x1f600
	var u64 uint64 = 1<<64 - 1
	println(len(string(rune(u8))), len(string(rune(u16))), len(string(rune(i32))), len(string(rune(u64))))
	println(string(rune(u8)) == "È", string(rune(i32)) == "\U0001f600")

	// []rune with runes outside the range
	odd := []rune{0x41, -1, 0xd800, 0x110000, 0x10ffff, 0x7fffffff, 0xe9}
	s := string(odd)
	println(len(s))
	for _, b := range []byte(s) {
		print(" ", b)
	}
	println()
	for i, r := range s {
		println(i, r)
	}
	// a string made by concatenation keeps its bytes
	t := "a" + string(rune(0xe9)) + string(rune(0x4e16)) + "z"
	println(len(t), t)
	n := 0
	for range t {
		n++
	}
	println(n, len([]rune(t)))
}
