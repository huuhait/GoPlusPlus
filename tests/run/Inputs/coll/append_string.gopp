package main

// append growth: strings and slices as elements
// Generated by Inputs/gen-coll.py; the expected output is `go run`'s.

var dummy int

var s_str []string

func one_str() {
	println("str")
	last := -1
	for i := 1; i <= 2500; i++ {
		s_str = append(s_str, "x")
		if cap(s_str) != last {
			last = cap(s_str)
			println(i, last)
		}
	}
	s_str = nil
}

var s_strs [][]int

func one_strs() {
	println("strs")
	last := -1
	for i := 1; i <= 2500; i++ {
		s_strs = append(s_strs, nil)
		if cap(s_strs) != last {
			last = cap(s_strs)
			println(i, last)
		}
	}
	s_strs = nil
}

func main() {
	one_str()
	one_strs()
}
