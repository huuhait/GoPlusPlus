		return
	}
	println("ok i64x33")
}

func case_b513() {
	var z [513]byte = [513]byte{}
		big := make([][513]byte, 0, 300)
	for k := 0; k < 300; k++ {
		big = append(big, z)
	}
		g0, a0, f0 := allocs(0), allocs(1), frees(1)
	gf0 := frees(0)
	s := gopp_test_make_slice_b513(1, 0, 0)
	grows := 1
	last := cap(s)
	for k := 0; k < 700; k++ {
		s = append(s, z)
		if cap(s) != last {
			last = cap(s)
			grows++
		}
	}
	before := cap(s)
	// One append of many elements: one growth at most.
	s = append(s, big...)
	if cap(s) != before {
		grows++
	}
	// Several values in one append.
	before = cap(s)
	s = append(s, z, z, z)
	if cap(s) != before {
		grows++
	}
	ok := len(s) == 1003 && gopp_test_word_b513(s) == 1
	if allocs(1)-a0 != grows || allocs(0) != g0 || frees(0) != gf0 {
		println("FAIL b513: alloc calls", allocs(1)-a0, "want", grows, "global", allocs(0)-g0, frees(0)-gf0)
		return
	}
	if !ok {
		println("FAIL b513: len", len(s), "word", gopp_test_word_b513(s))
		return
	}
	// A clone stays in the allocator of the slice (SLC-3).
	c := gopp_test_clone_slice_b513(s)
	if len(c) != 1003 || gopp_test_word_b513(c) != 1 || allocs(1)-a0 != grows+1 || allocs(0) != g0 {
		println("FAIL b513: clone", len(c), gopp_test_word_b513(c), allocs(1)-a0, allocs(0)-g0)
		return
	}
	// Each growth freed the buffer it left (grows counts the make); freeing the clone and the slice is two more frees of allocator 1.
	gopp_test_free_slice_b513(c)
	gopp_test_free_slice_b513(s)
	if frees(1)-f0 != grows+1 || frees(0) != gf0 {
		println("FAIL b513: free calls", frees(1)-f0, frees(0)-gf0)
		return
	}
	println("ok b513")
}

