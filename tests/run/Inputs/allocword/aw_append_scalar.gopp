@Extern("C") func gopp_test_make_slice_padded(which int, n int, c int) []struct{ a int8; b int64; c int16 }
@Extern("C") func gopp_test_free_slice_padded(s []struct{ a int8; b int64; c int16 })
@Extern("C") func gopp_test_word_padded(s []struct{ a int8; b int64; c int16 }) int
@Extern("C") func gopp_test_clone_slice_padded(s []struct{ a int8; b int64; c int16 }) []struct{ a int8; b int64; c int16 }
@Extern("C") func gopp_test_count(which int, what int) int

// allocs(which) and frees(which): the calls of allocator `which` so far.
func allocs(which int) int { return gopp_test_count(which, 0) }
func frees(which int) int  { return gopp_test_count(which, 2) }

func case_u8() {
	var z byte = 0
		big := make([]byte, 0, 300)
	for k := 0; k < 300; k++ {
		big = append(big, z)
	}
		g0, a0, f0 := allocs(0), allocs(1), frees(1)
	gf0 := frees(0)
	s := gopp_test_make_slice_u8(1, 0, 0)
	grows := 1
	last := cap(s)
	for k := 0; k < 700; k++ {
		s = append(s, z)
		if cap(s) != last {
			last = cap(s)
			grows++
		}
	}
	before := cap(s)
	// One append of many elements: one growth at most.
	s = append(s, big...)
	if cap(s) != before {
		grows++
	}
	// Several values in one append.
	before = cap(s)
	s = append(s, z, z, z)
	if cap(s) != before {
		grows++
	}
	ok := len(s) == 1003 && gopp_test_word_u8(s) == 1
	if allocs(1)-a0 != grows || allocs(0) != g0 || frees(0) != gf0 {
		println("FAIL u8: alloc calls", allocs(1)-a0, "want", grows, "global", allocs(0)-g0, frees(0)-gf0)
		return
	}
	if !ok {
		println("FAIL u8: len", len(s), "word", gopp_test_word_u8(s))
		return
	}
	// A clone stays in the allocator of the slice (SLC-3).
	c := gopp_test_clone_slice_u8(s)
	if len(c) != 1003 || gopp_test_word_u8(c) != 1 || allocs(1)-a0 != grows+1 || allocs(0) != g0 {
		println("FAIL u8: clone", len(c), gopp_test_word_u8(c), allocs(1)-a0, allocs(0)-g0)
		return
	}
	// Each growth freed the buffer it left (grows counts the make); freeing the clone and the slice is two more frees of allocator 1.
	gopp_test_free_slice_u8(c)
	gopp_test_free_slice_u8(s)
	if frees(1)-f0 != grows+1 || frees(0) != gf0 {
		println("FAIL u8: free calls", frees(1)-f0, frees(0)-gf0)
		return
	}
	println("ok u8")
}

