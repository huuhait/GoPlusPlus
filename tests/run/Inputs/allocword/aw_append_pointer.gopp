@Extern("C") func gopp_test_clone_slice_slice(s [][]int) [][]int
@Extern("C") func gopp_test_make_slice_slices2(which int, n int, c int) [][2][]byte
@Extern("C") func gopp_test_free_slice_slices2(s [][2][]byte)
@Extern("C") func gopp_test_word_slices2(s [][2][]byte) int
@Extern("C") func gopp_test_clone_slice_slices2(s [][2][]byte) [][2][]byte
@Extern("C") func gopp_test_make_slice_map(which int, n int, c int) []map[string]int
@Extern("C") func gopp_test_free_slice_map(s []map[string]int)
@Extern("C") func gopp_test_word_map(s []map[string]int) int
@Extern("C") func gopp_test_clone_slice_map(s []map[string]int) []map[string]int
@Extern("C") func gopp_test_make_slice_sstr(which int, n int, c int) []struct{ s string; n int }
@Extern("C") func gopp_test_free_slice_sstr(s []struct{ s string; n int })
@Extern("C") func gopp_test_word_sstr(s []struct{ s string; n int }) int
@Extern("C") func gopp_test_clone_slice_sstr(s []struct{ s string; n int }) []struct{ s string; n int }
@Extern("C") func gopp_test_make_slice_sslice(which int, n int, c int) []struct{ n int8; xs []int16 }
@Extern("C") func gopp_test_free_slice_sslice(s []struct{ n int8; xs []int16 })
@Extern("C") func gopp_test_word_sslice(s []struct{ n int8; xs []int16 }) int
@Extern("C") func gopp_test_clone_slice_sslice(s []struct{ n int8; xs []int16 }) []struct{ n int8; xs []int16 }
@Extern("C") func gopp_test_count(which int, what int) int

// allocs(which) and frees(which): the calls of allocator `which` so far.
func allocs(which int) int { return gopp_test_count(which, 0) }
func frees(which int) int  { return gopp_test_count(which, 2) }

func case_ptr() {
	var z *int = &dummy
	big := make([]*int, 0, 300)
	for k := 0; k < 300; k++ {
		big = append(big, z)
	}
		g0, a0, f0 := allocs(0), allocs(1), frees(1)
	gf0 := frees(0)
	s := gopp_test_make_slice_ptr(1, 0, 0)
	grows := 1
	last := cap(s)
	for k := 0; k < 700; k++ {
		s = append(s, z)
		if cap(s) != last {
			last = cap(s)
			grows++
		}
	}
	before := cap(s)
	// One append of many elements: one growth at most.
	s = append(s, big...)
	if cap(s) != before {
		grows++
	}
	// Several values in one append.
	before = cap(s)
	s = append(s, z, z, z)
	if cap(s) != before {
		grows++
	}
	ok := len(s) == 1003 && gopp_test_word_ptr(s) == 1
	if allocs(1)-a0 != grows || allocs(0) != g0 || frees(0) != gf0 {
		println("FAIL ptr: alloc calls", allocs(1)-a0, "want", grows, "global", allocs(0)-g0, frees(0)-gf0)
		return
	}
	if !ok {
		println("FAIL ptr: len", len(s), "word", gopp_test_word_ptr(s))
		return
	}
	// A clone stays in the allocator of the slice (SLC-3).
	c := gopp_test_clone_slice_ptr(s)
	if len(c) != 1003 || gopp_test_word_ptr(c) != 1 || allocs(1)-a0 != grows+1 || allocs(0) != g0 {
		println("FAIL ptr: clone", len(c), gopp_test_word_ptr(c), allocs(1)-a0, allocs(0)-g0)
		return
	}
	// Freeing the slices is a free of allocator 1 and no free of the global one.
	gopp_test_free_slice_ptr(c)
	gopp_test_free_slice_ptr(s)
	if frees(1)-f0 != 2 || frees(0) != gf0 {
		println("FAIL ptr: free calls", frees(1)-f0, frees(0)-gf0)
		return
	}
	println("ok ptr")
}

