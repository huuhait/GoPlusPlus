package main

// append growth in a second allocator: element types with pointers
// Generated by Inputs/gen-allocword.py; the expected output is the
// generator's (the intrinsics are not Go). Build with -test-intrinsics.

var dummy int

@Extern("C") func gopp_test_make_slice_ptr(which int, n int, c int) []*int
@Extern("C") func gopp_test_free_slice_ptr(s []*int)
@Extern("C") func gopp_test_word_ptr(s []*int) int
@Extern("C") func gopp_test_clone_slice_ptr(s []*int) []*int
@Extern("C") func gopp_test_make_slice_ptr2(which int, n int, c int) [][2]*int
@Extern("C") func gopp_test_free_slice_ptr2(s [][2]*int)
@Extern("C") func gopp_test_word_ptr2(s [][2]*int) int
@Extern("C") func gopp_test_clone_slice_ptr2(s [][2]*int) [][2]*int
