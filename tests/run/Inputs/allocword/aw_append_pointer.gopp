@Extern("C") func gopp_test_free_slice_ptr3(s [][3]*int)
@Extern("C") func gopp_test_word_ptr3(s [][3]*int) int
@Extern("C") func gopp_test_clone_slice_ptr3(s [][3]*int) [][3]*int
