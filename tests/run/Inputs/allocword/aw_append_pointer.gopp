@Extern("C") func gopp_test_free_slice_ptr10(s [][10]*int)
@Extern("C") func gopp_test_word_ptr10(s [][10]*int) int
@Extern("C") func gopp_test_clone_slice_ptr10(s [][10]*int) [][10]*int
@Extern("C") func gopp_test_make_slice_ptr64(which int, n int, c int) [][64]*int
@Extern("C") func gopp_test_free_slice_ptr64(s [][64]*int)
@Extern("C") func gopp_test_word_ptr64(s [][64]*int) int
@Extern("C") func gopp_test_clone_slice_ptr64(s [][64]*int) [][64]*int
@Extern("C") func gopp_test_make_slice_ptr65(which int, n int, c int) [][65]*int
@Extern("C") func gopp_test_free_slice_ptr65(s [][65]*int)
@Extern("C") func gopp_test_word_ptr65(s [][65]*int) int
@Extern("C") func gopp_test_clone_slice_ptr65(s [][65]*int) [][65]*int
@Extern("C") func gopp_test_make_slice_ptr200(which int, n int, c int) [][200]*int
@Extern("C") func gopp_test_free_slice_ptr200(s [][200]*int)
@Extern("C") func gopp_test_word_ptr200(s [][200]*int) int
@Extern("C") func gopp_test_clone_slice_ptr200(s [][200]*int) [][200]*int
@Extern("C") func gopp_test_make_slice_sp(which int, n int, c int) []struct{ p *int; a int }
@Extern("C") func gopp_test_free_slice_sp(s []struct{ p *int; a int })
@Extern("C") func gopp_test_word_sp(s []struct{ p *int; a int }) int
@Extern("C") func gopp_test_clone_slice_sp(s []struct{ p *int; a int }) []struct{ p *int; a int }
@Extern("C") func gopp_test_make_slice_sbig(which int, n int, c int) []struct{ p *int; b [100]byte }
@Extern("C") func gopp_test_free_slice_sbig(s []struct{ p *int; b [100]byte })
@Extern("C") func gopp_test_word_sbig(s []struct{ p *int; b [100]byte }) int
@Extern("C") func gopp_test_clone_slice_sbig(s []struct{ p *int; b [100]byte }) []struct{ p *int; b [100]byte }
@Extern("C") func gopp_test_make_slice_sbig2(which int, n int, c int) []struct{ b [600]byte; p *int }
@Extern("C") func gopp_test_free_slice_sbig2(s []struct{ b [600]byte; p *int })
@Extern("C") func gopp_test_word_sbig2(s []struct{ b [600]byte; p *int }) int
@Extern("C") func gopp_test_clone_slice_sbig2(s []struct{ b [600]byte; p *int }) []struct{ b [600]byte; p *int }
@Extern("C") func gopp_test_make_slice_string(which int, n int, c int) []string
@Extern("C") func gopp_test_free_slice_string(s []string)
@Extern("C") func gopp_test_word_string(s []string) int
@Extern("C") func gopp_test_clone_slice_string(s []string) []string
@Extern("C") func gopp_test_make_slice_slice(which int, n int, c int) [][]int
@Extern("C") func gopp_test_free_slice_slice(s [][]int)
