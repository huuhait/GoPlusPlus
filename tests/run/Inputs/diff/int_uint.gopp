package main

// Generated by tests/run/Inputs/gen-diff.py: all of uint.

type T = uint

var vals = [...]T{0, 1, 2, 3, 7, 100, 4294967296, 9223372036854775807, 9223372036854775808, 9223372036854775809, 18446744073709551614, 18446744073709551615}
var cnt = [...]uint{0, 1, 2, 3, 32, 63, 64, 65, 128, 255, 256, 2147483648, 4611686018427387904, 18446744073709551615}
var cnt8 = [...]int8{0, 1, 5, 7, 8, 9, 63, 64, 127}
var cnt64 = [...]int64{0, 1, 63, 64, 65, 1 << 40}
var cntU8 = [...]uint8{0, 1, 5, 7, 8, 9, 63, 64, 255}

func main() {
	for i := 0; i < len(vals); i++ {
		for j := 0; j < len(vals); j++ {
			a, b := vals[i], vals[j]
			println(a+b, a-b, a*b, a&b, a|b, a^b, a&^b)
			println(a == b, a != b, a < b, a <= b, a > b, a >= b)
			if b != 0 {
				println(a/b, a%b)
			}
			x := a
			x += b
			x -= a
			x *= b
			x ^= a
			x |= b
			x &^= a
			x++
			y := b
			y--
			if b != 0 {
				z := a
				z /= b
				w := a
				w %= b
				println(z, w)
			}
			println(x, y)
		}
	}
	for i := 0; i < len(vals); i++ {
		a := vals[i]
		println(-a, ^a, +a, a == a)
		println(a+1, a-1, a*3, a&1, a|2, a^7, a&^1, a<<1, a>>1, a<<3, a>>2)
		println(a/2, a%2, a/3, a%3, a/7, a%7)
		println(a < 1, a > 0, a == 0, a != 1)
	}
	for i := 0; i < len(vals); i++ {
		a := vals[i]
		for k := 0; k < len(cnt); k++ {
			c := cnt[k]
			println(a<<c, a>>c)
			s := a
			s <<= c
			t := a
			t >>= c
			println(s, t)
		}
		for k := 0; k < len(cnt8); k++ {
			println(a<<cnt8[k], a>>cnt8[k])
		}
		for k := 0; k < len(cnt64); k++ {
			println(a<<cnt64[k], a>>cnt64[k])
		}
		for k := 0; k < len(cntU8); k++ {
			println(a<<cntU8[k], a>>cntU8[k])
		}
	}
	for i := 0; i < len(vals); i++ {
		a := vals[i]
		println(int8(a))
		println(int16(a))
		println(int32(a))
		println(int64(a))
		println(int(a))
		println(uint8(a))
		println(uint16(a))
		println(uint32(a))
		println(uint64(a))
		println(uint(a))
		println(uintptr(a))
		println(float64(a), float32(a), complex(float64(a), 0), complex(float32(a), 1))
		println(float64(int64(a)), float32(uint64(a)))
	}
}
