package main

// Generated by tests/run/Inputs/gen-opt.py: conversions.

func mix(h uint64, v uint64) uint64 { return (h ^ v) * 1099511628211 }

//go:noinline
func toF64(a int64, b uint64, c int32, d uint32, e int8, f uint8) (float64, float64, float64, float64, float64, float64) {
	return float64(a), float64(b), float64(c), float64(d), float64(e), float64(f)
}

//go:noinline
func toF32(a int64, b uint64, c int32, d uint32, e int16, f uint16) (float32, float32, float32, float32, float32, float32) {
	return float32(a), float32(b), float32(c), float32(d), float32(e), float32(f)
}

//go:noinline
func fromF64(x float64) (int64, int32, int16, int8, uint64, uint32, uint16, uint8) {
	return int64(x), int32(x), int16(x), int8(x), uint64(x), uint32(x), uint16(x), uint8(x)
}

//go:noinline
func fromF32(x float32) (int64, int32, int16, int8, uint64, uint32, uint16, uint8) {
	return int64(x), int32(x), int16(x), int8(x), uint64(x), uint32(x), uint16(x), uint8(x)
}

//go:noinline
func fromF64s(x float64) (int64, int32, int16, int8) {
	return int64(x), int32(x), int16(x), int8(x)
}

//go:noinline
func narrow(x float64) (float32, float64) { return float32(x), float64(float32(x)) }

func main() {
	ints := [...]int64{0, 1, -1, 2, 127, -128, 255, 32767, -32768, 65535, 2147483647, -2147483648,
		4294967295, 9007199254740992, 9007199254740993, -9007199254740993, 9223372036854775807,
		-9223372036854775808, 1 << 24, 1<<24 + 1, 1<<53 + 1, 4611686018427387905}
	for i := 0; i < len(ints); i++ {
		v := ints[i]
		a, b, c, d, e, f := toF64(v, uint64(v), int32(v), uint32(v), int8(v), uint8(v))
		println("tof64", v, a, b, c, d, e, f)
		a2, b2, c2, d2, e2, f2 := toF32(v, uint64(v), int32(v), uint32(v), int16(v), uint16(v))
		println("tof32", v, a2, b2, c2, d2, e2, f2)
	}
	floats := [...]float64{0, 0.5, 0.99999, 1, 1.5, 1.9999, 2.5, 100.7, 127.9, 200.4, 255.9, 1000.5, 32767.9,
		65535.9, 3e9, 4294967295.5, 1e15, 4503599627370496.5, 9007199254740992, 1e18, 9.2e18, -0.5, -1,
		-1.5, -100.7, -127.9, -128.9, -32768.5, -1e9, -2147483648.5, -1e15, -9.2e18}
	for i := 0; i < len(floats); i++ {
		x := floats[i]
		// Only values every target type holds; the others are in sat.
		if x >= 0 && x < 128 {
			a, b, c, d, e, f, g, h := fromF64(x)
			println("fromf64", x, a, b, c, d, e, f, g, h)
			a, b, c, d, e, f, g, h = fromF32(float32(x))
			println("fromf32", x, a, b, c, d, e, f, g, h)
		}
		if x > -128 && x < 0 {
			a, b, c, d := fromF64s(x)
			println("fromf64neg", x, a, b, c, d)
		}
		if x >= 0 && x < 4e9 {
			println("fromf64wide", x, int64(x), uint64(x), uint32(x))
		}
		if x > -2e9 && x < 2e9 {
			println("fromf64mid", x, int64(x), int32(x))
		}
		n, w := narrow(x)
		println("narrow", x, n, w)
	}
	big := [...]float64{1e39, 1e300, -1e39, 3.4028235e38, 3.4028236e38, 1e-46, 1e-45, 1e-320, 5e-324}
	for i := 0; i < len(big); i++ {
		n, w := narrow(big[i])
		println("narrow", big[i], n, w)
	}
	var h uint64 = 14695981039346656037
	var x float64 = 0.1
	for i := 0; i < 1000; i++ {
		x = x*1.0000001 + 0.001
		h = mix(h, uint64(int64(x*1000)))
		h = mix(h, uint64(float32(x)*1000))
	}
	println("loop", h, x)
}
