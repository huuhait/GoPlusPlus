package main

// Generated by tests/run/Inputs/gen-opt.py: NaN and -0.0 in float32.

import "unsafe"

type T = float32
var zero T
var one T = 1
// bits is the pattern of a number, with one pattern for every NaN (the sign
// of a NaN made at run time or by the optimizer is not Go's to decide).
func bits(x T) uint32 {
	if x != x {
		return 1 << 31
	}
	return *(*uint32)(unsafe.Pointer(&x))
}

func mix(h uint64, x T) uint64 { return (h ^ uint64(bits(x))) * 1099511628211 }

func mixb(h uint64, b bool) uint64 {
	if b {
		return (h ^ 1) * 1099511628211
	}
	return (h ^ 2) * 1099511628211
}

//go:noinline
func lt(x, y T) bool { return x < y }

//go:noinline
func notLt(x, y T) bool { return !(x < y) }

//go:noinline
func ge(x, y T) bool { return x >= y }

//go:noinline
func selfNe(x T) bool { return x != x }

//go:noinline
func selfEq(x T) bool { return x == x }

//go:noinline
func ident(x T) (T, T, T, T, T, T, T, T) {
	return x * 0, x + 0, x - 0, 0 - x, -x, x * 1, x / 1, x - x
}

//go:noinline
func identNeg(x T) (T, T, T, T) {
	var nz T = -zero
	return x + nz, x - nz, nz - x, x * -1
}

//go:noinline
func pick(x, y T) T {
	if x < y {
		return x
	}
	return y
}

//go:noinline
func pick2(x, y T) T {
	if x > y {
		return x
	}
	return y
}

//go:noinline
func divs(x, y T) (T, T, T) { return x / y, y / x, 1 / x }

//go:noinline
func sign(x T) T {
	if x < 0 {
		return -1
	}
	if x > 0 {
		return 1
	}
	return 0
}

func main() {
	var h uint64 = 14695981039346656037
	negz := -zero
	inf := one / zero
	nan := zero / zero
	vals := [...]T{0, negz, 1, -1, 0.5, -2.5, 3.14159265, 1e30, 1e-30, 1e38, 1e-40, inf, -inf, nan, 16777217, 255.5}
	for i := 0; i < len(vals); i++ {
		x := vals[i]
		a, b, c, d, e, f, g, k := ident(x)
		println("ident", x, a, b, c, d, e, f, g, k)
		n1, n2, n3, n4 := identNeg(x)
		println("negz", x, n1, n2, n3, n4)
		println("self", selfNe(x), selfEq(x), x != x, x == x, sign(x), x < 0, x >= 0, !(x < 0))
		println("const", x*0, x+0, x-0, 0-x, x*-1, x+negz, x*2, x/2, 2/x)
		for j := 0; j < len(vals); j++ {
			y := vals[j]
			println("pair", x, y, lt(x, y), notLt(x, y), ge(x, y), x <= y, x > y, x == y, x != y)
			println("pick", pick(x, y), pick2(x, y), x+y, x-y, x*y, x/y)
			p, q, r := divs(x, y)
			println("divs", p, q, r)
			h = mix(h, x+y)
			h = mix(h, x*y)
			h = mix(h, pick(x, y))
			h = mixb(h, lt(x, y))
			h = mixb(h, notLt(x, y))
		}
	}
	println("hash", h)
	// Loops with a float counter and an accumulator that reaches infinity.
	var acc T = 1
	for i := 0; i < 2000; i++ {
		acc *= 1.5
	}
	println("acc", acc, acc-acc, -acc, 1/acc)
	var neg T = -1
	for i := 0; i < 2000; i++ {
		neg *= 1.5
	}
	println("neg", neg, neg+acc, 0*neg)
	var small T = 1
	for i := 0; i < 2000; i++ {
		small /= 2
	}
	println("small", small, -small, 1/small, small == 0, small*-1)
}
