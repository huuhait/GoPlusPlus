package main

// Generated by tests/run/Inputs/gen-opt.py: memory.

import "unsafe"
type Pair struct {
	a, b int32
	c    [3]int16
}

type Big struct {
	x   [16]int64
	f   float64
	tag byte
}

//go:noinline
func dirty() int {
	var d [64]int
	for i := 0; i < len(d); i++ {
		d[i] = i + 100
	}
	var p Pair
	p.a, p.b = 7, 9
	p.c = [3]int16{4, 5, 6}
	return d[3] + int(p.a)
}

// A local that is declared and not assigned reads as zero, also when the
// stack slot held other values before.
//
//go:noinline
func clean() int {
	var d [64]int
	var p Pair
	var s Big
	t := 0
	for i := 0; i < len(d); i++ {
		t += d[i]
	}
	return t + int(p.a) + int(p.b) + int(p.c[0]) + int(p.c[2]) + int(s.x[5]) + int(s.tag)
}

// A variable declared in a loop is zero in every iteration.
//
//go:noinline
func perIteration(n int) int {
	t := 0
	for i := 0; i < n; i++ {
		var a [4]int
		var b Pair
		t += a[0] + a[3] + int(b.a)
		a[0] = i + 1
		a[3] = i + 2
		b.a = int32(i + 3)
	}
	return t
}

//go:noinline
func swaps(a [8]int) [8]int {
	for i := 0; i < 4; i++ {
		a[i], a[7-i] = a[7-i], a[i]
	}
	a[0], a[1], a[2] = a[2], a[0], a[1]
	return a
}

//go:noinline
func rotate(a [6]int) [6]int {
	a = [6]int{a[5], a[0], a[1], a[2], a[3], a[4]}
	return a
}

//go:noinline
func selfAssign(p Pair) Pair {
	p = p
	p.c = p.c
	p.c[0], p.c[1] = p.c[1], p.c[0]
	return p
}

//go:noinline
func alias(x int) (int, int, int) {
	p := &x
	q := &x
	*p = 1
	*q = 2
	r := *p
	*p = *q + 10
	return r, *q, x
}

//go:noinline
func aliasElems(a [4]int, i, j int) [4]int {
	p := &a[i]
	q := &a[j]
	*p = 5
	*q = 6
	*p += *q
	return a
}

//go:noinline
func viaPointer(p *[4]int, q *[4]int) int {
	p[1] = 1
	q[1] = 2
	return p[1]
}

//go:noinline
func bitcast(f float64, u uint64) (uint64, float64, uint32) {
	g := u
	return *(*uint64)(unsafe.Pointer(&f)), *(*float64)(unsafe.Pointer(&g)), *(*uint32)(unsafe.Pointer(&f))
}

//go:noinline
func bytesOf(v uint64) [8]byte {
	return *(*[8]byte)(unsafe.Pointer(&v))
}

//go:noinline
func fieldWrite(b Big) Big {
	b.x[3] = 33
	b.f = 1.5
	c := b
	c.x[3]++
	b.tag = c.tag + 1
	b.x[4] = c.x[3]
	return b
}

var g1, g2 int
var zero float64

//go:noinline
func globals() int {
	g1, g2 = 1, 2
	g1, g2 = g2, g1
	g1 += g2
	return g1*10 + g2
}

func main() {
	println(dirty(), clean(), dirty(), clean())
	println(perIteration(5), perIteration(0))
	sw := swaps([8]int{1, 2, 3, 4, 5, 6, 7, 8})
	println(sw[0], sw[1], sw[2], sw[3], sw[4], sw[5], sw[6], sw[7])
	r := rotate([6]int{1, 2, 3, 4, 5, 6})
	for i := 0; i < 5; i++ {
		r = rotate(r)
	}
	println(r[0], r[1], r[2], r[3], r[4], r[5])
	s := selfAssign(Pair{1, 2, [3]int16{3, 4, 5}})
	println(s.a, s.b, s.c[0], s.c[1], s.c[2])
	a1, a2, a3 := alias(5)
	println(a1, a2, a3)
	e := aliasElems([4]int{1, 2, 3, 4}, 1, 1)
	println(e[0], e[1], e[2], e[3])
	e = aliasElems([4]int{1, 2, 3, 4}, 0, 3)
	println(e[0], e[1], e[2], e[3])
	var arr [4]int
	println(viaPointer(&arr, &arr))
	var arr2 [4]int
	println(viaPointer(&arr, &arr2))
	a, b, c := bitcast(1.5, 0x4008000000000000)
	println(a, b, c)
	var negz = -zero
	a, b, c = bitcast(negz, 0x7ff0000000000000)
	println(a, b, c)
	by := bytesOf(0x0102030405060708)
	println(by[0], by[1], by[7])
	fb := fieldWrite(Big{tag: 7})
	println(fb.x[3], fb.x[4], fb.f, fb.tag)
	println(globals())
}
