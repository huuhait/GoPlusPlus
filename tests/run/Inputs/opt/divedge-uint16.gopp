package main

// Generated by tests/run/Inputs/gen-opt.py: division and remainder of uint16.

type T = uint16
const bits = 16
var edges = [...]T{0, 1, 2, 3, 5, 7, 64, 100, 16383, 32767, 32768, 32769, 65533, 65534, 65535}
func mix(h uint64, v T) uint64 { return (h ^ uint64(v)) * 1099511628211 }

//go:noinline
func divide(a, b T) T { return a / b }

//go:noinline
func remain(a, b T) T { return a % b }

//go:noinline
func divRem(a, b T) (T, T) { return a / b, a % b }
//go:noinline
func divConsts(a T) (T, T, T, T, T, T) { return a / 3, a % 3, a / 7, a % 7, a / 10, a % 10 }

//go:noinline
func identity(a, b T) bool { return (a/b)*b+a%b == a }
func main() {
	var h uint64 = 14695981039346656037
	for i := 0; i < len(edges); i++ {
		a := edges[i]
		p, q, r, s, t, u := divConsts(a)
		println("consts", a, p, q, r, s, t, u)
		for j := 0; j < len(edges); j++ {
			b := edges[j]
			if b == 0 {
				continue
			}
			d, m := divRem(a, b)
			println("divrem", a, b, d, m, identity(a, b))
		}
	}
	var s uint64 = 88172645463325252
	for i := 0; i < 20000; i++ {
		s ^= s << 13
		s ^= s >> 7
		s ^= s << 17
		a, b := T(s), T(s>>(s&31))
		if b == 0 {
			continue
		}
		d, m := divRem(a, b)
		h = mix(mix(h, d), m)
	}
	println("all", h)
}
