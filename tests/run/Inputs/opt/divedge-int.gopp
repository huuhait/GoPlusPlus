package main

// Generated by tests/run/Inputs/gen-opt.py: division and remainder of int.

type T = int
const bits = 64
var edges = [...]T{-9223372036854775808, -9223372036854775807, -9223372036854775806, -100, -7, -3, -2, -1, 0, 1, 2, 3, 5, 7, 64, 100, 4611686018427387903, 9223372036854775806, 9223372036854775807}
func mix(h uint64, v T) uint64 { return (h ^ uint64(v)) * 1099511628211 }

//go:noinline
func divide(a, b T) T { return a / b }

//go:noinline
func remain(a, b T) T { return a % b }

//go:noinline
func divRem(a, b T) (T, T) { return a / b, a % b }
// The one signed overflow: the most negative value over -1.
var minusOne T = -1

//go:noinline
func overByConst(a T) (T, T) { return a / -1, a % -1 }

//go:noinline
func overByVar(a T) (T, T) { return a / minusOne, a % minusOne }

//go:noinline
func negDivPow2(a T) (T, T, T, T, T, T) { return a / 2, a % 2, a / 4, a % 4, a / 64, a % 64 }

//go:noinline
func negDivOther(a T) (T, T, T, T, T, T) { return a / 3, a % 3, a / -3, a % -3, a / 10, a % -10 }

//go:noinline
func identity(a, b T) bool { return (a/b)*b+a%b == a }
func main() {
	var h uint64 = 14695981039346656037
	for i := 0; i < len(edges); i++ {
		a := edges[i]
		x, y := overByConst(a)
		println("byConst", a, x, y)
		x, y = overByVar(a)
		println("byVar", a, x, y)
		p, q, r, s, t, u := negDivPow2(a)
		println("pow2", a, p, q, r, s, t, u)
		p, q, r, s, t, u = negDivOther(a)
		println("other", a, p, q, r, s, t, u)
		for j := 0; j < len(edges); j++ {
			b := edges[j]
			if b == 0 {
				continue
			}
			d, m := divRem(a, b)
			println("divrem", a, b, d, m, identity(a, b))
		}
	}
	var s uint64 = 88172645463325252
	for i := 0; i < 20000; i++ {
		s ^= s << 13
		s ^= s >> 7
		s ^= s << 17
		a, b := T(s), T(s>>(s&31))
		if b == 0 {
			continue
		}
		d, m := divRem(a, b)
		h = mix(mix(h, d), m)
		x, y := overByVar(a)
		h = mix(mix(h, x), y)
		p, q, r, s2, t, u := negDivOther(a)
		h = mix(mix(mix(mix(mix(mix(h, p), q), r), s2), t), u)
	}
	println("all", h)
}
