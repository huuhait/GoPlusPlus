	_, _, _, _ = two, half, mtwo, one
	v1 = v2 * v2
	v1 = v3 / 2
	v3 = d * c
	v3 = float64(v3 * v4)
	v3 = d + -1.0000000149011612
	v3 = v2 - v1
	v1 = float64(v1) + c
	v1 = 3.0 + v4 * v3
	return sum4(v1, v2, v3, v4)
}

