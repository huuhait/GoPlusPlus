func f34(a, b, c, d float64) float64 {
	v1, v2, v3, v4 := a, b, c, d
	two, half, mtwo, one := 2.0, 0.5, -2.0, 1.0
	_, _, _, _ = two, half, mtwo, one
	v4 = a - c * a
	v4 -= d * v2
	for i := 0; i < 3; i++ {
		v1 = v1 + v1 * float64(i + 1)
	}
	v4 = v1 - a * b
	if v4 > v2 {
		v4 = c * v3
		for i := 0; i < 3; i++ {
			v2 = v2 + c * float64(i + 1)
		}
	} else {
		v4 = v1
		v1 = a * v1
		if v1 > v1 {
			v3 = v1 - b
		}
	}
	v2 -= d * v4
	v4 = -(v1 * v2)
	v4 = 1.0000000074505806 + c * v2
	v1 = v2 * c
	return sum4(v1, v2, v3, v4)
}

//go:noinline
func f35(a, b, c, d float64) float64 {
	v1, v2, v3, v4 := a, b, c, d
	two, half, mtwo, one := 2.0, 0.5, -2.0, 1.0
	_, _, _, _ = two, half, mtwo, one
	v4 = v3 + v4 * d
	v4 = float64(v3 * a)
	v4 = float64(c * c)
	v3 = v4 * v2
	v3 = v2 * v3
	if v2 > d {
		v4 = a * 0.1
	} else {
		v4 = 0.1
	}
	if a < v1 {
		v2 = b * c
		v4 = -v3
	} else {
		v2 = a
		v4 = d * v3
	}
	for i := 0; i < 2; i++ {
		v1 = v1 + a * float64(i + 1)
	}
	return sum4(v1, v2, v3, v4)
}

