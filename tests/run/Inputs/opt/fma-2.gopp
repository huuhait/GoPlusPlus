	_, _, _, _ = two, half, mtwo, one
	v4 = -(v3 * v1)
	v2 = v2 * v3
	if v2 > c {
		v3 = v2 + v3
	}
	v4 = b * -1.0000000149011612
	v3 = v3 * a
	v4 = -1.0 - v2
	v3 = a * c - c
	v3 += c * v2
	v4 = b * v2
	return sum4(v1, v2, v3, v4)
}

