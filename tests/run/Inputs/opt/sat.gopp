package main

// Generated by tests/run/Inputs/gen-opt.py: float to integer conversions that
// do not fit. Go++ saturates and gives 0 for NaN (D4.12); gc's answers differ by target, so
// there is no Go golden. run-opt-matrix.py compares every level with the baseline.

var zero float64
var zero32 float32
//go:noinline
func all64(x float64) (int8, int16, int32, int64, int, uint8, uint16, uint32, uint64, uint, uintptr) {
	return int8(x), int16(x), int32(x), int64(x), int(x), uint8(x), uint16(x), uint32(x), uint64(x), uint(x), uintptr(x)
}

//go:noinline
func all32(x float32) (int8, int16, int32, int64, int, uint8, uint16, uint32, uint64, uint, uintptr) {
	return int8(x), int16(x), int32(x), int64(x), int(x), uint8(x), uint16(x), uint32(x), uint64(x), uint(x), uintptr(x)
}

func main() {
	nan := zero / zero
	inf := 1 / zero
	vals := [...]float64{0, -0.5, 0.5, 127.5, 128, 255.5, 256, -128.5, -129, 32767.5, 32768, 65535.5, 65536,
		-32769, 2147483647.5, 2147483648, 4294967295.5, 4294967296, -2147483649, 9223372036854775807,
		9223372036854775808, 1.8446744073709552e19, 1e19, 1e30, 1e300, 1.7976931348623157e308, -1, -1e30,
		-9223372036854775808, -9223372036854777856, -1e19, -1e300, inf, -inf, nan}
	for i := 0; i < len(vals); i++ {
		a, b, c, d, e, f, g, h, k, l, m := all64(vals[i])
		println("f64", vals[i], a, b, c, d, e, f, g, h, k, l, m)
		a, b, c, d, e, f, g, h, k, l, m = all32(float32(vals[i]))
		println("f32", float32(vals[i]), a, b, c, d, e, f, g, h, k, l, m)
	}
	// Constant-looking operands: the optimizer folds these.
	println(int8(1e3+zero), int16(-1e9+zero), int32(1e30+zero), int64(inf), uint8(-1+zero), uint32(1e12+zero), uint64(nan))
	x := 3e9
	println(int32(x), uint32(x), int32(-x), uint32(-x))
	var y float32 = 3e9
	println(int32(y), uint32(y), int64(y), uint64(y))
}
