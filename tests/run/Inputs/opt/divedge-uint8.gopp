package main

// Generated by tests/run/Inputs/gen-opt.py: division and remainder of uint8.

type T = uint8
const bits = 8
var edges = [...]T{0, 1, 2, 3, 5, 7, 64, 100, 63, 127, 128, 129, 253, 254, 255}
func mix(h uint64, v T) uint64 { return (h ^ uint64(v)) * 1099511628211 }

//go:noinline
func divide(a, b T) T { return a / b }

//go:noinline
func remain(a, b T) T { return a % b }

//go:noinline
func divRem(a, b T) (T, T) { return a / b, a % b }
//go:noinline
func divConsts(a T) (T, T, T, T, T, T) { return a / 3, a % 3, a / 7, a % 7, a / 10, a % 10 }

//go:noinline
func identity(a, b T) bool { return (a/b)*b+a%b == a }
func main() {
	var h uint64 = 14695981039346656037
	for i := 0; i < 1<<bits; i++ {
		a := T(i)
		p, q, r, s, t, u := divConsts(a)
		h = mix(mix(mix(mix(mix(mix(h, p), q), r), s), t), u)
		for j := 0; j < 1<<bits; j++ {
			b := T(j)
			if b == 0 {
				continue
			}
			d, m := divRem(a, b)
			h = mix(mix(h, d), m)
			if !identity(a, b) {
				println("identity fails", a, b)
			}
		}
	}
	println("all", h)
}
