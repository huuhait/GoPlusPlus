// REQUIRES: host-linux-amd64 || host-linux-arm64
// RUN: %python %S/Inputs/run-expect.py --src %s 0 %S/Inputs/non-ascii.out
// P04.02: strings are bytes: UTF-8 and the escapes of a literal come out as
// they are in the literal's value.
package main

func main() {
	s := "ж"
	println("héllo, 世界, 🙂", "ñ", s)
	println("tab\there \"quoted\" back\\slash é \x41 \101 \U0001F600")
}
