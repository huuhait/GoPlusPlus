func pRatioCI64_H_S(a int64[H*KM], b int64[S*M]) int64 { return int64(a / b) }
func pRatioCI64_S_SN(a int64[S*KM], b int64[S*M]) int64 { return int64(a / b) }
func pRatioCI64_H_SN(a int64[H*KM], b int64[S*M]) int64 { return int64(a / b) }

func row(name string, p, g float64, k string) {
	println(name, p, g, p == g)
}
func irow(name string, p, g int) {
	println(name, p, g, p == g)
}
func brow(name string, p, g bool) {
	println(name, p, g, p == g)
}

func main() {
	row("ratio f64 M M", float64(pRatioF64_M_M(3.0[M], 2.0[M])), float64(gRatioF64(3.0[M], 2.0[M])), "f64")
	row("via f64 M M", float64(pRatioF64_M_M(3.0[M], 2.0[M])), float64(gViaF64(3.0[M], 2.0[M])), "f64")
	row("ratio f64 KM M", float64(pRatioF64_KM_M(3.0[KM], 2.0[M])), float64(gRatioF64(3.0[KM], 2.0[M])), "f64")
	row("via f64 KM M", float64(pRatioF64_KM_M(3.0[KM], 2.0[M])), float64(gViaF64(3.0[KM], 2.0[M])), "f64")
	row("ratio f64 M KM", float64(pRatioF64_M_KM(3.0[M], 2.0[KM])), float64(gRatioF64(3.0[M], 2.0[KM])), "f64")
	row("via f64 M KM", float64(pRatioF64_M_KM(3.0[M], 2.0[KM])), float64(gViaF64(3.0[M], 2.0[KM])), "f64")
	row("ratio f64 KM KM", float64(pRatioF64_KM_KM(3.0[KM], 2.0[KM])), float64(gRatioF64(3.0[KM], 2.0[KM])), "f64")
	row("via f64 KM KM", float64(pRatioF64_KM_KM(3.0[KM], 2.0[KM])), float64(gViaF64(3.0[KM], 2.0[KM])), "f64")
	row("ratio f64 M M neg", float64(pRatioF64_M_MN(-3.0[M], 2.0[M])), float64(gRatioF64(-3.0[M], 2.0[M])), "f64")
	row("via f64 M M neg", float64(pRatioF64_M_MN(-3.0[M], 2.0[M])), float64(gViaF64(-3.0[M], 2.0[M])), "f64")
	row("ratio f64 KM M neg", float64(pRatioF64_KM_MN(-3.0[KM], 2.0[M])), float64(gRatioF64(-3.0[KM], 2.0[M])), "f64")
	row("via f64 KM M neg", float64(pRatioF64_KM_MN(-3.0[KM], 2.0[M])), float64(gViaF64(-3.0[KM], 2.0[M])), "f64")
	row("ratio f64 M KM neg", float64(pRatioF64_M_KMN(-3.0[M], 2.0[KM])), float64(gRatioF64(-3.0[M], 2.0[KM])), "f64")
	row("via f64 M KM neg", float64(pRatioF64_M_KMN(-3.0[M], 2.0[KM])), float64(gViaF64(-3.0[M], 2.0[KM])), "f64")
	row("ratio f64 KM KM neg", float64(pRatioF64_KM_KMN(-3.0[KM], 2.0[KM])), float64(gRatioF64(-3.0[KM], 2.0[KM])), "f64")
	row("via f64 KM KM neg", float64(pRatioF64_KM_KMN(-3.0[KM], 2.0[KM])), float64(gViaF64(-3.0[KM], 2.0[KM])), "f64")
	row("product f64 M IM", float64(pProductF64_M_IM(3.0[M], 2.0[IM])), float64(gProdF64(3.0[M], 2.0[IM])), "f64")
	row("product f64 KM IM", float64(pProductF64_KM_IM(3.0[KM], 2.0[IM])), float64(gProdF64(3.0[KM], 2.0[IM])), "f64")
	row("product f64 M IKM", float64(pProductF64_M_IKM(3.0[M], 2.0[IKM])), float64(gProdF64(3.0[M], 2.0[IKM])), "f64")
	row("product f64 KM IKM", float64(pProductF64_KM_IKM(3.0[KM], 2.0[IKM])), float64(gProdF64(3.0[KM], 2.0[IKM])), "f64")
	row("product f64 M IM neg", float64(pProductF64_M_IMN(-3.0[M], 2.0[IM])), float64(gProdF64(-3.0[M], 2.0[IM])), "f64")
	row("product f64 KM IM neg", float64(pProductF64_KM_IMN(-3.0[KM], 2.0[IM])), float64(gProdF64(-3.0[KM], 2.0[IM])), "f64")
	row("product f64 M IKM neg", float64(pProductF64_M_IKMN(-3.0[M], 2.0[IKM])), float64(gProdF64(-3.0[M], 2.0[IKM])), "f64")
	row("product f64 KM IKM neg", float64(pProductF64_KM_IKMN(-3.0[KM], 2.0[IKM])), float64(gProdF64(-3.0[KM], 2.0[IKM])), "f64")
	row("compound f64 S*KM / S*M", float64(pRatioCF64_S_S(3.0[S*KM], 2.0[S*M])), float64(gRatioCF64[S, S](3.0[S*KM], 2.0[S*M])), "f64")
	row("compound f64 H*KM / S*M", float64(pRatioCF64_H_S(3.0[H*KM], 2.0[S*M])), float64(gRatioCF64[H, S](3.0[H*KM], 2.0[S*M])), "f64")
	row("compound f64 S*KM / H*M", float64(pRatioCF64_S_H(3.0[S*KM], 2.0[H*M])), float64(gRatioCF64[S, H](3.0[S*KM], 2.0[H*M])), "f64")
	row("compound f64 S*KM / S*M neg", float64(pRatioCF64_S_SN(-3.0[S*KM], 2.0[S*M])), float64(gRatioCF64[S, S](-3.0[S*KM], 2.0[S*M])), "f64")
	row("compound f64 H*KM / S*M neg", float64(pRatioCF64_H_SN(-3.0[H*KM], 2.0[S*M])), float64(gRatioCF64[H, S](-3.0[H*KM], 2.0[S*M])), "f64")
	row("compound f64 S*KM / H*M neg", float64(pRatioCF64_S_HN(-3.0[S*KM], 2.0[H*M])), float64(gRatioCF64[S, H](-3.0[S*KM], 2.0[H*M])), "f64")
	row("ratio f32 M M", float64(pRatioF32_M_M(3.0[M], 2.0[M])), float64(gRatioF32(3.0[M], 2.0[M])), "f32")
	row("via f32 M M", float64(pRatioF32_M_M(3.0[M], 2.0[M])), float64(gViaF32(3.0[M], 2.0[M])), "f32")
