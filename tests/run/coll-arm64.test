// REQUIRES: host-linux-amd64, qemu-aarch64
// RUN: %gopp build -target=linux/arm64 -crt-dir=%aarch64_sysroot/lib %S/Inputs/coll/utf8.gopp -o %t.utf8
// RUN: %python %S/Inputs/run-golden.py --qemu %aarch64_sysroot %t.utf8 %S/Inputs/coll/utf8.out
// RUN: %gopp build -target=linux/arm64 -crt-dir=%aarch64_sysroot/lib %S/Inputs/coll/append_pointer.gopp -o %t.append
// RUN: %python %S/Inputs/run-golden.py --qemu %aarch64_sysroot %t.append %S/Inputs/coll/append_pointer.out
// SPLIT: coll-arm64 1/2
// P04.05: the runtime written in GIR (UTF-8, growth, the hash table) on
// linux/arm64 under QEMU, with Go's output (its panics: core-panics-arm64.test).
// All programs on arm64: coll-arm64.long.test.
