// REQUIRES: host-linux-amd64 || host-linux-arm64
// RUN: %python %S/Inputs/run-expect.py --src %s 0 %S/Inputs/eval-order.out
// P04.02: Go evaluates every operand of println before it prints anything,
// left to right: the calls print their lines first, then println prints the
// results.
package main

func f() int {
	println("in f")
	return 1
}

func g() bool {
	print("in g\n")
	return true
}

func main() {
	println(f(), "and", g(), f())
}
