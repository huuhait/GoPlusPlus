// exit: 2
package main

// While the `drop` method of a parent runs, the value is one of the
// parent: the child that gave `Area` its body has ended.

type Shape struct{ name string }

@Abstract
func (s *Shape) Area() int

func (s *Shape) drop() { println("drop", s.name, s.Area()) }

@Extends(Shape)
type Square struct{ side int }

@Override
func (s *Square) Area() int { return s.side * s.side }

func main() {
	sq := Square{name: "sq", side: 3}
	println(sq.Area())
}
