// REQUIRES: host-linux-amd64 || host-linux-arm64
// RUN: %python %S/Inputs/run-expect.py --src %s 0 %S/Inputs/println-args.out
// P04.02: what println and print do with each kind of operand: constants
// (formatted when the program is built) and values of every integer width
// and signedness, bool and string; a rune is an int32. println separates
// with spaces and ends with a newline; print does neither.
package main

func f(x int) int { return x * 2 }

func main() {
	var n int = -42
	var u uint64 = 18446744073709551615
	var mn int64 = -9223372036854775808
	var i8 int8 = -128
	var u8 uint8 = 255
	var u16 uint16 = 65535
	var i32 int32 = -2147483648
	var b bool = n < 0
	s := "str"
	println("a", 1, true, n, u, mn, b, s)
	println(i8, u8, u16, i32, 0, -0)
	println(0, f(21), 'x', -9223372036854775807-1, uint64(18446744073709551615))
	print("x", 1, "y", n, b)
	print("\n")
	println()
}
