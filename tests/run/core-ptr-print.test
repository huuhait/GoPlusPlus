// REQUIRES: host-linux-amd64 || host-linux-arm64
// RUN: %gopp build %gopp_link_flags %s -o %t.exe
// RUN: %t.exe | FileCheck %s
// P04.04: println prints a pointer as Go does, `0x` and lowercase hex digits
// without leading zeros. The address changes from run to run, so the shape
// is checked, not the value. Both sides: `p == &x` is true and the two
// prints show the same address.
package main

func main() {
	x := 1
	p := &x
	println(p == &x)
	println(p)
	print(p, "\n")
}

// CHECK: true
// CHECK-NEXT: [[A:0x[1-9a-f][0-9a-f]*]]
// CHECK-NEXT: [[A]]
