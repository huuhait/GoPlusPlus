// REQUIRES: long, host-linux-amd64 || host-linux-arm64
// RUN: %python %S/Inputs/run-golden.py --src %S/Inputs/diff/int_int8.gopp %S/Inputs/diff/int_int8.out
// RUN: %python %S/Inputs/run-golden.py --src %S/Inputs/diff/int_int16.gopp %S/Inputs/diff/int_int16.out
// RUN: %python %S/Inputs/run-golden.py --src %S/Inputs/diff/int_int32.gopp %S/Inputs/diff/int_int32.out
// RUN: %python %S/Inputs/run-golden.py --src %S/Inputs/diff/int_int64.gopp %S/Inputs/diff/int_int64.out
// RUN: %python %S/Inputs/run-golden.py --src %S/Inputs/diff/int_int.gopp %S/Inputs/diff/int_int.out
// P04.04 differential table (D4.12): the signed integer types, hundreds
// of expressions per type over its edge values. The programs and their
// expected output come from Inputs/gen-diff.py: Inputs/diff/NAME.out is what
// Go prints for the same program (`go run`), so the test needs no Go. On
// linux/arm64 under QEMU: diff-int-signed-arm64.long.test.
