// exit: 2
package main

type Emptier interface{ Empty() }

type Table map[int]int

func (t *Table) Empty() { clear(t) }

func main() {
	m := Table{1: 1}
	for key := range m {
		delete(m, key)
	}
	println(len(m))
	m[2] = 2
	var e Local[Emptier] = &m
	for range m {
		e.Empty()
	}
	println("not reached")
}
