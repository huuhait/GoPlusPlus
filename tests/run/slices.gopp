package main

func sum(xs []int) int {
	total := 0
	for _, x := range xs {
		total += x
	}
	return total
}

func tail(xs []int) []int { return xs[1:] }

var nums []int
var floats []float32
var names []string

type pair struct{ a, b int32 }

var pairs []pair
var big []int64

func main() {
	println(nums == nil, len(nums), cap(nums))
	for i := range 40 {
		nums = append(nums, i*i)
		print(len(nums), "/", cap(nums), " ")
	}
	println()
	println(sum(nums), nums[3], nums[len(nums)-1], nums != nil)
	made := make([]byte, 3, 10)
	made[1] = 7
	made = append(made, 1, 2, 3)
	println(len(made), cap(made), made[1], made[5])
	lit := []string{"a", "b", 4: "e"}
	println(len(lit), cap(lit), lit[1], lit[4], lit[3] == "")
	bytes := []byte("héllo")
	bytes = append(bytes, " wörld"...)
	println(len(bytes), string(bytes))
	buf := make([]int, 3)
	n := copy(&buf, nums[5:])
	println(n, buf[0], buf[2])
	n = copy(&buf, nums[39:])
	println(n, buf[0])
	clear(buf)
	println(buf[0], buf[2], len(buf))
	part := nums[2:5]
	println(len(part), part[0], part[2], sum(tail(part)))
	nums = nums[3:6]
	println(len(nums), nums[0], nums[2])
	nums = nums[:0]
	println(len(nums), nums == nil)
	three := nums[0:0:0]
	println(len(three), cap(three))
	for i := range 6 {
		floats = append(floats, float32(i)/2)
		print(cap(floats), " ")
	}
	println(floats[5])
	for i := range 10 {
		pairs = append(pairs, pair{int32(i), int32(-i)})
		print(cap(pairs), " ")
	}
	println(pairs[9].b)
	names = []string{}
	for i := range 9 {
		names = append(names, "n")
		print(cap(names), " ")
		_ = i
	}
	println(names == nil)
	big = make([]int64, 0, 300)
	for i := range 700 {
		big = append(big, int64(i))
	}
	println(len(big), cap(big))
	grown := append([]byte("ab"), bytes...)
	println(len(grown), cap(grown), string(grown[:8]))
	for i, b := range []byte("xyz") {
		print(i, ":", b, " ")
	}
	println()
}
