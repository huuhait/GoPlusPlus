package main

import "sync"

type doc struct {
	title string
	tags  []string
	seen  map[string]int
}

var shelf sync.Mutex[[]doc]
var lists sync.Mutex[[][]int]
var words sync.Mutex[[]string]

func keep(xs []int) { lists.With(func(all *[][]int) { *all = append(*all, xs) }) }
func file(d doc)    { shelf.With(func(all *[]doc) { *all = append(*all, d) }) }
func say(s string)  { words.With(func(all *[]string) { *all = append(*all, s) }) }

func total(xs []int) int {
	t := 0
	for _, x := range xs {
		t += x
	}
	return t
}

func straight() {
	a := []int{1, 2, 3}
	keep(a)
	b := []int{4, 5}
	keep(b)
	println(total(b))
	c := b
	println(total(c))
	s := "one"
	s += "-two"
	say(s)
	t := s + "!"
	say(t)
}

func branches(n int) {
	xs := []int{n, n}
	if n%2 == 0 {
		keep(xs)
	} else {
		keep(xs)
	}
	ys := []int{n}
	if n > 1 {
		keep(ys)
	}
	println(len(ys), ys[0])
	zs := []int{n, n, n}
	if n == 1 {
		keep(zs)
		return
	}
	println(total(zs))
}

func loops(n int) {
	for i := 0; i < n; i++ {
		w := []int{i, i}
		keep(w)
	}
	e := []int{9}
	for i := 0; i < n; i++ {
		keep(e)
	}
	f := []int{7, 7}
	for i := 0; i < n; i++ {
		if i == 1 {
			keep(f)
			break
		}
	}
	g := []int{1}
	for i := 0; i < n; i++ {
		keep(g)
		g = []int{i, i, i}
	}
	println(len(g))
}

func values() {
	d := doc{title: "a", tags: []string{"x", "y"}, seen: map[string]int{"x": 1}}
	file(d)
	println(d.title, len(d.tags), len(d.seen))
	e := d
	file(e)
	m := map[string][]int{"k": {1, 2}}
	for k, v := range m {
		keep(v)
		say(k)
	}
	names := []string{"p", "q"}
	for _, name := range names {
		say(name)
	}
	say(names[0])
}

func results() (out []int, n int) {
	out = []int{1, 2}
	keep(out)
	tmp := []int{3}
	keep(tmp)
	n = len(out)
	return
}

func main() {
	straight()
	branches(1)
	branches(2)
	branches(3)
	loops(3)
	values()
	out, n := results()
	println(len(out), n)
	sum := 0
	lists.With(func(all *[][]int) {
		shelf.With(func(docs *[]doc) {
			words.With(func(said *[]string) { println(len(*all), len(*docs), len(*said)) })
		})
		for _, xs := range *all {
			sum += total(xs)
		}
	})
	println(sum)
	shelf.With(func(docs *[]doc) {
		for _, d := range *docs {
			println(d.title, len(d.tags), d.seen["x"])
		}
	})
	words.With(func(said *[]string) {
		for _, w := range *said {
			println(w)
		}
	})
}
