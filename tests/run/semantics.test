// REQUIRES: host-linux-amd64 || host-linux-arm64
// RUN: %gopp build %gopp_link_flags %s -o %t.exe
// RUN: %t.exe | FileCheck %s
// P04.02, D4.12: the Go results of the operations that are undefined in LLVM,
// and the control flow of the subset, run for real. Both sides of every rule:
// the special case and the ordinary case next to it.
package main

func fib(n int) int {
	a, b := 0, 1
	for i := 0; i < n; i++ {
		a, b = b, a+b
	}
	return a
}

func sumTo(n int) int {
	sum := 0
	for i := 0; ; i++ {
		if i > n {
			break
		}
		if i%2 == 1 {
			continue
		}
		sum += i
	}
	return sum
}

func div(a int, b int) int { return a / b }
func rem(a int, b int) int { return a % b }
func shl(a int32, n uint) int32 { return a << n }
func shr(a int32, n uint) int32 { return a >> n }
func ushr(a uint32, n uint) uint32 { return a >> n }
func both(a bool, b bool) bool { return a && b }
func either(a bool, b bool) bool { return a || b }
func toInt(f float64) int { return int(f) }
func toU8(f float64) uint8 { return uint8(f) }

func main() {
	println("fib", fib(20))
	println("sum", sumTo(10))
	// Signed division by -1 does not trap (MinInt64 / -1 is MinInt64).
	min := -9223372036854775807 - 1
	println("div", div(7, 2), div(-7, 2), div(min, -1), div(min, 1))
	println("rem", rem(7, 3), rem(-7, 3), rem(min, -1), rem(5, -1))
	// A shift by the width or more gives 0, or the sign fill.
	println("shl", shl(1, 3), shl(1, 31), shl(1, 32), shl(1, 100))
	println("shr", shr(-8, 1), shr(-8, 32), shr(-8, 200), shr(8, 40), ushr(1<<31, 31), ushr(1<<31, 32))
	// Wrap-around.
	var u uint8 = 250
	u += 10
	var i8 int8 = 127
	i8++
	println("wrap", u, i8)
	// Float to integer saturates, NaN is 0.
	big := 1e30
	println("sat", toInt(3.9), toInt(-3.9), toInt(big), toInt(-big), toU8(300.5), toU8(-1.5))
	println("bool", both(true, false), both(true, true), either(false, false), either(false, true))
	println("neg", -5, ^5, 7&^2)
}

// CHECK: fib 6765
// CHECK-NEXT: sum 30
// CHECK-NEXT: div 3 -3 -9223372036854775808 -9223372036854775808
// CHECK-NEXT: rem 1 -1 0 0
// CHECK-NEXT: shl 8 -2147483648 0 0
// CHECK-NEXT: shr -4 -1 -1 0 1 0
// CHECK-NEXT: wrap 4 -128
// CHECK-NEXT: sat 3 -3 9223372036854775807 -9223372036854775808 255 0
// CHECK-NEXT: bool false true false true
// CHECK-NEXT: neg -5 -6 5
