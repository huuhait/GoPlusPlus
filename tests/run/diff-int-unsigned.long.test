// RUN: %python %S/Inputs/run-golden.py --src %S/Inputs/diff/int_uint16.gopp %S/Inputs/diff/int_uint16.out
// RUN: %python %S/Inputs/run-golden.py --src %S/Inputs/diff/int_uint32.gopp %S/Inputs/diff/int_uint32.out
// RUN: %python %S/Inputs/run-golden.py --src %S/Inputs/diff/int_uint64.gopp %S/Inputs/diff/int_uint64.out
// RUN: %python %S/Inputs/run-golden.py --src %S/Inputs/diff/int_uint.gopp %S/Inputs/diff/int_uint.out
// RUN: %python %S/Inputs/run-golden.py --src %S/Inputs/diff/int_uintptr.gopp %S/Inputs/diff/int_uintptr.out
// P04.04 differential table (D4.12): the unsigned integer types, hundreds
// of expressions per type over its edge values. The programs and their
// expected output come from Inputs/gen-diff.py: Inputs/diff/NAME.out is what
// Go prints for the same program (`go run`), so the test needs no Go. On
// linux/arm64 under QEMU: diff-int-unsigned-arm64.long.test.
