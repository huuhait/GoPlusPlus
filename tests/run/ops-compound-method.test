// REQUIRES: host-linux-amd64 || host-linux-arm64
// GOLDEN: by-hand
// RUN: %python %S/Inputs/run-golden.py --src %s %S/golden/ops-compound-method.out 0
// RUN: %if qemu-aarch64 %{ %gopp build -target=linux/arm64 -crt-dir=%aarch64_sysroot/lib %s -o %t.arm64 %}
// RUN: %if qemu-aarch64 %{ %python %S/Inputs/run-golden.py --qemu %aarch64_sysroot %t.arm64 %S/golden/ops-compound-method.out 0 %}
// P04.23 review R1: `m[i] op= v` where the ELEMENT's operator is a method
// (V has `+` and `-`), through the `[]` and `[]=` of M. The receiver and the
// index are evaluated once (`ix()` is counted). By hand: m = {10, 20};
// m[0] += 7 -> 17; m[ix()] -= 5 with ix() = 1 -> 15 and one call; the
// two-index form g[1, 1] += 3 over {{1,2},{3,4}} -> 7.
package main

type V struct{ x int }

func (a V) + (b V) V { return V{a.x + b.x} }
func (a V) - (b V) V { return V{a.x - b.x} }

type M struct{ d []V }

func (m M) [] (i int) V      { return m.d[i] }
func (m *M) []= (i int, v V) { m.d[i] = v }

type G struct{ d [][]V }

func (g G) [] (i, j int) V      { return g.d[i][j] }
func (g *G) []= (i, j int, v V) { g.d[i][j] = v }

var calls int

func ix() int {
	calls++
	return 1
}

func main() {
	m := M{[]V{{10}, {20}}}
	m[0] += V{7}
	println(m.d[0].x)
	m[ix()] -= V{5}
	println(m.d[1].x, calls)
	g := G{[][]V{{{1}, {2}}, {{3}, {4}}}}
	g[1, 1] += V{3}
	println(g.d[1][1].x)
}
