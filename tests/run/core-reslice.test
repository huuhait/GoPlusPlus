// GOLDEN: by-hand
// REQUIRES: host-linux-amd64 || host-linux-arm64
// RUN: %python %S/Inputs/run-golden.py --src %s %S/golden/core-reslice.out
// RUN: %if qemu-aarch64 %{ %gopp build -target=linux/arm64 -crt-dir=%aarch64_sysroot/lib %s -o %t.arm64 %}
// RUN: %if qemu-aarch64 %{ %python %S/Inputs/run-golden.py --qemu %aarch64_sysroot %t.arm64 %S/golden/core-reslice.out %}
// P04.05: where Go++ slices differ from Go (spec chapter 8).
// - SLC-6, SLC-7: `s = s[i:j]` on the same owned slice (the checker records
//   it, Info::Reslices) shrinks it in place: the kept elements move down to
//   the start of the block and the capacity stays. In a tuple assignment the
//   move is made when the header is stored, so `s, x = s[1:], s[0]` reads
//   s[0] where it was (also through a pointer, `*p = (*p)[1:2]`).
// - PAR-2: a borrowed slice parameter is re-pointed, not shrunk: the caller's
//   elements do not move.
// - SLC-12: the capacity of a borrowed slice (a parameter, a part made by
//   slicing) is its length.
// - SLC-8 (review R4): a part of a pointer to an array, unsafe.Slice and a
//   part of a defined slice type are borrowed, so `t = t[1:]` re-points
//   them and the array or the owner's elements never move.
// Go has none of this, so the expected output is written by hand.
package main

import "unsafe"

type IS []int

type Box struct{ arr [4]int }

func viaParam(a [4]int) int {
	t := a[0:3]
	t = t[1:]
	return a[0]*1000 + a[1]*100 + a[2]*10 + t[0]
}

func repoint(xs []int) {
	xs = xs[1:]
	println(len(xs), cap(xs), xs[0])
}

func capOf(xs []int) int { return cap(xs) }

func main() {
	s := []int{1, 2, 3, 4}
	var x int
	s, x = s[1:], s[0]
	println(len(s), cap(s), s[0], s[1], s[2], x)
	x, s = s[0], s[1:]
	println(len(s), cap(s), s[0], s[1], x)
	s = s[:0]
	println(len(s), cap(s))
	t := []string{"a", "b", "c"}
	t = t[2:]
	println(len(t), cap(t), t[0])
	p := &s
	s = []int{7, 8, 9}
	*p = (*p)[1:2]
	println(len(s), cap(s), s[0])
	u := []int{1, 2, 3}
	repoint(u)
	println(u[0], u[1], u[2])
	w := make([]int, 2, 10)
	part := w[0:1]
	var a [8]int
	println(capOf(w), cap(part), cap(a[2:4]), capOf(a[2:5]), cap(w))
	// borrowed parts are re-pointed (R4)
	arr := [4]int{1, 2, 3, 4}
	pa := &arr
	pt := pa[0:3]
	pt = pt[1:]
	println(arr[0], arr[1], arr[2], arr[3], len(pt), cap(pt), pt[0])
	ub := [4]int{1, 2, 3, 4}
	us := unsafe.Slice(&ub[0], 4)
	us = us[2:]
	println(ub[0], ub[1], ub[2], ub[3], len(us), cap(us), us[0])
	is := IS{1, 2, 3, 4}
	it := is[1:3]
	it = it[1:]
	println(is[0], is[1], is[2], is[3], len(it), it[0])
	is = is[1:]
	println(len(is), cap(is), is[0])
	bx := Box{[4]int{1, 2, 3, 4}}
	pb := &bx
	bt := pb.arr[0:3]
	bt = bt[1:]
	println(bx.arr[0], bx.arr[1], len(bt), bt[0], viaParam([4]int{1, 2, 3, 4}))
}
