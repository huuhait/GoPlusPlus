// RUN: %python %S/Inputs/run-golden.py --qemu %aarch64_sysroot %t.option %S/golden/iface-option.out 0
// RUN: %gopp build -target=linux/arm64 -crt-dir=%aarch64_sysroot/lib %S/iface-slices.test -o %t.slices
// RUN: %python %S/Inputs/run-golden.py --qemu %aarch64_sysroot %t.slices %S/golden/iface-slices.out 0
