// REQUIRES: host-linux-amd64 || host-linux-arm64
// RUN: %python %S/Inputs/run-golden.py --real --src %s %S/golden/iface-itab-memory.out
// GOLDEN: by-hand
// P04.06: an assertion or a conversion to an interface makes the itab of its
// (interface, dynamic type) pair at run time once (gopp.get_itab keeps it, or
// the fact that the type lacks a method, in a map of the pair), so a program
// that asserts many values of many types again and again needs memory for
// the pairs it meets, not for the assertions it makes. Here 64 types are
// asserted 10000 times each to an interface they implement and to one they
// do not: the bytes allocated and not freed (glibc's mallinfo2, in a real
// binary of its own) may grow by less than 1 MB (a leak of the smallest
// allocation per failed assertion alone is 10 MB). Go has no @Extern: the
// output is by hand.
package main

type Mallinfo2 struct {
	Arena, Ordblks, Smblks, Hblks, Hblkhd, Usmblks, Fsmblks uint64
	Uordblks, Fordblks, Keepcost                         uint64
}

@Extern("C")
func mallinfo2() Mallinfo2

type I interface{ M() int }
type J interface{ N() int }

type T0 struct{ v int }

func (t T0) M() int { return 0 }

type T1 struct{ v int }

func (t T1) M() int { return 1 }

type T2 struct{ v int }

func (t T2) M() int { return 2 }

type T3 struct{ v int }

func (t T3) M() int { return 3 }

type T4 struct{ v int }

func (t T4) M() int { return 4 }

