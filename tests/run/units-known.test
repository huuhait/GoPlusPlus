// REQUIRES: host-linux-amd64 || host-linux-arm64
// RUN: %python %S/Inputs/run-golden.py --src %s %S/golden/units-known.out 0
// RUN: %gopp build -opt=0 -pipeline=fastisel %s -o %t.fastisel
// RUN: %python %S/Inputs/run-golden.py %t.fastisel %S/golden/units-known.out 0
// RUN: %if qemu-aarch64 %{ %gopp build -target=linux/arm64 -crt-dir=%aarch64_sysroot/lib %s -o %t.arm64 %}
// RUN: %if qemu-aarch64 %{ %python %S/Inputs/run-golden.py --qemu %aarch64_sysroot %t.arm64 %S/golden/units-known.out 0 %}
// GOLDEN: by-hand
// P04.24 (final review of TODO item 1, R1): a body whose units the compiler
// knows (a method of an instance of a generic type, a function literal in
// one) passes the constant descriptor of the unit to a generic that takes
// descriptors: U alone, U*U, a wide factor (the electronvolt), and from a
// function literal. Each line prints plain code's value and the method's;
// they are equal (1000, 10^6, eV/J, eV^2/J^2; the bits of the eV lines). A
// recipe with no run-time parameter was the empty unit, factor 1, before.
// The same descriptor used on paths that do not dominate each other (if and
// else, a loop with both, a switch) is made at each use: such a body has no
// entry block to hoist it into (final review R2; -pipeline=fastisel, with no
// pass to fold the load, read an unset temporary).
// Written by hand: Go has no units.
package main

import "unsafe"

unit M
unit KG
unit S
unit KM = 1000 M
unit J = KG * M^2 / S^2
unit EV = (1602176634 / 10000000000000000000000000000) J

func bits(x float64) uint64 { return *(*uint64)(unsafe.Pointer(&x)) }

func Leaf[U unit, V unit](a float64[U], b float64[V]) float64 { return float64(a / b) }

type Pair[U unit, V unit] struct {
	a float64[U]
	b float64[V]
}

func (p Pair[U, V]) One() float64 { return Leaf(p.a, p.b) }
func (p Pair[U, V]) Sq() float64  { return Leaf(p.a*p.a, p.b*p.b) }
func (p Pair[U, V]) Lit() float64 {
	f := func() float64 { return Leaf(p.a, p.b) }
	return f()
}
func (p Pair[U, V]) LitSq() float64 {
	f := func() float64 { return Leaf(p.a*p.a, p.b*p.b) }
	return f()
}

// (Each runs the path that does not make the descriptor first, in a frame
// of its own; the same unit on both paths.)
@NoInline
func (p Pair[U, V]) Br(c bool) float64 {
	if c {
		return Leaf(p.a, p.b)
	}
	return Leaf(p.a, p.b) + 1
}

@NoInline
func (p Pair[U, V]) Loop(n int) float64 {
	s := 0.0
	for i := 0; i < n; i++ {
		if i%2 == 1 {
			s += Leaf(p.a*p.a, p.b*p.b)
		} else {
			s -= Leaf(p.a*p.a, p.b*p.b) * 2
		}
	}
	return s
}

@NoInline
func (p Pair[U, V]) Sw(k int) float64 {
	switch k {
	case 0:
		return Leaf(p.a, p.b)
	case 1:
		return Leaf(p.a, p.b) * 2
	default:
		return Leaf(p.a, p.b) * 3
	}
}

func main() {
	k, m := 1.0[KM], 1.0[M]
	km := Pair[KM, M]{k, m}
	e, j := 1.0[EV], 1.0[J]
	ej := Pair[EV, J]{e, j}
	println(km.Br(false), km.Br(true))
	println(km.Loop(4))
	println(km.Sw(2), km.Sw(1), km.Sw(0))
	println(bits(ej.Sw(1)), bits(ej.Br(true)))
	println(float64(k/m), km.One())
	println(float64((k*k)/(m*m)), km.Sq())
	println(float64(k/m), km.Lit())
	println(float64((k*k)/(m*m)), km.LitSq())
	println(bits(float64(e/j)), bits(ej.One()), bits(ej.Lit()))
	println(bits(float64((e*e)/(j*j))), bits(ej.Sq()), bits(ej.LitSq()))
}
