package main

// One call that gives one value is one argument, though a function
// value, an option and an interface value are held in several parts.

type Stage func(int) int

func count(stages ...Stage) int { return len(stages) }

func first(stages ...Stage) int { return stages[0](1) }

func scale(k int) Stage { return func(x int) int { return x * k } }

func maybe(n int) Option[int] {
	if n > 0 {
		return n
	}
	return nil
}

func set(options ...Option[int]) int {
	n := 0
	for _, o := range options {
		if o != nil {
			n++
		}
	}
	return n
}

type Shape interface{ Area() int }

type Square struct{ side int }

func (s Square) Area() int { return s.side * s.side }

func shape(side int) Shape { return Square{side} }

func areas(shapes ...Shape) int {
	sum := 0
	for _, s := range shapes {
		sum += s.Area()
	}
	return sum
}

func pair() (int, int) { return 3, 4 }

func sum(ns ...int) int {
	total := 0
	for _, n := range ns {
		total += n
	}
	return total
}

func words() (string, string, string) { return "a", "b", "c" }

func join(first string, rest ...string) string {
	for _, r := range rest {
		first += r
	}
	return first
}

func main() {
	println(count(scale(2)), first(scale(5)), count(scale(1), scale(2)))
	println(set(maybe(1)), set(maybe(0)), set(maybe(1), maybe(0), maybe(2)))
	println(areas(shape(2)), areas(shape(1), shape(3)), areas())
	println(sum(pair()), join(words()), sum(sum(pair())))
}
