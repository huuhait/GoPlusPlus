// REQUIRES: host-linux-amd64 || host-linux-arm64
// RUN: %python %S/Inputs/run-opt-matrix.py --gopp %gopp --root %S --link-flags "%gopp_link_flags" --jobs 4 --verify-dwarf --shard 0/6 --configs 3,s,z core-maps opt/memory panics/opt-index-loop iface-switch iface-narrow cc/calls0
