package main

// An array whose elements are not copied by their bytes is walked where
// it is: the loop sees what its body writes to a later element. Go
// walks a copy of every array.
func main() {
	names := [3]string{"a", "b", "c"}
	for i, name := range names {
		names[2] = "changed"
		println(i, name)
	}
	counts := [3]int{1, 2, 3}
	for i, count := range counts {
		counts[2] = 30
		println(i, count)
	}
}
