package main

import "sync"

type Handler func(name string, tags []string) int

type Route struct {
	path string
	run  Handler
}


// Only reads what it is given.
func count(name string, tags []string) int { return len(name) + len(tags) }

// Keeps what it is given.
var seen sync.Mutex[[]string]

func record(name string, tags []string) int {
	n := 0
	seen.With(func(all *[]string) {
		*all = append(*all, name)
		*all = append(*all, tags...)
		n = len(*all)
	})
	return n
}

func seenNames() []string {
	var names []string
	seen.With(func(all *[]string) { names = *all })
	return names
}

func register(routes []Route, path string, run Handler) []Route {
	return append(routes, Route{path, run})
}

func serve(routes []Route, path string, tags []string) int {
	for _, route := range routes {
		if route.path == path {
			return route.run(path, tags)
		}
	}
	return -1
}

func choose(n int) Handler {
	switch n {
	case 0:
		return count
	case 1:
		return record
	}
	return func(name string, tags []string) int { return -2 }
}

func main() {
	var routes []Route
	routes = register(routes, "/count", count)
	routes = register(routes, "/record", record)
	routes = register(routes, "/literal", func(name string, tags []string) int { return len(tags) * 10 })
	tags := []string{"a", "b"}
	println(serve(routes, "/count", tags), serve(routes, "/record", tags), serve(routes, "/literal", tags), serve(routes, "/none", tags))
	tags[0] = "changed"
	println(len(seenNames()), seenNames()[1], tags[0])
	println(serve(routes, "/record", []string{"c"}), len(seenNames()))

	first := choose(0)
	second := first
	println(first("ab", nil), second("abc", tags))
	var held any = second
	if run, ok := held.(Handler); ok {
		println(run("x", tags))
	}
	println(len(routes), routes[2].run("", tags))
}
