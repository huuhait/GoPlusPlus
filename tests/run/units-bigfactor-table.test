// REQUIRES: host-linux-amd64 || host-linux-arm64
// RUN: %python %S/Inputs/gen-units-bigtable.py --check %s %S/golden/units-bigfactor-table.out
// RUN: %python %S/Inputs/run-golden.py --src %s %S/golden/units-bigfactor-table.out 0
// RUN: %if qemu-aarch64 %{ %gopp build -target=linux/arm64 -crt-dir=%aarch64_sysroot/lib %s -o %t.arm64 %}
// RUN: %if qemu-aarch64 %{ %python %S/Inputs/run-golden.py --qemu %aarch64_sysroot %t.arm64 %S/golden/units-bigfactor-table.out 0 %}
// GOLDEN: by-hand
// P04.24 (TODO item 1): written by Inputs/gen-units-bigtable.py (see there); do
// not edit. Plain code against generic code for random rationals made of the SI
// and CODATA factors and for the float32 and float64 boundaries; the golden is
// computed by the script with exact fractions.
package main

import "unsafe"

unit M
unit KG
unit S
unit KM = 1000 M
unit MI = (1609344 / 1000) M
unit IN = (254 / 10000) M
unit AU = 149597870700 M
unit LY = 9460730472580800 M
unit ANG = (1 / 10000000000) M
unit G = (1 / 1000) KG
unit LB = (45359237 / 100000000) KG
unit DA = (166053906660 / 100000000000000000000000000000000000000) KG
unit ME = (91093837015 / 100000000000000000000000000000000000000000) KG
unit MP = (167262192369 / 100000000000000000000000000000000000000) KG
unit MIN = 60 S
unit H = 3600 S
unit YR = 31557600 S
unit NS = (1 / 1000000000) S
unit J = KG * M^2 / S^2
unit EV = (1602176634 / 10000000000000000000000000000) J
unit CAL = (4184 / 1000) J
unit KWH = 3600000 J
unit EH = (43597447222071 / 10000000000000000000000000000000) J
unit FMAX = 340282346638528859811704183484516925440 M
unit F128 = 340282366920938463463374607431768211456 M
unit FTIE = 340282356779733661637539395458142568448 M
unit TWO400 = 2582249878086908589655919172003011874329705792829223512830659356540647622016841194629645353280137831435903171972747493376 M
unit TWO500 = 3273390607896141870013189696827599152216642046043064789483291368096133796404674554883270092325904157150886684127560071009217256545885393053328527589376 M
unit D53 = 9007199254740991 M
unit D54 = 18014398509481983 M
unit TWO71 = 2361183241434822606848 M
unit TWO70 = 1180591620717411303424 M
unit TWO24 = 16777216 M
unit TWO74 = 18889465931478580854784 M
unit TWO75 = 37778931862957161709568 M
unit TWO149 = 713623846352979940529142984724747568191373312 M
unit TWO150 = 1427247692705959881058285969449495136382746624 M
unit TWO151 = 2854495385411919762116571938898990272765493248 M
unit THREE = 3 M
unit X24 = (16777217 / 16777216) M
unit X53 = (9007199254740993 / 9007199254740992) M
unit Y1 = (6703903964971298549787012499102923063739682910296196688861780721860882015036773488400937149083451713845015929093243025426876941405973284973216824503042048 / 6703903964971298549787012499102923063739682910296196688861780721860882015036773488400937149083451713845015929093243025426876941405973284973216824503042047) M
unit Y2 = (6703903964971298549787012499102923063739682910296196688861780721860882015036773488400937149083451713845015929093243025426876941405973284973216824503042049 / 6703903964971298549787012499102923063739682910296196688861780721860882015036773488400937149083451713845015929093243025426876941405973284973216824503042048) M

func bits(x float64) uint64   { return *(*uint64)(unsafe.Pointer(&x)) }
func bits32(x float32) uint32 { return *(*uint32)(unsafe.Pointer(&x)) }

func GQ64[U unit, V unit](a float64[U], b float64[V]) float64 { return float64(a / b) }
func GP64[U unit, V unit](a float64[U], b float64[1/V]) float64 { return float64(a * b) }
func GQ32[U unit, V unit](a float32[U], b float32[V]) float32 { return float32(a / b) }
func GP32[U unit, V unit](a float32[U], b float32[1/V]) float32 { return float32(a * b) }
func GQI[U unit, V unit](a int64[U], b int64[V]) int64 { return int64(a / b) }
func GPI[U unit, V unit](a int64[U], b int64[1/V]) int64 { return int64(a * b) }

// The units are known in a method of an instance (the reference for int64).
type Pair[U unit, V unit] struct {
	a int64[U]
	b int64[V]
	c int64[1/V]
}

func (p Pair[U, V]) Q() int64 { return int64(p.a / p.b) }
func (p Pair[U, V]) P() int64 { return int64(p.a * p.c) }

// A method of an instance of a generic type (its units known) calling the
// generic that takes descriptors: the constant descriptors of its units.
func (p Pair[U, V]) QG() int64 { return GQI(p.a, p.b) }

type PairF[U unit, V unit] struct {
	a float64[U]
	b float64[V]
}

func (p PairF[U, V]) Q() float64  { return GQ64(p.a, p.b) }
func (p PairF[U, V]) QQ() float64 { return GQ64(p.a*p.a, p.b*p.b) }
func (p PairF[U, V]) QL() float64 {
	f := func() float64 { return GQ64(p.a, p.b) }
	return f()
}

type T0 = Pair[AU/KG^3, KM/G^3]
type TF0 = PairF[AU/KG^3, KM/G^3]
type T1 = Pair[1/ANG^2/ME^3, 1/ANG^2/ME^3]
type TF1 = PairF[1/ANG^2/ME^3, 1/ANG^2/ME^3]
type T2 = Pair[1/KG^2, 1/G^2]
type TF2 = PairF[1/KG^2, 1/G^2]
type T3 = Pair[MIN^3*M^2/J, YR^3*LY^2/EV]
type TF3 = PairF[MIN^3*M^2/J, YR^3*LY^2/EV]
type T4 = Pair[DA/H, MP/H]
type TF4 = PairF[DA/H, MP/H]
type T5 = Pair[LB^2*EV^3, KG^2*KWH^3]
type TF5 = PairF[LB^2*EV^3, KG^2*KWH^3]
type T6 = Pair[KG, ME]
type TF6 = PairF[KG, ME]
type T7 = Pair[1/M^2, 1/AU^2]
type TF7 = PairF[1/M^2, 1/AU^2]
type T8 = Pair[1/EH^2, 1/EV^2]
type TF8 = PairF[1/EH^2, 1/EV^2]
type T9 = Pair[1/CAL^2, 1/KWH^2]
type TF9 = PairF[1/CAL^2, 1/KWH^2]
type T10 = Pair[KM^2*KWH^2/YR^2, LY^2*EH^2/MIN^2]
type TF10 = PairF[KM^2*KWH^2/YR^2, LY^2*EH^2/MIN^2]
type T11 = Pair[1/J^3/LY/S^3, 1/J^3/LY/S^3]
type TF11 = PairF[1/J^3/LY/S^3, 1/J^3/LY/S^3]
type T12 = Pair[NS^3/ANG^2, H^3/MI^2]
type TF12 = PairF[NS^3/ANG^2, H^3/MI^2]
type T13 = Pair[1/MP^2, 1/ME^2]
type TF13 = PairF[1/MP^2, 1/ME^2]
type T14 = Pair[DA*EH^3, KG*J^3]
type TF14 = PairF[DA*EH^3, KG*J^3]
type T15 = Pair[DA^2, ME^2]
type TF15 = PairF[DA^2, ME^2]
type T16 = Pair[FMAX, M]
type T17 = Pair[FTIE, M]
type T18 = Pair[F128, M]
type T19 = Pair[M, TWO149]
type T20 = Pair[M, TWO150]
type T21 = Pair[THREE, TWO151]
type T22 = Pair[D53*TWO400*TWO500*TWO71, M*M*M*M]
type T23 = Pair[D54*TWO400*TWO500*TWO70, M*M*M*M]
type T24 = Pair[TWO500*TWO500*TWO24, M*M*M]
type T25 = Pair[M*M*M, TWO500*TWO500*TWO74]
type T26 = Pair[M*M*M, TWO500*TWO500*TWO75]
type T27 = Pair[THREE*M*M*M, TWO500*TWO500*TWO75*M]
type T28 = Pair[X24*Y1, M*Y2]
type T29 = Pair[X53*Y1, M*Y2]
type T30 = Pair[X24, M]
type T31 = Pair[X53, M]

func main() {
	{
		a, b, c := 1.0[AU/KG^3], 1.0[KM/G^3], 1.0[1/(KM/G^3)]
		println("r0", "f64", "1/1", bits(float64(a/b)), bits(GQ64(a, b)))
		println("r0", "f64", "1*1", bits(float64(a*c)), bits(GP64(a, c)))
		q := TF0{a, b}
		println("r0", "method", "1/1", bits(float64(a/b)), bits(q.Q()))
		println("r0", "literal", "1/1", bits(float64(a/b)), bits(q.QL()))
		println("r0", "method", "1^2/1^2", bits(float64((a*a)/(b*b))), bits(q.QQ()))
		a32, b32, c32 := float32[AU/KG^3](1), float32[KM/G^3](1), float32[1/(KM/G^3)](1)
		println("r0", "f32", "1/1", bits32(float32(a32/b32)), bits32(GQ32(a32, b32)))
		println("r0", "f32", "1*1", bits32(float32(a32*c32)), bits32(GP32(a32, c32)))
	}
	{
		a, b, c := 3.0[AU/KG^3], 7.0[KM/G^3], 7.0[1/(KM/G^3)]
		println("r0", "f64", "3/7", bits(float64(a/b)), bits(GQ64(a, b)))
		println("r0", "f64", "3*7", bits(float64(a*c)), bits(GP64(a, c)))
		q := TF0{a, b}
		println("r0", "method", "3/7", bits(float64(a/b)), bits(q.Q()))
		println("r0", "literal", "3/7", bits(float64(a/b)), bits(q.QL()))
		println("r0", "method", "3^2/7^2", bits(float64((a*a)/(b*b))), bits(q.QQ()))
		a32, b32, c32 := float32[AU/KG^3](3), float32[KM/G^3](7), float32[1/(KM/G^3)](7)
		println("r0", "f32", "3/7", bits32(float32(a32/b32)), bits32(GQ32(a32, b32)))
		println("r0", "f32", "3*7", bits32(float32(a32*c32)), bits32(GP32(a32, c32)))
	}
	{
		a, b, c := -3.0[AU/KG^3], 7.0[KM/G^3], 7.0[1/(KM/G^3)]
		println("r0", "f64", "-3/7", bits(float64(a/b)), bits(GQ64(a, b)))
		println("r0", "f64", "-3*7", bits(float64(a*c)), bits(GP64(a, c)))
		q := TF0{a, b}
		println("r0", "method", "-3/7", bits(float64(a/b)), bits(q.Q()))
		println("r0", "literal", "-3/7", bits(float64(a/b)), bits(q.QL()))
		println("r0", "method", "-3^2/7^2", bits(float64((a*a)/(b*b))), bits(q.QQ()))
		a32, b32, c32 := float32[AU/KG^3](-3), float32[KM/G^3](7), float32[1/(KM/G^3)](7)
		println("r0", "f32", "-3/7", bits32(float32(a32/b32)), bits32(GQ32(a32, b32)))
		println("r0", "f32", "-3*7", bits32(float32(a32*c32)), bits32(GP32(a32, c32)))
	}
	{
		p := T0{int64[AU/KG^3](123456789012345), int64[KM/G^3](7), int64[1/(KM/G^3)](7)}
		println("r0", "i64", "123456789012345/7", p.Q(), GQI(p.a, p.b))
		println("r0", "i64", "123456789012345*7", p.P(), GPI(p.a, p.c))
		println("r0", "i64-method", "123456789012345/7", p.Q(), p.QG())
	}
	{
		p := T0{int64[AU/KG^3](-123456789012345), int64[KM/G^3](7), int64[1/(KM/G^3)](7)}
		println("r0", "i64", "-123456789012345/7", p.Q(), GQI(p.a, p.b))
		println("r0", "i64", "-123456789012345*7", p.P(), GPI(p.a, p.c))
		println("r0", "i64-method", "-123456789012345/7", p.Q(), p.QG())
	}
	{
		p := T0{int64[AU/KG^3](7), int64[KM/G^3](123456789012345), int64[1/(KM/G^3)](123456789012345)}
		println("r0", "i64", "7/123456789012345", p.Q(), GQI(p.a, p.b))
		println("r0", "i64", "7*123456789012345", p.P(), GPI(p.a, p.c))
		println("r0", "i64-method", "7/123456789012345", p.Q(), p.QG())
	}
	{
		a, b, c := 1.0[1/ANG^2/ME^3], 1.0[1/ANG^2/ME^3], 1.0[1/(1/ANG^2/ME^3)]
		println("r1", "f64", "1/1", bits(float64(a/b)), bits(GQ64(a, b)))
		println("r1", "f64", "1*1", bits(float64(a*c)), bits(GP64(a, c)))
		q := TF1{a, b}
		println("r1", "method", "1/1", bits(float64(a/b)), bits(q.Q()))
		println("r1", "literal", "1/1", bits(float64(a/b)), bits(q.QL()))
		println("r1", "method", "1^2/1^2", bits(float64((a*a)/(b*b))), bits(q.QQ()))
		a32, b32, c32 := float32[1/ANG^2/ME^3](1), float32[1/ANG^2/ME^3](1), float32[1/(1/ANG^2/ME^3)](1)
		println("r1", "f32", "1/1", bits32(float32(a32/b32)), bits32(GQ32(a32, b32)))
		println("r1", "f32", "1*1", bits32(float32(a32*c32)), bits32(GP32(a32, c32)))
	}
	{
		a, b, c := 3.0[1/ANG^2/ME^3], 7.0[1/ANG^2/ME^3], 7.0[1/(1/ANG^2/ME^3)]
		println("r1", "f64", "3/7", bits(float64(a/b)), bits(GQ64(a, b)))
		println("r1", "f64", "3*7", bits(float64(a*c)), bits(GP64(a, c)))
		q := TF1{a, b}
		println("r1", "method", "3/7", bits(float64(a/b)), bits(q.Q()))
		println("r1", "literal", "3/7", bits(float64(a/b)), bits(q.QL()))
		println("r1", "method", "3^2/7^2", bits(float64((a*a)/(b*b))), bits(q.QQ()))
		a32, b32, c32 := float32[1/ANG^2/ME^3](3), float32[1/ANG^2/ME^3](7), float32[1/(1/ANG^2/ME^3)](7)
		println("r1", "f32", "3/7", bits32(float32(a32/b32)), bits32(GQ32(a32, b32)))
		println("r1", "f32", "3*7", bits32(float32(a32*c32)), bits32(GP32(a32, c32)))
	}
	{
		a, b, c := -3.0[1/ANG^2/ME^3], 7.0[1/ANG^2/ME^3], 7.0[1/(1/ANG^2/ME^3)]
		println("r1", "f64", "-3/7", bits(float64(a/b)), bits(GQ64(a, b)))
		println("r1", "f64", "-3*7", bits(float64(a*c)), bits(GP64(a, c)))
		q := TF1{a, b}
		println("r1", "method", "-3/7", bits(float64(a/b)), bits(q.Q()))
		println("r1", "literal", "-3/7", bits(float64(a/b)), bits(q.QL()))
		println("r1", "method", "-3^2/7^2", bits(float64((a*a)/(b*b))), bits(q.QQ()))
		a32, b32, c32 := float32[1/ANG^2/ME^3](-3), float32[1/ANG^2/ME^3](7), float32[1/(1/ANG^2/ME^3)](7)
		println("r1", "f32", "-3/7", bits32(float32(a32/b32)), bits32(GQ32(a32, b32)))
		println("r1", "f32", "-3*7", bits32(float32(a32*c32)), bits32(GP32(a32, c32)))
	}
	{
		p := T1{int64[1/ANG^2/ME^3](123456789012345), int64[1/ANG^2/ME^3](7), int64[1/(1/ANG^2/ME^3)](7)}
		println("r1", "i64", "123456789012345/7", p.Q(), GQI(p.a, p.b))
		println("r1", "i64", "123456789012345*7", p.P(), GPI(p.a, p.c))
		println("r1", "i64-method", "123456789012345/7", p.Q(), p.QG())
	}
	{
		p := T1{int64[1/ANG^2/ME^3](-123456789012345), int64[1/ANG^2/ME^3](7), int64[1/(1/ANG^2/ME^3)](7)}
		println("r1", "i64", "-123456789012345/7", p.Q(), GQI(p.a, p.b))
		println("r1", "i64", "-123456789012345*7", p.P(), GPI(p.a, p.c))
		println("r1", "i64-method", "-123456789012345/7", p.Q(), p.QG())
	}
	{
		p := T1{int64[1/ANG^2/ME^3](7), int64[1/ANG^2/ME^3](123456789012345), int64[1/(1/ANG^2/ME^3)](123456789012345)}
		println("r1", "i64", "7/123456789012345", p.Q(), GQI(p.a, p.b))
		println("r1", "i64", "7*123456789012345", p.P(), GPI(p.a, p.c))
		println("r1", "i64-method", "7/123456789012345", p.Q(), p.QG())
	}
	{
		a, b, c := 1.0[1/KG^2], 1.0[1/G^2], 1.0[1/(1/G^2)]
		println("r2", "f64", "1/1", bits(float64(a/b)), bits(GQ64(a, b)))
		println("r2", "f64", "1*1", bits(float64(a*c)), bits(GP64(a, c)))
		q := TF2{a, b}
		println("r2", "method", "1/1", bits(float64(a/b)), bits(q.Q()))
		println("r2", "literal", "1/1", bits(float64(a/b)), bits(q.QL()))
		println("r2", "method", "1^2/1^2", bits(float64((a*a)/(b*b))), bits(q.QQ()))
		a32, b32, c32 := float32[1/KG^2](1), float32[1/G^2](1), float32[1/(1/G^2)](1)
		println("r2", "f32", "1/1", bits32(float32(a32/b32)), bits32(GQ32(a32, b32)))
		println("r2", "f32", "1*1", bits32(float32(a32*c32)), bits32(GP32(a32, c32)))
	}
	{
		a, b, c := 3.0[1/KG^2], 7.0[1/G^2], 7.0[1/(1/G^2)]
		println("r2", "f64", "3/7", bits(float64(a/b)), bits(GQ64(a, b)))
		println("r2", "f64", "3*7", bits(float64(a*c)), bits(GP64(a, c)))
		q := TF2{a, b}
		println("r2", "method", "3/7", bits(float64(a/b)), bits(q.Q()))
		println("r2", "literal", "3/7", bits(float64(a/b)), bits(q.QL()))
		println("r2", "method", "3^2/7^2", bits(float64((a*a)/(b*b))), bits(q.QQ()))
		a32, b32, c32 := float32[1/KG^2](3), float32[1/G^2](7), float32[1/(1/G^2)](7)
		println("r2", "f32", "3/7", bits32(float32(a32/b32)), bits32(GQ32(a32, b32)))
		println("r2", "f32", "3*7", bits32(float32(a32*c32)), bits32(GP32(a32, c32)))
	}
	{
		a, b, c := -3.0[1/KG^2], 7.0[1/G^2], 7.0[1/(1/G^2)]
		println("r2", "f64", "-3/7", bits(float64(a/b)), bits(GQ64(a, b)))
		println("r2", "f64", "-3*7", bits(float64(a*c)), bits(GP64(a, c)))
		q := TF2{a, b}
		println("r2", "method", "-3/7", bits(float64(a/b)), bits(q.Q()))
		println("r2", "literal", "-3/7", bits(float64(a/b)), bits(q.QL()))
		println("r2", "method", "-3^2/7^2", bits(float64((a*a)/(b*b))), bits(q.QQ()))
		a32, b32, c32 := float32[1/KG^2](-3), float32[1/G^2](7), float32[1/(1/G^2)](7)
		println("r2", "f32", "-3/7", bits32(float32(a32/b32)), bits32(GQ32(a32, b32)))
		println("r2", "f32", "-3*7", bits32(float32(a32*c32)), bits32(GP32(a32, c32)))
	}
	{
		p := T2{int64[1/KG^2](123456789012345), int64[1/G^2](7), int64[1/(1/G^2)](7)}
		println("r2", "i64", "123456789012345/7", p.Q(), GQI(p.a, p.b))
		println("r2", "i64", "123456789012345*7", p.P(), GPI(p.a, p.c))
		println("r2", "i64-method", "123456789012345/7", p.Q(), p.QG())
	}
	{
		p := T2{int64[1/KG^2](-123456789012345), int64[1/G^2](7), int64[1/(1/G^2)](7)}
		println("r2", "i64", "-123456789012345/7", p.Q(), GQI(p.a, p.b))
		println("r2", "i64", "-123456789012345*7", p.P(), GPI(p.a, p.c))
		println("r2", "i64-method", "-123456789012345/7", p.Q(), p.QG())
	}
	{
		p := T2{int64[1/KG^2](7), int64[1/G^2](123456789012345), int64[1/(1/G^2)](123456789012345)}
		println("r2", "i64", "7/123456789012345", p.Q(), GQI(p.a, p.b))
		println("r2", "i64", "7*123456789012345", p.P(), GPI(p.a, p.c))
		println("r2", "i64-method", "7/123456789012345", p.Q(), p.QG())
	}
	{
		a, b, c := 1.0[MIN^3*M^2/J], 1.0[YR^3*LY^2/EV], 1.0[1/(YR^3*LY^2/EV)]
		println("r3", "f64", "1/1", bits(float64(a/b)), bits(GQ64(a, b)))
		println("r3", "f64", "1*1", bits(float64(a*c)), bits(GP64(a, c)))
		q := TF3{a, b}
		println("r3", "method", "1/1", bits(float64(a/b)), bits(q.Q()))
		println("r3", "literal", "1/1", bits(float64(a/b)), bits(q.QL()))
		println("r3", "method", "1^2/1^2", bits(float64((a*a)/(b*b))), bits(q.QQ()))
