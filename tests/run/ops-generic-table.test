	chk("11", GLe(id_int8(int8(-10)), id_int8(int8(-10))) == ((id_int8(int8(-10)) <=> id_int8(int8(-10))) <= 0))
	chk("12", GGt(id_int8(int8(-10)), id_int8(int8(-10))) == ((id_int8(int8(-10)) <=> id_int8(int8(-10))) > 0))
	chk("13", GGe(id_int8(int8(-10)), id_int8(int8(-10))) == ((id_int8(int8(-10)) <=> id_int8(int8(-10))) >= 0))
