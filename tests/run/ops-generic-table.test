// REQUIRES: host-linux-amd64 || host-linux-arm64
// GOLDEN: by-hand
// RUN: %python %S/Inputs/run-golden.py --src %s %S/golden/ops-generic-table.out 0
// RUN: %if qemu-aarch64 %{ %gopp build -target=linux/arm64 -crt-dir=%aarch64_sysroot/lib %s -o %t.arm64 %}
// RUN: %if qemu-aarch64 %{ %python %S/Inputs/run-golden.py --qemu %aarch64_sysroot %t.arm64 %S/golden/ops-generic-table.out 0 %}
// P04.23 review R2, R5, R6: the plain-vs-generic table for operators (CLAUDE.md
// lesson). Every row prints MISMATCH when the generic body's result differs
// from the plain expression's, and the last line counts the rows, so the
// golden is the one line "rows N bad 0". Generated by Inputs/gen-ops-table.py
// (the body below is its output). It covers every binary operator, `op=`,
// unary `-`, `==`, `!=`, `<=>` and `< <= > >=` (GEN-13: `(a <=> b) OP 0`, so
// a float NaN follows cmp.Compare in the generic body), `++`, over int8,
// uint, float32, float64, string and a user struct, and the OVERLOAD SETS
// (EXP-17): U has `+` and `*` for U and for W, binary and unary `-`; Meters
// has `+` and `*` only for Seconds, so a generic `+` over two Meters is the
// built-in one while `GMulS` finds the Seconds method.
package main

type U struct{ n int }
type W struct{ n int }
type Seconds float64
type Meters float64

func (a U) + (b W) U { return U{a.n + b.n*1000} }
func (a U) * (b W) U { return U{a.n * b.n * 1000} }
func (a Meters) + (b Seconds) Seconds { return Seconds(float64(a) + float64(b) + 1000) }
func (a Meters) * (b Seconds) Seconds { return Seconds(float64(a) * float64(b) * 1000) }
func (a U) + (b U) U { return U{a.n + b.n} }
func (a U) - (b U) U { return U{a.n - b.n} }
func (a U) * (b U) U { return U{a.n * b.n} }
func (a U) - () U { return U{-a.n} }
func (a U) == (b U) bool { return a.n == b.n }
func (a U) <=> (b U) int { if a.n < b.n { return -1 }; if a.n > b.n { return 1 }; return 0 }
func (a *U) ++ () { a.n += 10 }
func GAdd[T interface{ Copy; + (T) T }](a, b T) T { return a + b }
func GAddEq[T interface{ Copy; + (T) T }](a, b T) T { x := a; x += b; return x }
func GSub[T interface{ Copy; - (T) T }](a, b T) T { return a - b }
func GSubEq[T interface{ Copy; - (T) T }](a, b T) T { x := a; x -= b; return x }
func GMul[T interface{ Copy; * (T) T }](a, b T) T { return a * b }
func GMulEq[T interface{ Copy; * (T) T }](a, b T) T { x := a; x *= b; return x }
func GNeg[T interface{ Copy; - () T }](a T) T { return -a }
func GEq[T interface{ == (T) bool }](a, b T) bool { return a == b }
func GNe[T interface{ == (T) bool }](a, b T) bool { return a != b }
func GCmp[T interface{ <=> (T) int }](a, b T) int { return a <=> b }
func GLt[T interface{ <=> (T) int }](a, b T) bool { return a < b }
func GLe[T interface{ <=> (T) int }](a, b T) bool { return a <= b }
func GGt[T interface{ <=> (T) int }](a, b T) bool { return a > b }
func GGe[T interface{ <=> (T) int }](a, b T) bool { return a >= b }
func GInc[T interface{ Copy; ++ () }](a T) T { x := a; x++; return x }
func GAddW[T interface{ Copy; + (W) T }](a T, b W) T { return a + b }
func GMulW[T interface{ Copy; * (W) T }](a T, b W) T { return a * b }
func GMulS[T interface{ * (Seconds) Seconds }](a T, b Seconds) Seconds { return a * b }
var bad int

func id_int8(x int8) int8 { return x }
func id_uint(x uint) uint { return x }
func id_float32(x float32) float32 { return x }
func id_float64(x float64) float64 { return x }
func id_string(x string) string { return x + "" }
func id_Meters(x Meters) Meters { return x }
func chk(row string, ok bool) { if !ok { bad++; println("MISMATCH", row) } }

func main() {
	fz32 := float32(0)
	fz := fz32
	fnan := fz / fz
	finf := 1 / fz
	_ = finf
	dz := 0.0
	dnan := dz / dz
	dinf := 1 / dz
	_ = dinf
	chk("1", ((GAdd(id_int8(int8(-10)), id_int8(int8(-10)))) == (id_int8(int8(-10)) + id_int8(int8(-10)))))
	chk("2", ((GAddEq(id_int8(int8(-10)), id_int8(int8(-10)))) == (id_int8(int8(-10)) + id_int8(int8(-10)))))
	chk("3", ((GSub(id_int8(int8(-10)), id_int8(int8(-10)))) == (id_int8(int8(-10)) - id_int8(int8(-10)))))
	chk("4", ((GSubEq(id_int8(int8(-10)), id_int8(int8(-10)))) == (id_int8(int8(-10)) - id_int8(int8(-10)))))
	chk("5", ((GMul(id_int8(int8(-10)), id_int8(int8(-10)))) == (id_int8(int8(-10)) * id_int8(int8(-10)))))
	chk("6", ((GMulEq(id_int8(int8(-10)), id_int8(int8(-10)))) == (id_int8(int8(-10)) * id_int8(int8(-10)))))
