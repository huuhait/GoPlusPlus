// REQUIRES: host-linux-amd64 || host-linux-arm64
// RUN: %python %S/Inputs/run-golden.py --src %s %S/golden/core-checks.out 0
// Go's results for MinInt / -1, MinInt % -1 and shifts at and past the width
// The expected output is what `go run` prints for this very file
// (Inputs/regen-goldens.py); core-arm64.long.test runs it for linux/arm64.
package main

// Go's results where C and LLVM have undefined behavior (D4.12), for every
// signed width, next to the ordinary cases.

func div8(a, b int8) (int8, int8)     { return a / b, a % b }
func div16(a, b int16) (int16, int16) { return a / b, a % b }
func div32(a, b int32) (int32, int32) { return a / b, a % b }
func div64(a, b int64) (int64, int64) { return a / b, a % b }
func divInt(a, b int) (int, int)      { return a / b, a % b }

func shifts(a int32, u uint32, n uint, k int) {
	println(a<<n, a>>n, u<<n, u>>n, a<<k, a>>k, u<<k, u>>k)
}

func shifts8(a int8, u uint8, n uint8) {
	println(a<<n, a>>n, u<<n, u>>n)
}

func shifts64(a int64, u uint64, n uint64) {
	println(a<<n, a>>n, u<<n, u>>n)
}

func main() {
	println(div8(-128, -1))
	println(div16(-32768, -1))
	println(div32(-2147483648, -1))
	println(div64(-9223372036854775808, -1))
	println(divInt(-9223372036854775808, -1))
	println(div8(-128, 1))
	println(div8(127, -1))
	println(div32(-7, 2))
	println(div32(7, -2))
	println(div64(-9223372036854775807, -1))
	println(divInt(5, 3))
	ns := [8]uint{0, 1, 31, 32, 33, 63, 64, 1000}
	for i := 0; i < len(ns); i++ {
		n := ns[i]
		shifts(-5, 4000000000, n, int(n))
	}
	shifts8(-3, 200, 7)
	shifts8(-3, 200, 8)
	shifts8(-3, 200, 255)
	shifts64(-3, 18446744073709551615, 63)
	shifts64(-3, 18446744073709551615, 64)
	shifts64(-3, 18446744073709551615, 18446744073709551615)
	// Shifts of constants keep their exact value; the variable shift wraps.
	var s uint = 3
	println(1<<s, 255>>s, -8>>s)
}
