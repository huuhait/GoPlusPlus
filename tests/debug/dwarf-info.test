// RUN: %gopp build -emit=obj %S/Inputs/scopes.gopp -o %t.scopes.o
// RUN: llvm-dwarfdump --debug-info %t.scopes.o | FileCheck %s --check-prefix=SCOPES
// RUN: llvm-dwarfdump --verify %t.scopes.o | FileCheck %s --check-prefix=VERIFY
// RUN: %gopp build -emit=obj %S/Inputs/inl/a.gopp %S/Inputs/inl/b.gopp -o %t.inl.o
// RUN: llvm-dwarfdump --debug-info %t.inl.o | FileCheck %s --check-prefix=INLINE
// RUN: llvm-dwarfdump --verify %t.inl.o | FileCheck %s --check-prefix=VERIFY
// RUN: %gopp build -emit=obj %S/Inputs/types.gopp -o %t.types.o
// RUN: llvm-dwarfdump --debug-info %t.types.o | FileCheck %s --check-prefix=TYPES
// RUN: llvm-dwarfdump --verify %t.types.o | FileCheck %s --check-prefix=VERIFY
// RUN: %gopp build -emit=obj -target=linux/arm64 %S/Inputs/types.gopp -o %t.types.arm64.o
// RUN: llvm-dwarfdump --debug-info %t.types.arm64.o | FileCheck %s --check-prefix=TYPES
// RUN: llvm-dwarfdump --verify %t.types.arm64.o | FileCheck %s --check-prefix=VERIFY
// RUN: %gopp build -emit=obj -target=linux/arm64 %S/Inputs/inl/a.gopp %S/Inputs/inl/b.gopp -o %t.inl.arm64.o
// RUN: llvm-dwarfdump --debug-info %t.inl.arm64.o | FileCheck %s --check-prefix=INLINE
// P04.12, D4.7: the DWARF entries of the variables, the types and the scopes,
// on both targets, and `llvm-dwarfdump --verify` clean on each.

// A block with variables is a lexical block of the function's subprogram; the
// loop's body is one inside the loop's.
// SCOPES: DW_TAG_subprogram
// SCOPES: DW_AT_name ("main.shadow")
// SCOPES: DW_TAG_formal_parameter
// SCOPES: DW_AT_name ("x")
// SCOPES: DW_AT_decl_line (5)
// SCOPES: DW_TAG_variable
// SCOPES: DW_AT_name ("y")
// SCOPES: DW_AT_decl_line (6)
// SCOPES: DW_TAG_lexical_block
// SCOPES: DW_TAG_variable
// SCOPES: DW_AT_name ("x")
// SCOPES: DW_AT_decl_line (8)
// SCOPES: DW_AT_name ("y")
// SCOPES: DW_AT_decl_line (9)
// SCOPES: DW_TAG_lexical_block
// SCOPES: DW_AT_name ("i")
// SCOPES: DW_TAG_lexical_block
// SCOPES: DW_AT_name ("x")
// SCOPES: DW_AT_decl_line (13)

// Inlined code is a `DW_TAG_inlined_subroutine` of the callee, with the call
// site in the caller's file: `add` into `main` (in a.gopp) and into `twice`
// (in b.gopp).
// INLINE: DW_AT_name ("main.add")
// INLINE: DW_AT_inline (DW_INL_inlined)
// INLINE: DW_TAG_inlined_subroutine
// INLINE: DW_AT_abstract_origin ({{.*}} "main.add")
// INLINE: DW_AT_call_file ({{.*}}a.gopp")
// INLINE: DW_AT_call_line (7)
// INLINE: DW_TAG_inlined_subroutine
// INLINE: DW_AT_abstract_origin ({{.*}} "main.add")
// INLINE: DW_AT_call_file ({{.*}}b.gopp")
// INLINE: DW_AT_call_line (25)

// The types: base types by width, a struct with its field names, a string
// and a slice as {ptr, len, cap}, an array with its count, a pointer, an
// Option as {value, set}.
// TYPES-DAG: DW_AT_name ("int64")
// TYPES-DAG: DW_AT_name ("uint16")
// TYPES-DAG: DW_AT_name ("float32")
// TYPES-DAG: DW_AT_encoding (DW_ATE_float)
// TYPES-DAG: DW_AT_name ("bool")
// TYPES-DAG: DW_AT_encoding (DW_ATE_boolean)
// TYPES-DAG: DW_AT_name ("uint8")
// TYPES-DAG: DW_AT_encoding (DW_ATE_unsigned_char)
// TYPES-DAG: DW_TAG_array_type
// TYPES-DAG: DW_AT_count (0x03)
// TYPES-DAG: DW_AT_name ("main.Doc")
// TYPES-DAG: DW_AT_name ("title")
// TYPES-DAG: DW_AT_name ("tags")
// TYPES-DAG: DW_AT_name ("pos")
// TYPES-DAG: DW_AT_name ("Option[int64]")
// TYPES-DAG: DW_AT_name ("value")
// TYPES-DAG: DW_AT_name ("set")
// TYPES-DAG: DW_AT_name ("[]string")
// TYPES-DAG: DW_AT_name ("len")
// TYPES-DAG: DW_AT_name ("cap")
// TYPES-DAG: DW_TAG_pointer_type

// A DWARF the verifier accepts: no errors.
// VERIFY: No errors.
