type Q48 *Q47
type Q49 *Q48
type Q50 *Q49

//go:noinline
func walk(n *Node) int {
	println(n.val) // WALK
	return n.val
}

//go:noinline
func look(p *B) int {
	println(p.w) // LOOK
	return p.w
}

func main() {
	tail := Node{2, nil}
	head := Node{1, &tail}
	r := walk(&head)
	var b1 B
	b1.w = 5
	a := A{b: &b1, v: 7}
	b2 := B{a: &a, w: 9}
	r += look(&b2)
	x0 := P0{}
	x1 := P1{v: 10, p: &x0}
	x2 := P2{v: 20, p: &x1}
	x3 := P3{v: 30, p: &x2}
	x4 := P4{v: 40, p: &x3}
	x5 := P5{v: 50, p: &x4}
	x6 := P6{v: 60, p: &x5}
	x7 := P7{v: 70, p: &x6}
	x8 := P8{v: 80, p: &x7}
	x9 := P9{v: 90, p: &x8}
	x10 := P10{v: 100, p: &x9}
	x11 := P11{v: 110, p: &x10}
	x12 := P12{v: 120, p: &x11}
	x13 := P13{v: 130, p: &x12}
	x14 := P14{v: 140, p: &x13}
	x15 := P15{v: 150, p: &x14}
	x16 := P16{v: 160, p: &x15}
	x17 := P17{v: 170, p: &x16}
	x18 := P18{v: 180, p: &x17}
	x19 := P19{v: 190, p: &x18}
	var h Holder
	h.arr[1].v = 5
	h.k = 9
	q0 := Q0{q: 7}
	var q1 Q1 = &q0
	var q2 Q2 = &q1
	var q3 Q3 = &q2
	var q4 Q4 = &q3
	var q5 Q5 = &q4
	var q6 Q6 = &q5
	var q7 Q7 = &q6
	var q8 Q8 = &q7
	var q9 Q9 = &q8
	var q10 Q10 = &q9
	var q11 Q11 = &q10
	var q12 Q12 = &q11
	var q13 Q13 = &q12
	var q14 Q14 = &q13
	var q15 Q15 = &q14
	var q16 Q16 = &q15
	var q17 Q17 = &q16
	var q18 Q18 = &q17
	var q19 Q19 = &q18
	var q20 Q20 = &q19
	var q21 Q21 = &q20
	var q22 Q22 = &q21
	var q23 Q23 = &q22
	var q24 Q24 = &q23
	var q25 Q25 = &q24
	var q26 Q26 = &q25
	var q27 Q27 = &q26
	var q28 Q28 = &q27
	var q29 Q29 = &q28
	var q30 Q30 = &q29
	var q31 Q31 = &q30
	var q32 Q32 = &q31
	var q33 Q33 = &q32
	var q34 Q34 = &q33
	var q35 Q35 = &q34
	var q36 Q36 = &q35
	var q37 Q37 = &q36
	var q38 Q38 = &q37
	var q39 Q39 = &q38
	var q40 Q40 = &q39
	var q41 Q41 = &q40
	var q42 Q42 = &q41
	var q43 Q43 = &q42
	var q44 Q44 = &q43
	var q45 Q45 = &q44
	var q46 Q46 = &q45
	var q47 Q47 = &q46
	var q48 Q48 = &q47
	var q49 Q49 = &q48
	var q50 Q50 = &q49
	println(r, x19.v, h.arr[1].v, h.k, (**************************************************q50).q) // MAIN
}
