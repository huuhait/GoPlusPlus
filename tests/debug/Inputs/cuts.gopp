package main

// The cuts of DebugInfoBuilder::typeOf (debug/type-cuts.test). A pointer
// refers to a struct by a declaration of its name, and a part higher than
// MaxTypeHeight (48) is referred to that way too: gdb and lldb must find
// every value through them. (The chains are written by a loop.)

// A struct that points to itself; walk asks for the pointer first.
type Node struct {
	val  int
	next Option[*Node]
}

// Two structs that point to each other; look asks for *B first.
type A struct {
	b Option[*B]
	v int
}

type B struct {
	a Option[*A]
	w int
}

// A chain of structs through pointers.
type P0 struct{ v [1][1]int }
type P1 struct {
	v int
	p *P0
}
type P2 struct {
	v int
	p *P1
}
type P3 struct {
	v int
	p *P2
}
type P4 struct {
	v int
	p *P3
}
type P5 struct {
	v int
	p *P4
}
type P6 struct {
	v int
	p *P5
}
type P7 struct {
	v int
	p *P6
}
type P8 struct {
	v int
	p *P7
}
type P9 struct {
	v int
	p *P8
}
type P10 struct {
	v int
	p *P9
}
type P11 struct {
	v int
	p *P10
}
type P12 struct {
	v int
	p *P11
}
type P13 struct {
	v int
	p *P12
}
type P14 struct {
	v int
	p *P13
}
type P15 struct {
	v int
	p *P14
}
type P16 struct {
	v int
	p *P15
}
type P17 struct {
	v int
	p *P16
}
type P18 struct {
	v int
	p *P17
}
type P19 struct {
	v int
	p *P18
}

// A chain of structs by value: T22 is 47 levels high, an array of it 48.
type T0 struct{ v int }
type T1 struct {
	v  int
	in T0
}
type T2 struct {
	v  int
	in T1
}
type T3 struct {
	v  int
	in T2
}
type T4 struct {
	v  int
	in T3
}
type T5 struct {
	v  int
	in T4
}
type T6 struct {
	v  int
	in T5
}
type T7 struct {
	v  int
	in T6
}
type T8 struct {
	v  int
	in T7
}
type T9 struct {
	v  int
	in T8
}
type T10 struct {
	v  int
	in T9
}
type T11 struct {
	v  int
	in T10
}
type T12 struct {
	v  int
	in T11
}
type T13 struct {
	v  int
	in T12
}
type T14 struct {
	v  int
	in T13
}
type T15 struct {
	v  int
	in T14
}
type T16 struct {
	v  int
	in T15
}
type T17 struct {
	v  int
	in T16
}
type T18 struct {
	v  int
	in T17
}
type T19 struct {
	v  int
	in T18
}
type T20 struct {
	v  int
	in T19
}
type T21 struct {
	v  int
	in T20
}
type T22 struct {
	v  int
	in T21
}

type Holder struct {
	arr [2]T22
	k   int
}

// A chain of 50 pointers with no struct in it.
type Q0 struct{ q int }
type Q1 *Q0
type Q2 *Q1
type Q3 *Q2
type Q4 *Q3
type Q5 *Q4
type Q6 *Q5
type Q7 *Q6
type Q8 *Q7
type Q9 *Q8
type Q10 *Q9
type Q11 *Q10
type Q12 *Q11
type Q13 *Q12
type Q14 *Q13
type Q15 *Q14
type Q16 *Q15
type Q17 *Q16
type Q18 *Q17
type Q19 *Q18
type Q20 *Q19
type Q21 *Q20
type Q22 *Q21
type Q23 *Q22
type Q24 *Q23
type Q25 *Q24
type Q26 *Q25
type Q27 *Q26
type Q28 *Q27
type Q29 *Q28
type Q30 *Q29
type Q31 *Q30
type Q32 *Q31
