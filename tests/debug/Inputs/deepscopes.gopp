package main

// Blocks deeper than DebugInfoBuilder::MaxBlockDepth (64) share the 64th
// lexical block (debug/deep-scopes.test): there a variable whose name
// another one has has no location, so the debugger says it is optimized
// out instead of showing the other one's value; a name of its own is shown.
// The other side, below the limit: every shadowing x is its own. (The
// blocks are written by a loop.)

//go:noinline
func shallow() int {
	x := 0
	{ x := x + 1
	{ x := x + 1
	{ x := x + 1
	{ x := x + 1
	{ x := x + 1
	{ x := x + 1
	{ x := x + 1
	{ x := x + 1
	{ x := x + 1
	{ x := x + 1
	println(x) // SHALLOW
	}}}}}}}}}}
	return x
}

//go:noinline
func siblings() int {
	s := 0
	{ t0 := 0; s += t0
	{ t1 := 1; s += t1
	{ t2 := 2; s += t2
	{ t3 := 3; s += t3
	{ t4 := 4; s += t4
	{ t5 := 5; s += t5
	{ t6 := 6; s += t6
	{ t7 := 7; s += t7
	{ t8 := 8; s += t8
