	w := x * 2
	println(x, w) // DEEP
	}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}
	println(shallow(), siblings())
}
