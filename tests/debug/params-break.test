// GDB: Breakpoint 4, main.view (s={ptr = {{0x[0-9a-f]+}} "hey", len = 3, cap = 3}, xs={ptr = {{0x[0-9a-f]+}}, len = 4, cap = 4, alloc = 0x0}) at {{.*}}parambreak.gopp:47
