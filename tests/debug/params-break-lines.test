// CHECK-NEXT: {{^0x[0-9a-f]+}} 102 15 0 0 0 0 is_stmt prologue_end{{$}}
// CHECK:      {{^0x[0-9a-f]+}} 105 0 0 0 0 0 is_stmt{{$}}
