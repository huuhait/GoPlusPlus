// RUN: %gopp build -emit=llvm -pipeline=fastisel %s | FileCheck %s
// RUN: %gopp build -emit=llvm %s | FileCheck %s --check-prefix=OPT0
// RUN: %gopp build -emit=llvm -no-debug %s | FileCheck %s --check-prefix=NOFP
// RUN: %gopp build -emit=llvm -opt=2 %s | FileCheck %s --check-prefix=NOFP
// P04.13: -emit=llvm prints the IR the back end gets. By default that is the
// IR after the curated opt-0 passes (second RUN line: SROA has put the string
// constants straight into the call). With -pipeline=fastisel it is the IR as
// lowered, no pass having run (first RUN line, the checks below).
// P04.02: the LLVM IR of the hello subset. It carries the target's triple
// and its pinned data layout (P04.03), line tables (D4.7), the external C
// function as a declaration, and the Go++ function as a definition.
package main

@Extern("C")
func write(fd int32, p *byte, n uint) int

func main() {
	println("hi")
}

// CHECK: target datalayout = "e-m:e-{{.*}}-i64:64-{{.*}}-S128{{.*}}"
// CHECK: target triple = "{{x86_64|aarch64}}-unknown-linux-gnu"
// A string literal is in read-only data, NUL-terminated, never freed.
// CHECK: @.str.0 = private unnamed_addr constant [4 x i8] c"hi\0A\00"
// CHECK: declare i64 @write(i32, ptr, i64)
// Every function Go++ defines has unwind tables (D4.6).
// CHECK: define swiftcc void @_GPF4mainE4main() #[[UW:[0-9]+]] !dbg
// CHECK: store { ptr, i64, i64 } { ptr @.str.0, i64 3, i64 0 }
// CHECK: call i64 @write(i32 1, ptr {{.*}}, i64 {{.*}}) #{{[0-9]+}}, !dbg
// The C entry point returns 0 after main.main.
// CHECK: define i32 @main() #[[UW]] !dbg
// CHECK: call swiftcc void @_GPF4mainE4main()
// CHECK: ret i32
// Unwind tables, and the frame pointer that unoptimized code with DWARF
// keeps for gdb's `step` (debug-info.md section 3).
// CHECK: attributes #[[UW]] = { uwtable "frame-pointer"="all" }
// The other side: without DWARF, or above `opt 0`, no frame pointer.
// NOFP-NOT: "frame-pointer"
// NOFP: attributes #{{[0-9]+}} = { {{.*}}uwtable
// NOFP-NOT: "frame-pointer"
// CHECK: !llvm.dbg.cu
// CHECK: !{i32 {{[0-9]+}}, !"Dwarf Version", i32 5}

// OPT0-NOT: alloca
// OPT0: define swiftcc void @_GPF4mainE4main() #[[UW:[0-9]+]] !dbg
// OPT0-NEXT: entry:
// OPT0-NEXT: call i64 @write(i32 1, ptr nonnull @.str.0, i64 {{[0-9]+}})
// OPT0: ret void
