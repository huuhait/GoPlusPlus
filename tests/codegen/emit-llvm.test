// RUN: %gopp build -emit=llvm %s | FileCheck %s
// P04.02: the LLVM IR of the hello subset. It carries the target's triple
// and its pinned data layout (P04.03), line tables (D4.7), the external C
// function as a declaration, and the Go++ function as a definition.
package main

@Extern("C")
func write(fd int32, p *byte, n uint) int

func main() {
	println("hi")
}

// CHECK: target datalayout = "e-m:e-{{.*}}-i64:64-{{.*}}-S128{{.*}}"
// CHECK: target triple = "{{x86_64|aarch64}}-unknown-linux-gnu"
// A string literal is in read-only data, NUL-terminated, never freed.
// CHECK: @.str.0 = private unnamed_addr constant [4 x i8] c"hi\0A\00"
// CHECK: declare i64 @write(i32, ptr, i64)
// Every function Go++ defines has unwind tables (D4.6).
// CHECK: define void @main.main() #[[UW:[0-9]+]] !dbg
// CHECK: store { ptr, i64, i64 } { ptr @.str.0, i64 3, i64 0 }
// CHECK: call i64 @write(i32 1, ptr {{.*}}, i64 {{.*}}) #{{[0-9]+}}, !dbg
// The C entry point returns 0 after main.main.
// CHECK: define i32 @main() #[[UW]] !dbg
// CHECK: call void @main.main()
// CHECK: ret i32
// CHECK: attributes #[[UW]] = { uwtable }
// CHECK: !llvm.dbg.cu
// CHECK: !{i32 {{[0-9]+}}, !"Dwarf Version", i32 5}
