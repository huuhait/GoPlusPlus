// A function that can fail gives its result and the two words of the
// error back in registers: three in all. A call with `!` in a function
// that can fail is the call, one compare of the first word of the
// error and one branch; only the way of an error tells the runtime
// where the call is.
//
// asm linux/amd64 half: %rax; %rdx; %ecx; ! (%rdi)
// asm linux/amd64 twice: callq *%rax; testq %rdx, %rdx; je; _gopp_err_trace; ! cmpq
// asm windows/amd64 twice: callq *%rax; testq %rdx, %rdx; je; _gopp_err_trace; ! cmpq
// asm linux/arm64 twice: blr x8; cbz x1; _gopp_err_trace
package main

type none struct{}

func (none) Error() string { return "none" }

func half!(x int) int {
	if x < 0 {
		return 0, none{}
	}
	return x / 2
}

func twice!(f func!(int) int, x int) int {
	return f!(x) * 4
}

func main() {}
