package p

func f() {
	while x < 3 {
	}
	while (y) {
	}
	let a = 1
	auto b = 2
}
function g() {}
fn h() {}
def i() {}
struct S {
	a int
}
var after = 1

// Not habits: a function named while, a variable named while.
func while(b bool) {}
func k() {
	while(true)
	while := 1
	_ = while
}
