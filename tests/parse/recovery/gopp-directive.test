// RUN: not %gopp parse %s 2>&1 | FileCheck --match-full-lines --strict-whitespace %s
// Golden output first (generated by tests/update-goldens diag); the source
// follows, so positions below are positions in this file.
// CHECK:{{.*}}gopp-directive.test:23:1: error: '//gopp:cflags' is not allowed in a source file: move it to gopp.mod
// CHECK-NEXT:   23 | //gopp:cflags -O2
// CHECK-NEXT:      | ^~~~~~~~~~~~~~~~~
// CHECK-NEXT:{{.*}}gopp-directive.test:23:1: note: gopp.mod takes the line 'cflags ...'
// CHECK-NEXT:   23 | //gopp:cflags -O2
// CHECK-NEXT:      | ^
// CHECK-NEXT:{{.*}}gopp-directive.test:26:1: error: '//gopp:ldflags' is not allowed in a source file: move it to gopp.mod
// CHECK-NEXT:   26 | //gopp:ldflags -lm
// CHECK-NEXT:      | ^~~~~~~~~~~~~~~~~~
// CHECK-NEXT:{{.*}}gopp-directive.test:26:1: note: gopp.mod takes the line 'ldflags ...'
// CHECK-NEXT:   26 | //gopp:ldflags -lm
// CHECK-NEXT:      | ^
// CHECK-NEXT:{{.*}}gopp-directive.test:27:1: error: '//gopp:cxxstd' is not allowed in a source file: move it to gopp.mod
// CHECK-NEXT:   27 | //gopp:cxxstd c++20
// CHECK-NEXT:      | ^~~~~~~~~~~~~~~~~~~
// CHECK-NEXT:{{.*}}gopp-directive.test:27:1: note: gopp.mod takes the line 'cxxstd ...'
// CHECK-NEXT:   27 | //gopp:cxxstd c++20
// CHECK-NEXT:      | ^
//gopp:build linux
//gopp:cflags -O2
package p

//gopp:ldflags -lm
//gopp:cxxstd c++20
var x = 1
