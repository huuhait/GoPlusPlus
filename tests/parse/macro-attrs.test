package p

@Test
func a() {}

@Inline
@Export("name")
func b() {}

@Derive(Eq, Hash)
type T struct {
	x int @Skip
	y string @Name("why") `json:"y"`
	z int `json:"z"`
	W
}

@Wrapper
var v int

@pkg.Attr(1, "x")
const k = 1
