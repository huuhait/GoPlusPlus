package p

type List[T any] struct{ next *List[T] }
type Pair[K comparable, V any] struct {
	k K
	v V
}
type Num interface{ ~int | ~int64 | float64 }
type P[T interface{ ~int }] []T
type Q[P *T,] int
type A [N]int
type B [N * 2]int
func Map[T, U any](xs []T, f func(T) U) []U { return nil }
func (l *List[T]) Push(x T) {}
var _ = Map[int, string](nil, nil)
var _ = List[int]{}
var _ = Pair[string, List[int]]{}
func f() { _ = g[int] }
