// With several input files every dump starts with `==> path <==` (as tail
// does), in input order, whatever the number of threads; a single file has no
// header, so the golden dumps stay as they are. The files are parsed on a
// thread pool (parseFiles); the diagnostics come out in file order.
// RUN: printf 'package a\nvar e = )\n' > %t.a.gopp
// RUN: printf 'package b\nvar x int\nvar y = (\n' > %t.b.gopp
// RUN: not %gopp parse -j=4 -dump-ast %t.a.gopp %t.b.gopp 2>%t.err4 | FileCheck --check-prefix=AST %s
// RUN: not %gopp parse -j=1 -dump-ast %t.a.gopp %t.b.gopp 2>%t.err1 > /dev/null
// RUN: diff %t.err1 %t.err4
// RUN: FileCheck --check-prefix=ERR --input-file=%t.err4 %s
// RUN: %gopp parse -dump-tokens %t.a.gopp %t.b.gopp | FileCheck --check-prefix=TOK %s
// RUN: not %gopp parse -dump-ast %t.a.gopp | FileCheck --check-prefix=ONE %s
// AST: ==> {{.*}}.a.gopp <==
// AST-NEXT: File <1:1, 3:1>
// AST: Name: Ident <1:9, 1:10> 'a'
// AST: ==> {{.*}}.b.gopp <==
// AST-NEXT: File
// AST: Name: Ident <1:9, 1:10> 'b'
// ERR: .a.gopp:2:9: error: expected operand, found ')'
// ERR: .b.gopp:4:1: error: expected operand, found 'EOF'
// TOK: ==> {{.*}}.a.gopp <==
// TOK-NEXT: 1:1 kw_package 'package'
// TOK: ==> {{.*}}.b.gopp <==
// TOK-NEXT: 1:1 kw_package 'package'
// ONE-NOT: ==>
// ONE: File <1:1, 3:1>
