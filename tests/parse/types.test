package p

type S struct {
	a, b int
	c    *S `json:"c"`
	T
	*U
	pkg.V
	G[int]
}
type I interface {
	M(x int) string
	N()
	fmt.Stringer
	~int | ~string
}
type M map[string][]*int
type C1 chan int
type C2 chan<- int
type C3 <-chan int
type C4 chan (<-chan int)
type Arr [4]int
type Arr2 [...]string
type F func(int, string) (bool, error)
type Pt *struct{ x int }
