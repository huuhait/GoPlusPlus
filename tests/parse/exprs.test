// CHECK-NEXT:            Sel: Ident <258:10, 258:14> 'Type'
// CHECK-NEXT:          Index: Ident <258:15, 258:18> 'int'
package p

var (
	a = 1 + 2*3 - 4/5%6
	b = x<<1 | y&^z ^ w
	c = a && b || !c
	d = a == b && c != d || e < f && g >= h
	e = -x + +y - ^z
	f = *p + &q
	g = <-ch
	h = f(1, 2, xs...)
	i = a.b.c[1][2:3][:4][5:][1:2:3]
	j = x.(T)
	k = x.(type_) 
	l = (a + b) * c
	m = []int{1, 2, 3}
	n = [...]string{0: "a", 2: "c"}
	o = map[string][]int{"a": {1}, "b": nil}
	p = struct{ a int }{1}
	q = &T{a: 1, b: {2}}
	r = func() {}
	s = int(x)
	t = []byte("abc")
	u = (*T)(nil)
	v = f(g(h(1)))
	w = [2][2]int{{1, 2}, {3, 4}}
	z = pkg.Type[int]{}
)
