package p

type Payment struct{ Amount int64 }
type Card extends Payment { Number string }
type Empty extends Payment {}
type Box[T any] extends Payment { V T }
type Gen[T any] extends Box[T] {}
func Feed[T extends Animal, U any](a *T) {}
type Holder[T extends Box[int]] struct{}
type Cl interface{ extends Animal; Clone }
type J interface{ extends() }
type Words struct{ extends int }
var extends = 1
func base(base int) int { return base }
@Abstract
type Shape extends Payment {}
@Virtual
func (p *Payment) Fee() int64 { return 0 }
type extends2 = int
type extends int
var a, base = 1, 2
