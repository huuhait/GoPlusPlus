// The second shard of golden.test: the invariants of `gopp fmt` on the inputs
// and goldens whose place in the sorted list is 1 modulo 2 (and the golden
// comparisons of Inputs/gofmt and Inputs/gopp; golden.test has those of
// Inputs/goprinter: one test took 1.5 s of the 2 s limit).
// RUN: %python %S/check-corpus.py %gopp %S/Inputs --ext .input --ext .golden --min 25 --shard 1/2
// RUN: %python %S/Inputs/check-golden.py %gopp \
// RUN:   %S/Inputs/gofmt/comments.input %S/Inputs/gofmt/comments.golden \
// RUN:   %S/Inputs/gofmt/crlf.input %S/Inputs/gofmt/crlf.golden \
// RUN:   %S/Inputs/gofmt/go2numbers.input %S/Inputs/gofmt/go2numbers.golden \
// RUN:   %S/Inputs/gofmt/import.input %S/Inputs/gofmt/import.golden \
// RUN:   %S/Inputs/gofmt/issue28082.input %S/Inputs/gofmt/issue28082.golden \
// RUN:   %S/Inputs/gofmt/tabs.input %S/Inputs/gofmt/tabs.golden \
// RUN:   %S/Inputs/gofmt/typealias.input %S/Inputs/gofmt/typealias.golden \
// RUN:   %S/Inputs/gofmt/typeparams.input %S/Inputs/gofmt/typeparams.golden \
// RUN:   %S/Inputs/gofmt/typeswitch.input %S/Inputs/gofmt/typeswitch.golden \
// RUN:   %S/Inputs/gopp/comments.input %S/Inputs/gopp/comments.golden \
// RUN:   %S/Inputs/gopp/extends.input %S/Inputs/gopp/extends.golden \
// RUN:   %S/Inputs/gopp/extends.golden %S/Inputs/gopp/extends.golden \
// RUN:   %S/Inputs/gopp/headers.input %S/Inputs/gopp/headers.golden \
// RUN:   %S/Inputs/gopp/macros.input %S/Inputs/gopp/macros.golden \
// RUN:   %S/Inputs/gopp/syntax.input %S/Inputs/gopp/syntax.golden
