// Golden tests of `gopp fmt`.
//
// goprinter/ and gofmt/: the inputs are the test data of Go's go/printer and
// cmd/gofmt (Copyright 2009 The Go Authors, BSD-style license, see NOTICE). The
// goldens are `gopp fmt` output; tests/fmt/compare-gofmt.py lists where it
// differs from gofmt 1.25 (doc comment reformatting, //go:build lines, and
// `switch (x.(type))`, which keeps its parentheses; see README.md).
// gopp/: Go++ syntax (ref, move, !, &, attributes, macros), comments, and the
// header import order.
//
// Regenerate with tests/update-goldens fmt and review the diff.

// RUN: %python %S/Inputs/check-golden.py %gopp \
// RUN:   %S/Inputs/goprinter/alignment.input %S/Inputs/goprinter/alignment.golden \
// RUN:   %S/Inputs/goprinter/comments.input %S/Inputs/goprinter/comments.golden \
// RUN:   %S/Inputs/goprinter/comments2.input %S/Inputs/goprinter/comments2.golden \
// RUN:   %S/Inputs/goprinter/complit.input %S/Inputs/goprinter/complit.golden \
// RUN:   %S/Inputs/goprinter/declarations.input %S/Inputs/goprinter/declarations.golden \
// RUN:   %S/Inputs/goprinter/doc.input %S/Inputs/goprinter/doc.golden \
// RUN:   %S/Inputs/goprinter/empty.input %S/Inputs/goprinter/empty.golden \
// RUN:   %S/Inputs/goprinter/expressions.input %S/Inputs/goprinter/expressions.golden \
// RUN:   %S/Inputs/goprinter/generics.input %S/Inputs/goprinter/generics.golden \
// RUN:   %S/Inputs/goprinter/go2numbers.input %S/Inputs/goprinter/go2numbers.golden \
// RUN:   %S/Inputs/goprinter/gobuild1.input %S/Inputs/goprinter/gobuild1.golden \
// RUN:   %S/Inputs/goprinter/gobuild2.input %S/Inputs/goprinter/gobuild2.golden \
// RUN:   %S/Inputs/goprinter/gobuild3.input %S/Inputs/goprinter/gobuild3.golden \
// RUN:   %S/Inputs/goprinter/gobuild4.input %S/Inputs/goprinter/gobuild4.golden \
// RUN:   %S/Inputs/goprinter/gobuild5.input %S/Inputs/goprinter/gobuild5.golden \
// RUN:   %S/Inputs/goprinter/gobuild6.input %S/Inputs/goprinter/gobuild6.golden \
// RUN:   %S/Inputs/goprinter/gobuild7.input %S/Inputs/goprinter/gobuild7.golden \
// RUN:   %S/Inputs/goprinter/linebreaks.input %S/Inputs/goprinter/linebreaks.golden \
// RUN:   %S/Inputs/goprinter/slow.input %S/Inputs/goprinter/slow.golden \
// RUN:   %S/Inputs/goprinter/statements.input %S/Inputs/goprinter/statements.golden

// Every input and golden (in two shards: this one and golden-2.test, the
// files whose place in the sorted list is 0 and 1 modulo 2): the output parses to the same tree, the comments are
// all there, and formatting twice gives the same text.
// RUN: %python %S/check-corpus.py %gopp %S/Inputs --ext .input --ext .golden --min 25 --shard 0/2
