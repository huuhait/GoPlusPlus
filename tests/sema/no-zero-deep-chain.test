// A chain of 700 named structs ending in a pointer field: the answer "no zero
// value" and its reason are the same at any depth and for any thread count
// (the reason is non-empty, names the first fields and the leaf cause). Good
// side: the same chain ending in an Option field has a zero value.
// RUN: not %gopp check -check-j=1 %s > %t.1 2>&1
// RUN: not %gopp check -check-j=8 %s > %t.8 2>&1
// RUN: diff %t.1 %t.8
// RUN: FileCheck --implicit-check-not=error[E %s < %t.1
package main

