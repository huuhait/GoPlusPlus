// REQUIRES: long
// P03.23 Done-when sizes: forward and backward chains of 200000 named types
// (a copy and a Clone() of the last), the same chain naming each type twice
// and a chain of 50000 generic types; a ring of 30000 types under a slice
// (and the 40- and 5-slice rings); and the invalid rings at 30000 (one error
// each). Each checks without a crash and in near-linear time (`timeout`,
// also in the ASan build).
// RUN: %python %S/Inputs/gen-decl-stress.py chains 200000 > %t.c.gopp
// RUN: timeout 60 %gopp check -check-j=1 --check-error-limit=0 %t.c.gopp
// RUN: %python %S/Inputs/gen-decl-stress.py rings 30000 > %t.r.gopp
// RUN: timeout 30 %gopp check -check-j=1 --check-error-limit=0 %t.r.gopp
// RUN: %python %S/Inputs/gen-decl-stress.py invalid 30000 > %t.i.gopp
// RUN: not timeout 30 %gopp check -check-j=1 --check-error-limit=0 %t.i.gopp > %t.i.out 2>&1
// RUN: FileCheck --implicit-check-not=error %s < %t.i.out
// CHECK-DAG: :30003:6: error[E0139]: invalid recursive type M0
// CHECK-DAG: :3:6: error[E0139]: invalid recursive type L0
// CHECK-DAG: :33004:6: error[E0139]: invalid recursive type G1
// CHECK-DAG: :36003:6: error[E0140]: invalid recursive type: I refers to itself
package main
