// REQUIRES: long
// P03.23 Done-when sizes: forward and backward chains of 200000 named types
// (a copy and a Clone() of the last), the same chain naming each type twice
// and a chain of 50000 generic types; a ring of 30000 types under a slice
// (and the 40- and 5-slice rings); and the invalid rings at 30000 (one error
// each). Each checks without a crash and in near-linear time
// (Inputs/check-linear.py: N/16 and N, N at most 48 times the CPU time; a
// quadratic check takes 256 times, also in the ASan build).
// RUN: %python %S/Inputs/check-linear.py --label decl-chains --out %t.c.lin1 --n 200000 --gen "%S/Inputs/gen-decl-stress.py chains {n}" -- %gopp check -check-j=1 --check-error-limit=0 {file}
// RUN: %python %S/Inputs/check-linear.py --label decl-chains-2 --out %t.r.lin2 --n 30000 --gen "%S/Inputs/gen-decl-stress.py rings {n}" -- %gopp check -check-j=1 --check-error-limit=0 {file}
// RUN: %python %S/Inputs/check-linear.py --label decl-chains-3 --out %t.i.lin3 --n 30000 --gen "%S/Inputs/gen-decl-stress.py invalid {n}" --status 1 --output %t.i.out -- %gopp check -check-j=1 --check-error-limit=0 {file}
// RUN: FileCheck --implicit-check-not=error %s < %t.i.out
// CHECK-DAG: :30003:6: error[E0139]: invalid recursive type M0
// CHECK-DAG: :3:6: error[E0139]: invalid recursive type L0
// CHECK-DAG: :33004:6: error[E0139]: invalid recursive type G1
// CHECK-DAG: :36003:6: error[E0140]: invalid recursive type: I refers to itself
package main
