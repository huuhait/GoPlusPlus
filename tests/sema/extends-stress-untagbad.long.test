// REQUIRES: long
// P03.22 review (R1): the implicit "must be untagged" requirement travels
// through a chain of 200000 generics in near-linear time (`untagbad`).
// RUN: %python %S/Inputs/check-linear.py --label extends-stress-untagbad --out %t.lin1 --n 200000 --gen "%S/Inputs/gen-extends-stress.py untagbad {n}" --status 1 --output %t.lin1.out -- %gopp check -check-j=1 {file}
// RUN: cat %t.lin1.out | FileCheck %s
// CHECK: error[E{{[0-9]+}}]: A does not satisfy the implicit requirement of U: the generic code passes U on to a generic
// CHECK-NOT: error
package main
