// REQUIRES: long
// P03.22 review (R1): the implicit "must be untagged" requirement travels
// through a chain of 200000 generics in near-linear time (`untagbad`).
// RUN: %python %S/Inputs/gen-extends-stress.py untagbad 200000 > %t.gopp
// RUN: not timeout 60 %gopp check -check-j=1 %t.gopp 2>&1 | FileCheck %s
// CHECK: error[E{{[0-9]+}}]: A does not satisfy the implicit requirement of U: the generic code passes U on to a generic
// CHECK-NOT: error
package main
