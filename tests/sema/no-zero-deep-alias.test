// A type nested deeper than the zero-value query's depth limit (built with
// aliases, so the parser nesting limit does not apply) is never answered "has a
// zero value" from the cut: x holds a nil *int, so it is E0333 with a reason,
// the same for 1 and 8 threads. Good side: a shallow alias chain of the same
// shape with an Option leaf is fine.
// RUN: not %gopp check -check-j=1 %s > %t.1 2>&1
// RUN: not %gopp check -check-j=8 %s > %t.8 2>&1
// RUN: diff %t.1 %t.8
// RUN: FileCheck --implicit-check-not=error[E %s < %t.1
package main

