// RUN: %python %S/Inputs/gen-extends-stress.py undef 2000 > %t.undef.gopp
// RUN: not timeout 10 %gopp check -check-j=1 --check-error-limit=0 %t.undef.gopp 2>&1 | FileCheck --check-prefix=UNDEF %s
