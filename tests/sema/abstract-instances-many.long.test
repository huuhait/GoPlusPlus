// REQUIRES: long
// P03.26 (R11): n methods x n abstract instances at n = 1000, 2000 and 4000
// (0.03, 0.04 and 0.07 s; 2.5 s and 2.7 GB before at 4000). Checked at 2000
// and 32000 (Inputs/check-linear.py: at most 48 times the CPU time; a
// quadratic walk takes 256 times).
// RUN: %python %S/Inputs/check-linear.py --label abstract-instances-many --out %t.ptr --n 32000 --gen "%S/Inputs/gen-abstract-instances.py {n} ptr" -- %gopp check {file}
// RUN: %python %S/Inputs/check-linear.py --label abstract-instances-many-value --out %t.value --n 32000 --gen "%S/Inputs/gen-abstract-instances.py {n} value" --status 1 --output %t.value.out -- %gopp check --check-error-limit=0 {file}
// RUN: cat %t.value.out | grep -c 'error\[E0389\]' | FileCheck %s
// CHECK: 64000
