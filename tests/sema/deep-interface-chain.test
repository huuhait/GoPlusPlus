// R8: a valid chain of 80 generic interfaces, each embedding the one before,
// checks clean: the type set of an instance is not cut at a depth that
// depends on which body asked first. Both sides: a method that is not in the
// chain is still an error.
// RUN: %gopp check -check-j=1 %s 2>&1 | FileCheck --check-prefix=OK --allow-empty %s
// RUN: %gopp check -check-j=8 %s 2>&1 | FileCheck --check-prefix=OK --allow-empty %s
// RUN: not %gopp check %S/Inputs/deep-chain-bad.gopp 2>&1 | FileCheck --check-prefix=BAD %s
// OK-NOT: error
// BAD: error{{.*}}: x.Nope undefined
