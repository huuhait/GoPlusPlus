// CHECK: error[E0139]: invalid recursive type N3
package main

type N0[P, Q any] struct{ f0 N3[[]int,N3[*Q,N0[int,int]]] }
type N1[P any] struct{ f0 P }
type N2 struct{ f0 N0[N1[int],N1[int]] }
type N3[P, Q any] struct{ f0 N1[N1[N3[P,Q]]]; f1 int }

func main() {}

func use0(a N0[int,int]) {
	c := a.Clone()
	_ = c
	var z N0[int,int]
	_ = z
}

func use1(a N2) {
	c := a.Clone()
	_ = c
	var z N2
	_ = z
}

func use2(a N3[int,int]) {
	c := a.Clone()
	_ = c
	var z N3[int,int]
	_ = z
}
