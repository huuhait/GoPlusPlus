// P03.26 (R8): a method signature that names a bigger instance of its own
// type is legal (types2 go.dev/issue/48703); with an abstract instance in the
// package the check of the method signatures must still end (the walk
// instantiated the method of each instance, `Pair[Pair[T]]`, `Pair[Pair[Pair[T]]]`,
// forever; it hung). The other side: a by-value use of the abstract type in
// such a type is still an error.
// RUN: timeout 10 %gopp check %S/Inputs/grow-method.gopp
// RUN: not timeout 10 %gopp check %s 2>&1 | FileCheck %s
package main

type Shape struct{ N int }

@Abstract
func (s *Shape) Area() int

type Pair[T any] struct{ n int }

func (p Pair[T]) Nest() Pair[Pair[T]] { panic(0) }
func (p Pair[T]) Items() []T          { panic(0) }

// CHECK: error[E0389]: cannot use the abstract type Shape for a type argument of Pair[Shape], which holds it by value
func f(p *Pair[Shape]) {}

func main() {}
