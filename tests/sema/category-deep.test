type P18 struct{ in P17 }
type P19 struct{ in P18 }
type P20 struct{ in P19 }
type P21 struct{ in P20 }
type P22 struct{ in P21 }
type P23 struct{ in P22 }
type P24 struct{ in P23 }
type P25 struct{ in P24 }
type P26 struct{ in P25 }
type P27 struct{ in P26 }
type P28 struct{ in P27 }
type P29 struct{ in P28 }
type P30 struct{ in P29 }

type R struct {
	p *int
	s S30
}

type RP struct {
	p *int
	q P30
}

// CHECK: [[@LINE+1]]:{{[0-9]+}}: error[E0323]: S5 does not satisfy Copy
type UseS5 struct{ c NeedC[S5] }

// CHECK: [[@LINE+1]]:{{[0-9]+}}: error[E0323]: S30 does not satisfy Copy
type UseS30 struct{ c NeedC[S30] }

type UseP30 struct{ c NeedC[P30] }

type Box[T any] struct{ v T }
type Two[A any, B any] struct {
	a A
	b []int
	c Box[B]
}
type Pair[A any, B any] struct {
	a A
	b Box[B]
}
type G0[T any] struct{ V T }
type G1[T any] struct{ P G0[T] }
type G2[T any] struct{ P G1[T] }
type G3[T any] struct{ P G2[T] }
type G4[T any] struct{ P G3[T] }
type G5[T any] struct{ P G4[T] }
type G6[T any] struct{ P G5[T] }
