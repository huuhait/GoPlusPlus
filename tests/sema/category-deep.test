type G29[T any] struct{ P G28[T] }
type G30[T any] struct{ P G29[T] }
type Mu struct{ b bool }

func (m *Mu) drop() {}

type G0Use struct{ c NeedC[Box[int]] }

// CHECK: [[@LINE+1]]:{{[0-9]+}}: error[E0323]: Box[string] does not satisfy Copy
type G1Use struct{ c NeedC[Box[string]] }

type G2Use struct{ c NeedC[Box[Box[int]]] }

// CHECK: [[@LINE+1]]:{{[0-9]+}}: error[E0323]: Box[Box[string]] does not satisfy Copy
type G3Use struct{ c NeedC[Box[Box[string]]] }

// CHECK: [[@LINE+1]]:{{[0-9]+}}: error[E0323]: Two[int, int] does not satisfy Copy
type G4Use struct{ c NeedC[Two[int, int]] }

type G5Use struct{ c NeedC[Pair[int, int]] }

// CHECK: [[@LINE+1]]:{{[0-9]+}}: error[E0323]: Pair[int, string] does not satisfy Copy
type G6Use struct{ c NeedC[Pair[int, string]] }

// CHECK: [[@LINE+1]]:{{[0-9]+}}: error[E0323]: Pair[string, int] does not satisfy Copy
type G7Use struct{ c NeedC[Pair[string, int]] }

type G8Use struct{ c NeedC[G30[int]] }

// CHECK: [[@LINE+1]]:{{[0-9]+}}: error[E0323]: G30[string] does not satisfy Copy
type G9Use struct{ c NeedC[G30[string]] }

// CHECK: [[@LINE+1]]:{{[0-9]+}}: error[E0323]: G30[Box[Mu]] does not satisfy Copy
type G10Use struct{ c NeedC[G30[Box[Mu]]] }

type G11Use struct{ c NeedC[G30[*Mu]] }

// CHECK: [[@LINE+1]]:{{[0-9]+}}: error[E0323]: Box{{\[\[}}3]Pair[int, Box[string]]] does not satisfy Copy
type G12Use struct{ c NeedC[Box[[3]Pair[int, Box[string]]]] }

type G13Use struct{ c NeedC[Option[Box[int]]] }

// CHECK: [[@LINE+1]]:{{[0-9]+}}: error[E0323]: Option[G30[string]] does not satisfy Copy
type G14Use struct{ c NeedC[Option[G30[string]]] }

func copyS5(s S5) S5 {
	// CHECK: [[@LINE+1]]:{{[0-9]+}}: error[E0253]: cannot initialize from s: it is a borrowed parameter, and this needs ownership (OWN-R3a)
	t := s
	return t
}

func copyS30(s S30) S30 {
	// CHECK: [[@LINE+1]]:{{[0-9]+}}: error[E0253]: cannot initialize from s: it is a borrowed parameter, and this needs ownership (OWN-R3a)
	t := s
	return t
}

func copyP30(p P30) P30 {
	t := p
	return t
}

func cloneR(r R) {
	// CHECK: [[@LINE+1]]:{{[0-9]+}}: error[E0267]: cannot clone r: R can't be cloned: R mixes owning fields with the raw pointer field p: write Clone() by hand (OWN-R6)
	_ = r.Clone()
}

func cloneRP(r RP) { _ = r.Clone() }

func copyG[T any](g G30[T]) G30[T] {
	// CHECK: [[@LINE+1]]:{{[0-9]+}}: error[E0253]: cannot initialize from g: it is a borrowed parameter, and this needs ownership (OWN-R3a)
	h := g
	return h
}

func copyGCopy[T Copy](g G30[T]) G30[T] {
	h := g
	return h
}

func main() {}
