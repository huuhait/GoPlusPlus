// RUN: not %gopp check --check-error-limit=0 %s 2>&1 | FileCheck "--implicit-check-not=error[E" %s
// P03.21 (d), OWN-V2, OWN-R3b item 6, PAR-9: slicing a slice or array that
// may be written gives a borrowed []T. Its elements can be written; it cannot
// grow or be moved, cannot outlive its owner (a field, a send, a global, the
// return of a local's part), and a function cannot return it as a []T. A
// borrowed []T is not a View: a View never becomes one (that would make the
// view writable), while a borrowed []T reads as a View of itself.
package main

type H struct{ s []int }

var global []int

func sortInts(xs []int) {}

func accepted(nums []int, dst []int) View[[]int] {
	nums[1:3][0] = 9
	t := nums[1:3]
	t[0] = 9
	sortInts(nums[1:3])
	copy(dst[2:], nums)
	var arr [4]int
	a := arr[1:]
	a[0] = 1
	var v View[[]int] = t
	_ = v
	return nums[1:]
}

func viewIntoBorrowed(v View[[]int], nums []int) {
	t := nums[1:3]
	// CHECK: [[@LINE+1]]:6: error{{\[E0314\]}}: cannot use v (variable of type View{{\[}}[]int]) as borrowed []int value in assignment
	t = v
	t[0] = 1
}

func grow(nums []int) {
	t := nums[1:3]
	// CHECK: [[@LINE+1]]:13: error{{\[E0290\]}}: cannot append to t: a view has a fixed length; copy it into an owned slice first (OWN-V1)
	t = append(t, 1)
	// CHECK: [[@LINE+1]]:12: error{{\[E0264\]}}: cannot move t: it is a borrowed variable (OWN-R3b)
	u := move(t)
	_ = u
}

func outlive(nums []int, h *H, ch chan []int) {
	// CHECK: [[@LINE+1]]:8: error{{\[E0314\]}}: cannot use nums[1:3] (value of type borrowed []int) as []int value in assignment: a borrowed slice is not an owning value
	h.s = nums[1:3]
	// CHECK: [[@LINE+1]]:8: error{{\[E0314\]}}: cannot use nums[1:3] (value of type borrowed []int) as []int value in send: a borrowed slice is not an owning value
	ch <- nums[1:3]
	// CHECK: [[@LINE+1]]:11: error{{\[E0314\]}}: cannot use nums[1:3] (value of type borrowed []int) as []int value in assignment: a borrowed slice is not an owning value
	global = nums[1:3]
}

// PAR-9: the result must be View[[]int] to return a part without a copy.
// CHECK: [[@LINE+1]]:48: error{{\[E0314\]}}: cannot use xs[1:3] (value of type borrowed []int) as []int value in return statement: a borrowed slice is not an owning value
func writableSubslice(xs []int) []int { return xs[1:3] }

func localPart() []int {
	local := []int{1, 2, 3}
	t := local[1:]
	// CHECK: [[@LINE+1]]:9: error{{\[E0314\]}}: cannot use t (variable of type borrowed []int) as []int value in return statement: a borrowed slice is not an owning value
	return t
}

// P03.21 review (R8): every owning destination takes the same check, so a
// borrowed slice never becomes an owned element: not by append (a value, a
// local holding one, a borrowed parameter's part), a slice, map or struct
// literal, an element store; and the elements of a borrowed slice are the
// owner's, so a spread or a copy of owning elements needs a clone.
func ownedElements(xs []int, out *[][]int, ss []string) ([][]int, []string) {
	var o [][]int
	loc := []int{1}
	// CHECK: [[@LINE+1]]:16: error{{\[E0314\]}}: cannot use loc[0:1] (value of type borrowed []int) as []int value in argument to append: a borrowed slice is not an owning value
	o = append(o, loc[0:1])
	s := loc[0:1]
	// CHECK: [[@LINE+1]]:16: error{{\[E0314\]}}: cannot use s (variable of type borrowed []int) as []int value in argument to append: a borrowed slice is not an owning value
	o = append(o, s)
	// CHECK: [[@LINE+1]]:22: error{{\[E0314\]}}: cannot use xs[1:] (value of type borrowed []int) as []int value in argument to append: a borrowed slice is not an owning value
	*out = append(*out, xs[1:])
	// CHECK: [[@LINE+1]]:17: error{{\[E0314\]}}: cannot use loc[0:1] (value of type borrowed []int) as []int value in array or slice literal: a borrowed slice is not an owning value
	lit := [][]int{loc[0:1]}
	// CHECK: [[@LINE+1]]:29: error{{\[E0314\]}}: cannot use loc[0:1] (value of type borrowed []int) as []int value in map literal: a borrowed slice is not an owning value
	m := map[string][]int{"a": loc[0:1]}
	// CHECK: [[@LINE+1]]:9: error{{\[E0314\]}}: cannot use loc[0:1] (value of type borrowed []int) as []int value in assignment: a borrowed slice is not an owning value
	o[0] = loc[0:1]
	var strs []string
	sl := []string{"a"}
	// CHECK: [[@LINE+1]]:22: error{{\[E0291\]}}: append(a, b...) with non-trivial elements needs move(b) or b.Clone() on the source (OWN-R4)
	strs = append(strs, sl[0:1]...)
	// CHECK: [[@LINE+1]]:22: error{{\[E0291\]}}: append(a, b...) with non-trivial elements needs move(b) or b.Clone() on the source (OWN-R4)
	strs = append(strs, ss[1:]...)
	dst := make([]string, 1)
	// CHECK: [[@LINE+1]]:12: error{{\[E0292\]}}: copy(dst, src) with non-trivial elements needs src.Clone() (OWN-R4)
	copy(dst, sl[0:1])
	_, _ = lit, m
	return o, strs
}

// The other side: a copy of the borrowed slice is owned, Copy elements are
// copied out, and a borrowed slice still reaches a borrowed parameter.
func ownedElementsOk(xs []int, ss []string) ([][]int, []string, []int) {
	var o [][]int
	loc := []int{1}
	o = append(o, []int(loc[0:1]), loc[0:1].Clone())
	lit := [][]int{[]int(xs[1:])}
	var ints []int
	ints = append(ints, loc[0:1]...)
	ints = append(ints, xs[1:]...)
	copy(ints, xs[1:])
	var strs []string
	strs = append(strs, ss[1:].Clone()...)
	sortInts(loc[0:1])
	_ = lit
	return o, strs, ints
}

func main() {}
