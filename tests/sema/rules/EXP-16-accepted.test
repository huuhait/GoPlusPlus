// RUN: %gopp check %s
// RUN: %gopp fmt %s | diff - %s
// Rules EXP-16 to EXP-28, CON-22 (P03.24, ADR-0024), the accepted side: every
// binary and unary operator, `!=` and the four orderings from `==` and
// `<=>`, `@Right` in both orders, lazy and eager `&&`/`||`, `[]` and `[]=`
// with one and two indexes and `a[i, j] += v`, `()` with two overloads,
// `defer`/`go` of a call, `float64(b)` through `@Convert`, `m += n` through
// an in-place `+=` and through `m = m + n`, `++`/`--`, send and receive, the
// built-in `<=>`, every binary operator with another right-hand type, and a
// plain `/` next to a @Right one of the same parameter type. The file has no
// error line; it is also `gopp fmt` stable.
package main

type Vec2 struct{ X, Y float64 }

func (a Vec2) + (b Vec2) Vec2  { return Vec2{a.X + b.X, a.Y + b.Y} }
func (a Vec2) - (b Vec2) Vec2  { return Vec2{a.X - b.X, a.Y - b.Y} }
func (a Vec2) * (b Vec2) Vec2  { return Vec2{a.X * b.X, a.Y * b.Y} }
func (a Vec2) / (b Vec2) Vec2  { return Vec2{a.X / b.X, a.Y / b.Y} }
func (a Vec2) % (b Vec2) Vec2  { return a }
func (a Vec2) & (b Vec2) Vec2  { return a }
func (a Vec2) | (b Vec2) Vec2  { return a }
func (a Vec2) ^ (b Vec2) Vec2  { return a }
func (a Vec2) << (n uint) Vec2 { return a }
func (a Vec2) >> (n uint) Vec2 { return a }
func (a Vec2) &^ (b Vec2) Vec2 { return a }
func (a Vec2) - () Vec2        { return Vec2{-a.X, -a.Y} }
func (a Vec2) + () Vec2        { return a }
func (a Vec2) ^ () Vec2        { return a }
func (a Vec2) ! () bool        { return a.X == 0 }
func (a Vec2) == (b Vec2) bool { return a.X == b.X && a.Y == b.Y }
func (a Vec2) <=> (b Vec2) int { return 0 }
@Right
func (a Vec2) * (s float64) Vec2 { return Vec2{a.X * s, a.Y * s} }
@Right
func (a Vec2) / (s float64) Vec2 { return Vec2{s / a.X, s / a.Y} }
func (a Vec2) / (s int) Vec2     { return a }
func (a Vec2) * (s int) Vec2     { return a }

func arith(a, b Vec2, s float64) {
	_ = a + b
	_ = a - b
	_ = a * b
	_ = a / b
	_ = a % b
	_ = a & b
	_ = a | b
	_ = a ^ b
	_ = a << 2
	_ = a >> 2
	_ = a &^ b
	_ = -a
	_ = +a
	_ = ^a
	_ = !a
	_ = a == b
	_ = a != b
	_ = a < b
	_ = a <= b
	_ = a > b
	_ = a >= b
	_ = a <=> b
	_ = a * s
	_ = s * a
	_ = s / a
	_ = a / 2
	_ = a * 2.5
	_ = -a*2.0 + b
	_ = a <=> b == 0
	_ = a + b*a
}

// Every binary operator with a right-hand type that differs from the
// receiver, and `/` written twice for one parameter type: plain (`v / 1.0`)
// and @Right for the swapped order (`1.0 / v`).
type W struct{ n int }

func (a W) + (k int) W     { return a }
func (a W) - (k int) W     { return a }
func (a W) * (k int) W     { return a }
func (a W) / (k int) W     { return a }
func (a W) % (k int) W     { return a }
func (a W) & (k int) W     { return a }
func (a W) | (k int) W     { return a }
func (a W) ^ (k int) W     { return a }
func (a W) << (k int) W    { return a }
func (a W) >> (k int) W    { return a }
func (a W) &^ (k int) W    { return a }
func (a W) / (f float64) W { return a }
@Right
func (a W) / (f float64) W { return a }

func rhs(a W, k int) {
	_ = a + k
	_ = a - k
	_ = a * k
	_ = a / k
	_ = a % k
	_ = a & k
	_ = a | k
	_ = a ^ k
	_ = a << k
	_ = a >> k
	_ = a &^ k
	_ = a / 1.0
	_ = 1.0 / a
}

type Lazy struct{ on bool }

func (a Lazy) && (b Lazy) Lazy        { return a }
func (a Lazy) || (b func() Lazy) Lazy { return a }
func (a Lazy) && (b func() Lazy) Lazy { return a }

func lazy(a, b Lazy) {
	_ = a && b
	_ = a || b
	_ = a && b && a
}

type Grid struct {
	w, h  int
	cells []int
}

func (g Grid) [] (i int) int         { return g.cells[i] }
func (g Grid) [] (i, j int) int      { return g.cells[i*g.w+j] }
func (g *Grid) []= (i int, v int)    { g.cells[i] = v }
func (g *Grid) []= (i, j int, v int) { g.cells[i*g.w+j] = v }

func grid() {
	var g Grid
	_ = g[1]
	_ = g[1, 2]
	g[1] = 3
	g[1, 2] = 4
	g[1, 2] += 5
	g[0] -= 1
}

type Fn struct{ k int }

func (f Fn) () (x int) int       { return x + f.k }
func (f Fn) () (s string) string { return s + "!" }

func fn() {
	var f Fn
	_ = f(1)
	_ = f("a")
	defer f(2)
	go f(3)
	f(4)
}

type Q struct{ items []int }

func (q *Q) <- (v int)        { q.items = append(q.items, v) }
func (q *Q) <- () (int, bool) { return 0, false }

type BigInt struct{ n int }

@Convert
func (b BigInt) Float64() float64 { return float64(b.n) }
@Convert
func (b BigInt) Int64() int64 { return int64(b.n) }

func conv(b BigInt) {
	_ = float64(b)
	_ = int64(b)
	_ = b.Float64()
}

type Mat struct{ d []float64 }

func (m Mat) + (n Mat) Mat { return Mat{} }
func (m *Mat) += (n Mat)   {}

func inplace() {
	var m, n Mat
	m += n
	m = m + n
}

type Counter struct{ n int }

func (c *Counter) ++ () { c.n++ }
func (c *Counter) -- () { c.n-- }

func cnt() {
	var c Counter
	c++
	c--
}

func builtin() {
	_ = 3 <=> 4
	_ = "a" <=> "b"
	nan := 0.0
	nan = nan / nan
	_ = nan <=> 1.0
	_ = nan <=> nan
}

func main() {}

func queue() {
	var q Q
	q <- 3
	v := <-q
	w, ok := <-q
	_, _, _ = v, w, ok
}

type Va struct{ k int }

func (f Va) () (xs ...int) int { return len(xs) }

type Pr struct{ k int }

func (g Pr) () (a, b int) int { return a + b }

func two() (int, int) { return 1, 2 }

func spread() {
	var f Va
	xs := []int{1, 2}
	_ = f(1, 2, 3)
	_ = f()
	_ = f(xs...)
	var g Pr
	_ = g(two())
}
