// RUN: not %gopp check %s 2>&1 | FileCheck --implicit-check-not=error: %s
// Rule OWN-P1: *T is a raw pointer: &x of an addressable operand, trivial,
// copied freely, never frees anything.
package main

type Node struct{ Name string }

func val() int { return 1 }

func positive(n *Node) *Node {
	x := 1
	p := &x
	q := p
	_ = q
	m := n
	return m
}

func negative() {
	// CHECK: [[@LINE+1]]:8: error: invalid operation: cannot take address of val() (value of type int)
	p := &val()
	_ = p
}
