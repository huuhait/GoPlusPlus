// RUN: %gopp check %s
// Rule TYP-9, P03.19 scope: only DIRECT writes into the box of an interface
// value are errors (rooted at a type switch, assertion or Option Get binding,
// or an assertion; TYP-9-box.test). Every write below goes through a variable
// or a call result that stands for a part of the box, or lets such a
// reference escape; all of them are ACCEPTED until P03.21: box bindings
// become views (ADR-0020), read-only all the way down by their type, which
// closes every one of these in one place. Each case is a Done-when case of
// P03.21 (it must be an error there).
package main

type Doc struct{ Tags []int }

func (d Doc) TagsRef() ref []int { return d.Tags }

func (d Doc) First() *int { return &d.Tags[0] }

func head(s ref []int) ref []int { return s[:1] }

func two(s ref []int) (ref []int, int) { return s, 1 }

func ptr(s ref []int) *int { return &s[0] }

// P03.21: box bindings become views. A ref made from a part, a range
// variable over a part.
func viewsLaterVariables(x any) {
	switch b := x.(type) {
	case []int:
		var r ref []int = b[0:1]
		r[0] = 1
		s := b[1:]
		s[0] = 1
	case [][]int:
		for _, row := range b {
			row[0] = 1
		}
	}
}

// P03.21: box bindings become views. A ref, pointer, tuple or func value a
// call returns from a part (r5, r5b).
func viewsLaterCallResults(x any) {
	switch v := x.(type) {
	case []int:
		r := head(v)
		r[0] = 1
		head(v)[0] = 2
		r2, _ := two(v)
		r2[0] = 3
		g := func() ref []int { return v }
		g()[0] = 4
		*ptr(v) = 5
		p := ptr(v)
		*p = 6
	case Doc:
		m := v.TagsRef
		m()[0] = 7
		*v.First() = 8
	}
	head(x.([]int))[0] = 9
}

// P03.21: box bindings become views. An alias bound to a part later in the
// body: a closure made earlier, a loop's next pass, a func value bound again
// (r5c).
func viewsLaterOrder(x any, w []int, d Doc) {
	switch v := x.(type) {
	case []int:
		var r ref []int = w
		g := func() ref []int { return r }
		r = head(v)
		g()[0] = 1
		c := head(w)
		for i := 0; i < 2; i++ {
			c[0] = 2
			c = v
		}
	case Doc:
		h := d.TagsRef
		k := func() ref []int { return h() }
		h = v.TagsRef
		k()[0] = 3
	}
}

// P03.21: box bindings become views. A reference that escapes: returned,
// stored in a struct, sent (r8).
@Ref
type Holder struct{ r ref []int }

func get(x any) ref []int { return x.([]int) }

func viewsLaterEscapes(x any, hs *Holder, ch chan ref []int) {
	get(x)[0] = 1
	switch v := x.(type) {
	case []int:
		hd := Holder{r: head(v)}
		hd.r[0] = 2
		hs.r = v
		ch <- v
	}
}

// P03.21: box bindings become views. A pointer or ref carried out in a
// struct, slice or channel a helper returns (r8b).
type PtrHolder struct{ p *int }

func mkp(s ref []int) PtrHolder { return PtrHolder{p: &s[0]} }

func ptrs(s ref []int) []*int { return []*int{&s[0]} }

func mkch(s ref []int) chan ref []int {
	c := make(chan ref []int, 1)
	c <- s
	return c
}

func viewsLaterHolders(x any) {
	switch v := x.(type) {
	case []int:
		h := mkp(v)
		*h.p = 1
		*ptrs(v)[0] = 2
		if r, ok := <-mkch(v); ok {
			r[0] = 3
		}
	}
}

// P03.21: box bindings become views. The `=` form of a range clause (r14).
func views(s ref []int) []ref []int { return []ref []int{s} }

func viewsLaterRangeAssign(x any, hs *Holder) {
	switch v := x.(type) {
	case []int:
		var r ref []int
		for _, r = range views(v) {
			r[0] = 1
		}
		for _, hs.r = range views(v) {
		}
	}
}

// P03.21: box bindings become views. A pointee reached through a field of a
// boxed value is read through a view, so it becomes read-only; a pointer the
// box holds itself (`case *Doc:`) stays writable (TYP-9-box.test).
type PtrField struct{ P *int }

func viewsLaterPointee(x any) {
	switch h := x.(type) {
	case PtrField:
		*h.P = 1
	}
}

func main() {}
