// RUN: not %gopp check --check-error-limit=0 %s 2>&1 | FileCheck "--implicit-check-not=error[E" %s
// Rule OWN-V6: a view into a temporary lives until the end of the full
// statement (or the whole for/if/switch for its header). A `:=` or `var`
// declaration keeps the temporary in a hidden local until the end of the
// enclosing block (lifetime extension), and a local of that block or an
// inner one may take the view; storing it in a longer-lived place (an outer
// variable, a field, a global, a slice or channel, a return) is an error.
package main

func load() string  { return "hello" }
func items() []int { return nil }
func use(s View[string]) {}

@View
type Token struct {
	Text View[string]
}

var global View[string]

// CHECK: [[@LINE+1]]:10: error{{\[E[0-9]+\]}}: cannot store load()[:2] in a longer-lived place: it is a view into a temporary that is freed at the end of the statement (OWN-V6)
var gw = load()[:2]

func positive() int {
	n := len(load()[1:3])
	for _, c := range load()[:3] {
		n += int(c)
	}
	h := load()[:3]
	var w = load()[0:3]
	var v View[string] = load()
	is := items()[1:]
	u := h[1:]
	var same View[string]
	same = w
	{
		var inner View[string]
		inner = v
		use(inner)
	}
	use(u)
	use(same)
	return n + len(h) + len(w) + len(is)
}

func negative(tok *Token, ch chan View[string]) View[string] {
	var vs []View[string]
	// A three-clause for init is not extended (STM-4).
	// CHECK: [[@LINE+1]]:11: error{{\[E[0-9]+\]}}: cannot store load()[:1] in a longer-lived place{{.*}}(OWN-V6)
	for k := load()[:1]; len(k) > 0; k = k[1:] {
		use(k)
	}
	var r View[[]int]
	// CHECK: [[@LINE+1]]:6: error{{\[E[0-9]+\]}}: cannot store items()[1:] in a longer-lived place: it is a view into a temporary that is freed at the end of the statement (OWN-V6)
	r = items()[1:]
	_ = r
	var outer View[string]
	{
		w := load()[0:3]
		u := w[1:]
		// CHECK: [[@LINE+1]]:11: error{{\[E[0-9]+\]}}: cannot store w in a longer-lived place{{.*}}(OWN-V6)
		outer = w
		// CHECK: [[@LINE+1]]:14: error{{\[E[0-9]+\]}}: cannot store u in a longer-lived place{{.*}}(OWN-V6)
		tok.Text = u
		// CHECK: [[@LINE+1]]:12: error{{\[E[0-9]+\]}}: cannot store w in a longer-lived place{{.*}}(OWN-V6)
		global = w
		// CHECK: [[@LINE+1]]:9: error{{\[E[0-9]+\]}}: cannot store w in a longer-lived place{{.*}}(OWN-V6)
		ch <- w
		// CHECK: [[@LINE+1]]:19: error{{\[E[0-9]+\]}}: cannot store w in a longer-lived place{{.*}}(OWN-V6)
		vs = append(vs, w)
		// CHECK: [[@LINE+1]]:14: error{{\[E[0-9]+\]}}: cannot store load()[0:3] in a longer-lived place{{.*}}(OWN-V6)
		tok.Text = load()[0:3]
		// CHECK: [[@LINE+1]]:10: error{{\[E[0-9]+\]}}: cannot return a view into a temporary: it is freed at the return (OWN-V7)
		return u
	}
	_ = vs
	return outer
}

// P03.21 review (R7): a view into a temporary made in an if, switch or
// range header lives to the end of that statement, so it is kept as a local
// of an inner block is: a variable of the statement may take it, an outer
// variable or a return may not.
func names() []string { return nil }

func headerNegative() View[string] {
	var o View[string]
	if w := load()[1:]; len(w) > 0 {
		// CHECK: [[@LINE+1]]:7: error{{\[E[0-9]+\]}}: cannot store w in a longer-lived place{{.*}}(OWN-V6)
		o = w
		// CHECK: [[@LINE+1]]:10: error{{\[E[0-9]+\]}}: cannot return a view into a temporary: it is freed at the return (OWN-V7)
		return w
	}
	switch w := load()[1:]; len(w) {
	case 0:
		u := w[1:]
		// CHECK: [[@LINE+1]]:7: error{{\[E[0-9]+\]}}: cannot store u in a longer-lived place{{.*}}(OWN-V6)
		o = u
		// CHECK: [[@LINE+1]]:10: error{{\[E[0-9]+\]}}: cannot return a view into a temporary: it is freed at the return (OWN-V7)
		return w
	}
	for _, w := range names() {
		// CHECK: [[@LINE+1]]:7: error{{\[E[0-9]+\]}}: cannot store w in a longer-lived place{{.*}}(OWN-V6)
		o = w
	}
	for _, w := range names()[1:] {
		// CHECK: [[@LINE+1]]:7: error{{\[E[0-9]+\]}}: cannot store w in a longer-lived place{{.*}}(OWN-V6)
		o = w
	}
	// CHECK: [[@LINE+1]]:9: error{{\[E[0-9]+\]}}: cannot store an element of names() in o: it is a view into a temporary{{.*}}(OWN-V6)
	for _, o = range names() {
	}
	return o
}

func headerPositive(ss []string) int {
	n := 0
	if w := load()[1:]; len(w) > 0 {
		x := w
		var y View[string]
		y = w[1:]
		use(x)
		use(y)
		n += len(w)
	} else {
		use(w)
	}
	switch w := load()[1:]; len(w) {
	case 0:
		use(w)
	}
	for _, w := range names() {
		var in View[string]
		in = w
		use(in)
		n += len(w)
	}
	// Not a temporary: the elements outlive the loop.
	var o View[string]
	for _, w := range ss {
		o = w
	}
	for i := range names() {
		n += i
	}
	use(o)
	return n
}

func main() {}
