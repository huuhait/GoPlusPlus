// RUN: not %gopp check %s 2>&1 | FileCheck --implicit-check-not=error: %s
// Rule CLO-9: inside a closure a captured owned variable is another place:
// using it is fine, taking ownership needs x.Clone() or move(x).
package main

func positive() (func() string, func() int, func() string) {
	s := "a"
	t := "b"
	u := "c"
	return func() string { return s.Clone() }, func() int { return len(t) },
		func() string { return move(u) }
}

func negative() func() string {
	s := "a"
	// CHECK: [[@LINE+1]]:32: error: cannot return s: it is a captured variable (CLO-9), and this needs ownership (OWN-R3a)
	return func() string { return s }
}
