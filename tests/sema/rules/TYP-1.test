// RUN: not %gopp check %s 2>&1 | FileCheck "--implicit-check-not=error[E" %s
// Rule TYP-1: `View[string]` and `string` (and `View[[]T]` and `[]T`) are
// different types; identity follows Go.
package main

func takesRef(r View[string]) {}

func positive(r View[string]) {
	var a View[string] = r
	var f func(View[string]) = takesRef
	f(a)
}

func negative() {
	// CHECK: [[@LINE+1]]:23: error{{\[E[0-9]+\]}}: cannot use takesRef (value of type func(View[string])) as func(string) value in variable declaration
	var f func(string) = takesRef
	_ = f
}
