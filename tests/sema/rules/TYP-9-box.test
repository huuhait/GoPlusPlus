// RUN: not %gopp check --check-error-limit=0 %s 2>&1 | FileCheck "--implicit-check-not=error[E" %s
// Rule TYP-9 with TYP-5 (P03.19, ADR-0018 amendment point 5): the box of an
// interface value is shared and read-only all the way down. A map or slice
// held BY VALUE in it (the value itself, or in a struct field or array
// element of it, down to a pointer) cannot be written through a type switch
// binding or an assertion: element stores, `++`, `delete`, `clear`, `copy`,
// `append` into the spare capacity, `move` of an element, `&` of an element,
// a pointer-receiver call or method value on an element, an `&` range
// variable, a slice to array pointer conversion and `unsafe.SliceData`; also
// through an Option Get binding of a part of the box. Only DIRECT writes are
// checked here (rooted at the binding or assertion); a write through a
// variable or call result that stands for a part is accepted until P03.21
// makes the bindings views (TYP-9-box-views-later.test). Reads, `len`,
// `range`, a clone, and anything behind a pointer are unchanged.
package main

import "unsafe"

type Inner struct{ M map[string]int }

type Doc struct {
	Index  map[string]int
	Tags   []int
	Arr    [2][]int
	In     *Inner
	Nested Inner
	Items  []Inner
}

type Plain struct {
	Index map[string]int
	Tags  []int
}

type Named map[string]int

type Slice []int

func (s *Slice) Add(n int) { *s = append(*s, n) }

func use(n int) {}

// --- a map binding
func negativeMapBinding(v any) {
	switch b := v.(type) {
	case map[string]int:
		// CHECK: [[@LINE+1]]:3: error{{\[E0354\]}}: cannot write b["b"]: it is part of a map inside an interface value, and the box of an interface value is shared and read-only (TYP-9); clone it first (`c := b.Clone()`, then write c), or put a pointer in the interface
		b["b"] = 2
		// CHECK: [[@LINE+1]]:3: error{{\[E0354\]}}: cannot write b["b"]: it is part of a map inside an interface value, and the box of an interface value is shared and read-only (TYP-9); clone it first (`c := b.Clone()`, then write c), or put a pointer in the interface
		b["b"]++
		// CHECK: [[@LINE+1]]:3: error{{\[E0354\]}}: cannot write b["b"]: it is part of a map inside an interface value, and the box of an interface value is shared and read-only (TYP-9); clone it first (`c := b.Clone()`, then write c), or put a pointer in the interface
		b["b"] += 3
		// CHECK: [[@LINE+1]]:3: error{{\[E0354\]}}: cannot write delete(b, "k"): it is part of a map inside an interface value, and the box of an interface value is shared and read-only (TYP-9); clone it first (`c := b.Clone()`, then write c), or put a pointer in the interface
		delete(b, "k")
		// CHECK: [[@LINE+1]]:3: error{{\[E0354\]}}: cannot write clear(b): it is part of a map inside an interface value, and the box of an interface value is shared and read-only (TYP-9); clone it first (`c := b.Clone()`, then write c), or put a pointer in the interface
		clear(b)
	case Named:
		// CHECK: [[@LINE+1]]:3: error{{\[E0354\]}}: cannot write b["b"]: it is part of a map inside an interface value, and the box of an interface value is shared and read-only (TYP-9); clone it first (`c := b.Clone()`, then write c), or put a pointer in the interface
		b["b"] = 2
		// CHECK: [[@LINE+1]]:3: error{{\[E0354\]}}: cannot write Named(b)["c"]: it is part of a map inside an interface value, and the box of an interface value is shared and read-only (TYP-9); clone it first (`c := b.Clone()`, then write c), or put a pointer in the interface
		Named(b)["c"] = 3
	case map[string]map[string]int:
		// CHECK: [[@LINE+1]]:3: error{{\[E0354\]}}: cannot write b["a"]["b"]: it is part of a map inside an interface value, and the box of an interface value is shared and read-only (TYP-9); clone it first (`c := b.Clone()`, then write c), or put a pointer in the interface
		b["a"]["b"] = 1
	}
}

func positiveMapBinding(v any) int {
	n := 0
	switch b := v.(type) {
	case map[string]int:
		n += len(b) + b["x"]
		for k, e := range b {
			_, _ = k, e
		}
		if e, ok := b["y"]; ok {
			n += e
		}
		m := b.Clone()
		m["b"] = 2
		m["b"]++
		delete(m, "k")
		clear(m)
	case Named:
		n += len(b)
	}
	return n
}

// --- a slice binding
func negativeSliceBinding(v any) {
	switch b := v.(type) {
	case []int:
		// CHECK: [[@LINE+1]]:3: error{{\[E0354\]}}: cannot write b[0]: it is part of a slice inside an interface value, and the box of an interface value is shared and read-only (TYP-9); clone it first (`c := b.Clone()`, then write c), or put a pointer in the interface
		b[0] = 1
		// CHECK: [[@LINE+1]]:3: error{{\[E0354\]}}: cannot write b[0]: it is part of a slice inside an interface value, and the box of an interface value is shared and read-only (TYP-9); clone it first (`c := b.Clone()`, then write c), or put a pointer in the interface
		b[0]++
		// CHECK: [[@LINE+2]]:3: error{{\[E0354\]}}: cannot write b[1]: it is part of a slice inside an interface value, and the box of an interface value is shared and read-only (TYP-9); clone it first (`c := b.Clone()`, then write c), or put a pointer in the interface
		// CHECK: [[@LINE+1]]:9: error{{\[E0354\]}}: cannot write b[0]: it is part of a slice inside an interface value, and the box of an interface value is shared and read-only (TYP-9); clone it first (`c := b.Clone()`, then write c), or put a pointer in the interface
		b[1], b[0] = b[0], b[1]
		// CHECK: [[@LINE+1]]:3: error{{\[E0354\]}}: cannot write copy(b, b): it is part of a slice inside an interface value, and the box of an interface value is shared and read-only (TYP-9); clone it first (`c := b.Clone()`, then write c), or put a pointer in the interface
		copy(b, b)
		// CHECK: [[@LINE+1]]:3: error{{\[E0354\]}}: cannot write copy(b[1:], b): it is part of a slice inside an interface value, and the box of an interface value is shared and read-only (TYP-9); clone it first (`c := b.Clone()`, then write c), or put a pointer in the interface
		copy(b[1:], b)
		// CHECK: [[@LINE+1]]:3: error{{\[E0354\]}}: cannot write clear(b): it is part of a slice inside an interface value, and the box of an interface value is shared and read-only (TYP-9); clone it first (`c := b.Clone()`, then write c), or put a pointer in the interface
		clear(b)
		// CHECK: [[@LINE+1]]:8: error{{\[E0354\]}}: cannot write through &b[0]: it is part of a slice inside an interface value, and the box of an interface value is shared and read-only (TYP-9); clone it first (`c := b.Clone()`, then write c), or put a pointer in the interface
		p := &b[0]
		_ = p
		// CHECK: [[@LINE+1]]:22: error{{\[E0354\]}}: cannot write through the `&` range variable over b: it is part of a slice inside an interface value, and the box of an interface value is shared and read-only (TYP-9); clone it first (`c := b.Clone()`, then write c), or put a pointer in the interface
		for _, &e := range b {
			e = 1
		}
		s := b[1:]
		// Accepted until P03.21 (box bindings become views, ADR-0020): a write through a variable that stands for a part of the box is not a direct write.
		s[0] = 1
	case Slice:
		// CHECK: [[@LINE+1]]:3: error{{\[E0263\]}}: cannot call pointer method Add on b: it is a borrowed variable (OWN-R3b)
		b.Add(1)
	}
}

func positiveSliceBinding(v any) int {
	n := 0
	switch b := v.(type) {
	case []int:
		n += len(b) + b[0] + cap(b)
		for _, e := range b {
			n += e
		}
		for i := range b {
			n += b[i]
		}
		c := b.Clone()
		c[0] = 1
		copy(c, b)
		_ = append(c, 2)
		t := b[1:]
		n += t[0]
	}
	return n
}

// --- the assertion forms
func negativeAssertion(x any) {
	// CHECK: [[@LINE+1]]:2: error{{\[E0354\]}}: cannot write x.(map[string]int)["b"]: it is part of a map inside an interface value, and the box of an interface value is shared and read-only (TYP-9); clone it first (`c := x.(map[string]int).Clone()`, then write c), or put a pointer in the interface
	x.(map[string]int)["b"] = 2
	// CHECK: [[@LINE+1]]:2: error{{\[E0354\]}}: cannot write x.(map[string]int)["b"]: it is part of a map inside an interface value, and the box of an interface value is shared and read-only (TYP-9); clone it first (`c := x.(map[string]int).Clone()`, then write c), or put a pointer in the interface
	x.(map[string]int)["b"]++
	// CHECK: [[@LINE+1]]:2: error{{\[E0354\]}}: cannot write delete(x.(map[string]int), "k"): it is part of a map inside an interface value, and the box of an interface value is shared and read-only (TYP-9); clone it first (`c := x.(map[string]int).Clone()`, then write c), or put a pointer in the interface
	delete(x.(map[string]int), "k")
	// CHECK: [[@LINE+1]]:2: error{{\[E0354\]}}: cannot write clear(x.(map[string]int)): it is part of a map inside an interface value, and the box of an interface value is shared and read-only (TYP-9); clone it first (`c := x.(map[string]int).Clone()`, then write c), or put a pointer in the interface
	clear(x.(map[string]int))
	// CHECK: [[@LINE+1]]:2: error{{\[E0354\]}}: cannot write x.([]int)[0]: it is part of a slice inside an interface value, and the box of an interface value is shared and read-only (TYP-9); clone it first (`c := x.([]int).Clone()`, then write c), or put a pointer in the interface
	x.([]int)[0] = 1
	// CHECK: [[@LINE+1]]:2: error{{\[E0354\]}}: cannot write x.(Doc).Index["x"]: it is part of a map inside an interface value, and the box of an interface value is shared and read-only (TYP-9); clone it first (`c := x.(Doc).Clone()`, then write c), or put a pointer in the interface
	x.(Doc).Index["x"] = 1
	// CHECK: [[@LINE+1]]:2: error{{\[E0354\]}}: cannot write x.(Doc).Tags[0]: it is part of a slice inside an interface value, and the box of an interface value is shared and read-only (TYP-9); clone it first (`c := x.(Doc).Clone()`, then write c), or put a pointer in the interface
	x.(Doc).Tags[0] = 1
	// CHECK: [[@LINE+1]]:2: error{{\[E0354\]}}: cannot write x.(Doc).Arr[1][0]: it is part of a slice inside an interface value, and the box of an interface value is shared and read-only (TYP-9); clone it first (`c := x.(Doc).Clone()`, then write c), or put a pointer in the interface
	x.(Doc).Arr[1][0] = 1
	// CHECK: [[@LINE+1]]:2: error{{\[E0354\]}}: cannot write x.(Doc).Nested.M["k"]: it is part of a map inside an interface value, and the box of an interface value is shared and read-only (TYP-9); clone it first (`c := x.(Doc).Clone()`, then write c), or put a pointer in the interface
	x.(Doc).Nested.M["k"] = 1
	// CHECK: [[@LINE+1]]:2: error{{\[E0354\]}}: cannot write x.(Doc).Items[0].M["k"]: it is part of a map inside an interface value, and the box of an interface value is shared and read-only (TYP-9); clone it first (`c := x.(Doc).Clone()`, then write c), or put a pointer in the interface
	x.(Doc).Items[0].M["k"] = 1
	m := x.(map[string]int)
	// CHECK: [[@LINE+1]]:2: error{{\[E0354\]}}: cannot write m["b"]: it is part of a map inside an interface value, and the box of an interface value is shared and read-only (TYP-9); clone it first (`c := m.Clone()`, then write c), or put a pointer in the interface
	m["b"] = 2
	if s, ok := x.([]int); ok {
		// CHECK: [[@LINE+1]]:3: error{{\[E0354\]}}: cannot write s[0]: it is part of a slice inside an interface value, and the box of an interface value is shared and read-only (TYP-9); clone it first (`c := s.Clone()`, then write c), or put a pointer in the interface
		s[0] = 1
	}
	_ = Named(x.(map[string]int))
}

func positiveAssertion(x any) int {
	n := len(x.(map[string]int)) + x.([]int)[0] + x.(Doc).Tags[0]
	n += x.(Doc).Index["x"] + len(x.(Doc).Items)
	c := x.(map[string]int).Clone()
	c["b"] = 2
	d := x.(Plain).Clone()
	d.Index["x"] = 1
	// CHECK: [[@LINE+1]]:2: error{{\[E0354\]}}: cannot write x.(Plain).Index["y"]: it is part of a map inside an interface value, and the box of an interface value is shared and read-only (TYP-9); clone it first (`c := x.(Plain).Clone()`, then write c), or put a pointer in the interface
	x.(Plain).Index["y"] = 1
	return n
}

// --- a struct binding: fields, array elements, nested values
func negativeDocBinding(v any) {
	switch d := v.(type) {
	case Doc:
		// An array held by value in the binding: one error, RNG-1a's.
		// CHECK: [[@LINE+1]]:10: error{{\[E0283\]}}: cannot use & on the elements of d.Arr: the array is held by value in borrowed variable d (RNG-1a)
		for _, &row := range d.Arr {
			row = nil
		}
		// CHECK: [[@LINE+1]]:3: error{{\[E0354\]}}: cannot write d.Tags[0]: it is part of a slice inside an interface value, and the box of an interface value is shared and read-only (TYP-9); clone it first (`c := d.Clone()`, then write c), or put a pointer in the interface
		d.Tags[0] = 1
		// CHECK: [[@LINE+1]]:3: error{{\[E0354\]}}: cannot write d.Index["x"]: it is part of a map inside an interface value, and the box of an interface value is shared and read-only (TYP-9); clone it first (`c := d.Clone()`, then write c), or put a pointer in the interface
		d.Index["x"] = 1
		// CHECK: [[@LINE+1]]:3: error{{\[E0354\]}}: cannot write d.Index["x"]: it is part of a map inside an interface value, and the box of an interface value is shared and read-only (TYP-9); clone it first (`c := d.Clone()`, then write c), or put a pointer in the interface
		d.Index["x"]++
		// CHECK: [[@LINE+1]]:3: error{{\[E0354\]}}: cannot write d.Arr[0][1]: it is part of a slice inside an interface value, and the box of an interface value is shared and read-only (TYP-9); clone it first (`c := d.Clone()`, then write c), or put a pointer in the interface
		d.Arr[0][1] = 1
		// CHECK: [[@LINE+1]]:3: error{{\[E0354\]}}: cannot write d.Nested.M["k"]: it is part of a map inside an interface value, and the box of an interface value is shared and read-only (TYP-9); clone it first (`c := d.Clone()`, then write c), or put a pointer in the interface
		d.Nested.M["k"] = 1
		// CHECK: [[@LINE+1]]:3: error{{\[E0354\]}}: cannot write d.Items[0].M["k"]: it is part of a map inside an interface value, and the box of an interface value is shared and read-only (TYP-9); clone it first (`c := d.Clone()`, then write c), or put a pointer in the interface
		d.Items[0].M["k"] = 1
		// CHECK: [[@LINE+1]]:3: error{{\[E0354\]}}: cannot write delete(d.Index, "x"): it is part of a map inside an interface value, and the box of an interface value is shared and read-only (TYP-9); clone it first (`c := d.Clone()`, then write c), or put a pointer in the interface
		delete(d.Index, "x")
		// CHECK: [[@LINE+1]]:3: error{{\[E0354\]}}: cannot write clear(d.Tags): it is part of a slice inside an interface value, and the box of an interface value is shared and read-only (TYP-9); clone it first (`c := d.Clone()`, then write c), or put a pointer in the interface
		clear(d.Tags)
		// CHECK: [[@LINE+1]]:3: error{{\[E0354\]}}: cannot write copy(d.Tags, d.Tags): it is part of a slice inside an interface value, and the box of an interface value is shared and read-only (TYP-9); clone it first (`c := d.Clone()`, then write c), or put a pointer in the interface
		copy(d.Tags, d.Tags)
		for _, it := range d.Items {
			// Accepted until P03.21 (box bindings become views, ADR-0020): a write through a variable that stands for a part of the box is not a direct write.
			it.M["k"] = 1
		}
		for i := range d.Items {
			// CHECK: [[@LINE+1]]:4: error{{\[E0354\]}}: cannot write d.Items[i].M["k"]: it is part of a map inside an interface value, and the box of an interface value is shared and read-only (TYP-9); clone it first (`c := d.Clone()`, then write c), or put a pointer in the interface
			d.Items[i].M["k"] = 1
		}
	}
}

func positiveDocBinding(v any) int {
	n := 0
	switch d := v.(type) {
	case Doc:
		n += d.Tags[0] + d.Index["x"] + d.Arr[0][1] + d.Nested.M["k"]
		d.In.M["k"] = 1
		d.In.M["k"]++
		delete(d.In.M, "k")
		for _, it := range d.Items {
			n += len(it.M)
		}
	case Plain:
		e := d.Clone()
		e.Tags[0] = 1
		e.Index["x"] = 1
		// CHECK: [[@LINE+1]]:3: error{{\[E0354\]}}: cannot write d.Tags[0]: it is part of a slice inside an interface value, and the box of an interface value is shared and read-only (TYP-9); clone it first (`c := d.Clone()`, then write c), or put a pointer in the interface
		d.Tags[0] = 1
	case *Doc:
		d.Tags[0] = 1
		d.Index["x"] = 1
		d.In.M["k"] = 1
	case *Inner:
		d.M["k"] = 1
	}
	return n
}

// --- through a pointer, a closure, a ref
func negativeClosure(v any) {
	switch b := v.(type) {
	case map[string]int:
		f := func() {
			// CHECK: [[@LINE+1]]:4: error{{\[E0354\]}}: cannot write b["b"]: it is part of a map inside an interface value, and the box of an interface value is shared and read-only (TYP-9); clone it first (`c := b.Clone()`, then write c), or put a pointer in the interface
			b["b"] = 2
		}
		f()
	}
}

func positivePointer(x any) {
	p := x.(*map[string]int)
	(*p)["a"] = 1
	delete(*p, "a")
	q := x.(*Doc)
	q.Index["x"] = 1
	q.Tags[0] = 1
	x.(*Doc).Index["x"] = 1
	x.(*Doc).In.M["k"] = 1
	x.(Doc).In.M["k"] = 1
	r := x.(*Slice)
	r.Add(1)
}

// --- an interface that is not read: ordinary maps and slices are unchanged
func positiveOrdinary(m map[string]int, s []int, d Doc) {
	m["a"] = 1
	m["a"]++
	delete(m, "a")
	clear(m)
	s[0] = 1
	copy(s, s)
	d.Tags[0] = 1
	d.Index["a"] = 1
	var local any = m.Clone()
	_ = local
}

// --- a name that stands for part of the box: a ref, a range variable
func negativeAliases(v any, w Wrap) {
	switch b := v.(type) {
	case []int:
		var r ref []int = b[0:1]
		// Accepted until P03.21 (box bindings become views, ADR-0020): a write through a variable that stands for a part of the box is not a direct write.
		r[0] = 1
		var r2 ref []int
		r2 = b[1:]
		// Accepted until P03.21 (box bindings become views, ADR-0020): a write through a variable that stands for a part of the box is not a direct write.
		r2[0] = 2
		for i := range b {
			// CHECK: [[@LINE+1]]:4: error{{\[E0354\]}}: cannot write b[i]: it is part of a slice inside an interface value, and the box of an interface value is shared and read-only (TYP-9); clone it first (`c := b.Clone()`, then write c), or put a pointer in the interface
			b[i] = 1
		}
	case map[string]map[string]int:
		for _, inner := range b {
			// Accepted until P03.21 (box bindings become views, ADR-0020): a write through a variable that stands for a part of the box is not a direct write.
			inner["a"] = 1
		}
		for k := range b {
			// CHECK: [[@LINE+1]]:4: error{{\[E0354\]}}: cannot write b[k]["x"]: it is part of a map inside an interface value, and the box of an interface value is shared and read-only (TYP-9); clone it first (`c := b.Clone()`, then write c), or put a pointer in the interface
			b[k]["x"] = 1
		}
	case [][]int:
		for _, row := range b {
			// Accepted until P03.21 (box bindings become views, ADR-0020): a write through a variable that stands for a part of the box is not a direct write.
			row[0] = 1
		}
	}
	// CHECK: [[@LINE+1]]:2: error{{\[E0354\]}}: cannot write w.x.(map[string]int)["a"]: it is part of a map inside an interface value, and the box of an interface value is shared and read-only (TYP-9); clone it first (`c := w.x.(map[string]int).Clone()`, then write c), or put a pointer in the interface
	w.x.(map[string]int)["a"] = 1
}

type Wrap struct{ x any }

func positiveAliases(v any, w Wrap) int {
	n := 0
	switch b := v.(type) {
	case []int:
		var r ref []int = b[0:1]
		n += r[0]
		for _, e := range b {
			n += e
		}
	case map[string]map[string]int:
		for _, inner := range b {
			n += len(inner) + inner["a"]
		}
		own := b.Clone()
		own["k"]["x"] = 1
	case [][]int:
		for _, row := range b {
			n += row[0]
		}
	}
	n += len(w.x.(map[string]int))
	return n
}

// --- a generic constraint over a map or slice
func negativeGeneric[M ~map[string]int](x any) {
	// CHECK: [[@LINE+1]]:2: error{{\[E0354\]}}: cannot write x.(M)["a"]: it is part of a map inside an interface value, and the box of an interface value is shared and read-only (TYP-9); clone it first (`c := x.(M).Clone()`, then write c), or put a pointer in the interface
	x.(M)["a"] = 1
}

func positiveGeneric[M ~map[string]int](m M, x any) int {
	m["a"] = 1
	return len(x.(M))
}

// --- every other write form on a part of the box: append through a
// conversion that shares the box's slice (it would write into its spare
// capacity), move of an element, a pointer-receiver call on an element
type Counter struct{ N int }

func (c *Counter) Inc()     { c.N++ }
func (c Counter) Get() int  { return c.N }

type Item struct{ Name string }

func negativeWriteForms(v any, x any) {
	switch b := v.(type) {
	case []Item:
		// CHECK: [[@LINE+1]]:7: error{{\[E0354\]}}: cannot write move(b[0]): it is part of a slice inside an interface value, and the box of an interface value is shared and read-only (TYP-9); clone it first (`c := b.Clone()`, then write c), or put a pointer in the interface
		_ = move(b[0])
	case map[string]Item:
		// CHECK: [[@LINE+1]]:7: error{{\[E0354\]}}: cannot write move(b["k"]): it is part of a map inside an interface value, and the box of an interface value is shared and read-only (TYP-9); clone it first (`c := b.Clone()`, then write c), or put a pointer in the interface
		_ = move(b["k"])
	case []Counter:
		// CHECK: [[@LINE+1]]:3: error{{\[E0354\]}}: cannot write through the pointer receiver of b[0].Inc: it is part of a slice inside an interface value, and the box of an interface value is shared and read-only (TYP-9); clone it first (`c := b.Clone()`, then write c), or put a pointer in the interface
		b[0].Inc()
	case [2]map[string]int:
		// CHECK: [[@LINE+1]]:3: error{{\[E0354\]}}: cannot write b[1]["k"]: it is part of a map inside an interface value, and the box of an interface value is shared and read-only (TYP-9); clone it first (`c := b.Clone()`, then write c), or put a pointer in the interface
		b[1]["k"] = 2
	}
	// (`append(b, 1)` on a binding is PAR-1, `append(b[:1], 1)` OWN-V1 and
	// `append(x.([]int), 1)` OWN-R4; a conversion that shares is this rule.)
	if b, ok := x.([]int); ok {
		// CHECK: [[@LINE+1]]:7: error{{\[E0354\]}}: cannot write append([]int(b), 2): it is part of a slice inside an interface value, and the box of an interface value is shared and read-only (TYP-9); clone it first (`c := b.Clone()`, then write c), or put a pointer in the interface
		_ = append([]int(b), 2)
		// CHECK: [[@LINE+1]]:7: error{{\[E0354\]}}: cannot write append(Slice(b), 3): it is part of a slice inside an interface value, and the box of an interface value is shared and read-only (TYP-9); clone it first (`c := b.Clone()`, then write c), or put a pointer in the interface
		_ = append(Slice(b), 3)
	}
	if m, ok := x.(map[string]int); ok {
		// CHECK: [[@LINE+1]]:3: error{{\[E0354\]}}: cannot write m["b"]: it is part of a map inside an interface value, and the box of an interface value is shared and read-only (TYP-9); clone it first (`c := m.Clone()`, then write c), or put a pointer in the interface
		m["b"] = 2
	}
}

func positiveWriteForms(v any, x any) int {
	n := 0
	switch b := v.(type) {
	case []int:
		c := b.Clone()
		c = append(c, 2)
		n += c[0]
		d := append(x.([]int).Clone(), 3)
		n += d[0]
	case []Item:
		own := b.Clone()
		_ = move(own[0])
	case []Counter:
		n += b[0].Get()
		c := b.Clone()
		c[0].Inc()
	case *[]int:
		(*b)[0] = 1
	case Doc:
		i := b.Index.Clone()
		i["a"] = 1
	}
	i := x.(Doc).Index.Clone()
	i["b"] = 2
	return n
}

// A known limit (TODO P04.09): a callee that writes its borrowed parameter is
// not seen here, so handing a part of the box on as an argument is accepted.
// (A callee that returns a ref into it is seen: positive/negativeRefResult.)
func fill(m map[string]int) { m["x"] = 1 }

func positiveBorrowedArgument(v any) {
	if m, ok := v.(map[string]int); ok {
		fill(m)
	}
}

// --- a binding whose case type is a type parameter is a box binding too
func negativeTypeParamSlice[S ~[]int](x any, w []int) {
	switch v := x.(type) {
	case S:
		// CHECK: [[@LINE+1]]:3: error{{\[E0354\]}}: cannot write v[0]: it is part of a slice
		v[0] = 2
		// CHECK: [[@LINE+1]]:3: error{{\[E0354\]}}: cannot write v[1]: it is part of a slice
		v[1]++
		// CHECK: [[@LINE+1]]:3: error{{\[E0354\]}}: cannot write copy(v, w): it is part of a slice
		copy(v, w)
		// CHECK: [[@LINE+1]]:3: error{{\[E0354\]}}: cannot write clear(v): it is part of a slice
		clear(v)
		// CHECK: [[@LINE+1]]:8: error{{\[E0354\]}}: cannot write through &v[0]: it is part of a slice
		p := &v[0]
		*p = 3
	}
}

func negativeTypeParamMap[M ~map[string]int](x any) {
	switch v := x.(type) {
	case M:
		// CHECK: [[@LINE+1]]:3: error{{\[E0354\]}}: cannot write v["a"]: it is part of a map
		v["a"] = 1
		// CHECK: [[@LINE+1]]:3: error{{\[E0354\]}}: cannot write delete(v, "a"): it is part of a map
		delete(v, "a")
	}
}

func negativeTypeParamAssertion[S ~[]int](x any) {
	s := x.(S)
	// CHECK: [[@LINE+1]]:2: error{{\[E0354\]}}: cannot write s[0]: it is part of a slice
	s[0] = 1
	t, ok := x.(S)
	if ok {
		// CHECK: [[@LINE+1]]:3: error{{\[E0354\]}}: cannot write t[0]: it is part of a slice
		t[0] = 1
	}
}

func positiveTypeParam[S interface {
	~[]int
	Clone
}, M interface {
	~map[string]int
	Clone
}](x any, y S, m M) int {
	n := 0
	switch v := x.(type) {
	case S:
		n += len(v)
		if len(v) > 0 {
			n += v[0]
		}
		for _, e := range v {
			n += e
		}
		c := v.Clone()
		c[0] = 1
	case M:
		n += len(v) + v["a"]
		c := v.Clone()
		c["a"] = 1
	}
	// an ordinary generic local is writable
	y[0] = 1
	m["a"] = 1
	delete(m, "a")
	return n
}

// --- calls that take a part of the box: a ref, pointer or func value they
// return is not a direct write target; accepted until P03.21 (pinned in
// TYP-9-box-views-later.test). Ordinary results stay writable.
func head(s ref []int) ref []int { return s[:1] }

func (d Doc) TagsRef() ref []int { return d.Tags }

func positiveRefResult(x any, own []int) int {
	own2 := head(own)
	own2[0] = 1
	head(own)[0] = 2
	n := 0
	switch v := x.(type) {
	case []int:
		n += head(v)[0]
		c := v.Clone()
		head(c)[0] = 4
	}
	return n
}

func two(s ref []int) (ref []int, int) { return s, 1 }

func ptr(s ref []int) *int { return &s[0] }

func count(s ref []int) int { return len(s) }

func positiveAliasResults(x any, own []int, d Doc) int {
	n := 0
	switch v := x.(type) {
	case []int:
		// a result that is no ref, pointer or func value is a plain value
		k := count(v)
		n += k
		// a closure that captures no part of the box
		h := func() ref []int { return own }
		h()[0] = 1
		// the pointer a binding holds is the box's pointer, and its target is writable
	case *int:
		*v = 1
	}
	// ref, pointer and tuple results from non-box arguments stay writable
	r, _ := two(own)
	r[0] = 1
	*ptr(own) = 2
	p := ptr(own)
	*p = 3
	m := d.TagsRef
	m()[0] = 4
	return n
}

// --- a [T Copy] binding is a plain value (writable like `case int`)
func setp[T Copy](p *T, t T) { *p = t }

func positiveCopyBinding[T Copy](x any, t T) T {
	switch v := x.(type) {
	case T:
		p := &v
		*p = t
		v = t
		setp(&v, t)
		return v
	}
	if w, ok := x.(T); ok {
		w = t
		return w
	}
	return t
}

func positiveNeverBoxAlias(x any, w []int, u []int, d Doc, e Doc) int {
	n := 0
	switch v := x.(type) {
	case []int:
		// a ref and a func value that are never bound to a part of the box
		var r ref []int = w
		g := func() ref []int { return r }
		r = head(u)
		g()[0] = 1
		r[0] = 2
		m := d.TagsRef
		for i := 0; i < 2; i++ {
			m()[0] = 3
			m = e.TagsRef
		}
		// a closure that captures no part of the box, and one that reads it
		// but hands back no alias
		k := func() ref []int { return w }
		k()[0] = 4
		h := func() int { return v[0] }
		n += h()
		// a cursor loop over slices that are no part of the box
		c := head(w)
		for i := 0; i < 2; i++ {
			c[0] = 5
			c = u
		}
		p := ptr(w)
		for i := 0; i < 2; i++ {
			*p = 6
			p = ptr(u)
		}
	}
	return n
}

// A pointer the box holds, found by a helper, points out of the box: its
// target is writable (TYP-9), also through a call result.
type Node struct{ V int }

func find(ns []*Node, k int) *Node { return ns[k] }

func positivePointerResult(x any) {
	switch v := x.(type) {
	case []*Node:
		n := find(v, 0)
		n.V = 1
		find(v, 0).V = 2
		v[0].V = 3
	}
}

// --- a slice to array pointer conversion points into the slice: making one
// from a part of the box is the error (R10), as `&v[0]` is
func negativeArrayPointer(x any, w []int) {
	switch v := x.(type) {
	case []int:
		// CHECK: [[@LINE+1]]:18: error{{\[E0354\]}}: cannot write through (*[2]int)(v): it is part of a slice inside an interface value
		p := (*[2]int)(v)
		_ = p
		// CHECK: [[@LINE+1]]:13: error{{\[E0354\]}}: cannot write through (*[2]int)(v): it is part of a slice
		(*[2]int)(v)[1] = 2
		// CHECK: [[@LINE+1]]:18: error{{\[E0354\]}}: cannot write through (*[1]int)(x.([]int)): it is part of a slice
		q := (*[1]int)(x.([]int))
		_ = q
	case Doc:
		// CHECK: [[@LINE+1]]:18: error{{\[E0354\]}}: cannot write through (*[1]int)(v.Tags): it is part of a slice
		r := (*[1]int)(v.Tags)
		_ = r
	}
}

// CHECK: [[@LINE+1]]:59: error{{\[E0354\]}}: cannot write through (*[1]int)(x.([]int)): it is part of a slice
func arrayPointerResult(x any) *[1]int { return (*[1]int)(x.([]int)) }

func positiveArrayPointer(x any, w []int) int {
	p := (*[2]int)(w)
	p[0] = 1
	n := 0
	if v, ok := x.([]int); ok {
		c := v.Clone()
		q := (*[1]int)(c)
		q[0] = 2
		n += [2]int(v)[0] // an array value is a copy
	}
	return n
}

// --- an Option Get binding of a part of the box is a box binding (R12)
type Opts struct {
	Tags  []int
	Index map[string]int
}

func negativeOptionGet(x any) {
	switch w := x.(type) {
	case Option[Opts]:
		if d, ok := w.Get(); ok {
			// CHECK: [[@LINE+1]]:4: error{{\[E0354\]}}: cannot write d.Tags[0]: it is part of a slice
			d.Tags[0] = 1
			// CHECK: [[@LINE+1]]:4: error{{\[E0354\]}}: cannot write d.Index["a"]: it is part of a map
			d.Index["a"] = 2
			// CHECK: [[@LINE+1]]:4: error{{\[E0354\]}}: cannot write delete(d.Index, "b"): it is part of a map
			delete(d.Index, "b")
			// CHECK: [[@LINE+1]]:4: error{{\[E0354\]}}: cannot write clear(d.Tags): it is part of a slice
			clear(d.Tags)
		}
	case Doc:
		_ = w
	}
	if d, ok := x.(Option[Opts]).Get(); ok {
		// CHECK: [[@LINE+1]]:3: error{{\[E0354\]}}: cannot write d.Index["c"]: it is part of a map
		d.Index["c"] = 4
	}
}

func positiveOptionGet(o Option[Opts], x any) int {
	// an Option that is no part of a box: its Get binding borrows o
	if d, ok := o.Get(); ok {
		d.Tags[0] = 1
	}
	n := 0
	if w, ok := x.(Option[Opts]); ok {
		if d, ok2 := w.Get(); ok2 {
			n += d.Tags[0] + len(d.Index)
			c := d.Tags.Clone()
			c[0] = 2
		}
	}
	return n
}

// --- a pointer-receiver method value on an element takes its address
func negativeMethodValue(x any) {
	if v, ok := x.([]Counter); ok {
		// CHECK: [[@LINE+1]]:8: error{{\[E0354\]}}: cannot write through the pointer receiver of v[0].Inc: it is part of a slice
		f := v[0].Inc
		f()
	}
}

// --- unsafe.SliceData points into the slice
func negativeSliceData(x any) {
	if v, ok := x.([]int); ok {
		// CHECK: [[@LINE+1]]:8: error{{\[E0354\]}}: cannot write through unsafe.SliceData(v): it is part of a slice
		p := unsafe.SliceData(v)
		_ = p
	}
}
