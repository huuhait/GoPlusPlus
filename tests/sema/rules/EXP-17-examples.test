// RUN: %gopp check %s
// RUN: %gopp fmt %s | diff - %s
// Rules EXP-17 to EXP-28 and the examples of ADR-0024, accepted: `Vec2` with
// `@Right` `*` and `/`, `Sum` over `int`, `Vec2` and `BigInt` with
// `interface{ + (T) T; Clone }`, `Matrix` with `[]`, `[]=`, `a[i, j] += v` and
// an in-place `+=`, `Queue` with send and receive, `10*Km + 500*M` on a
// defined number type next to a method with another right-hand type
// (`Meters * Seconds`) and the built-in `Meters * Meters`, `@Right` on `-`,
// `/`, `%`, `<<`, `>>`, `&^` and `<=>` with the ordering operators made from
// it, and operator methods on a generic type. The file has no error line.
package main

type Vec2 struct{ X, Y float64 }

func (a Vec2) + (b Vec2) Vec2 { return Vec2{a.X + b.X, a.Y + b.Y} }
func (a Vec2) - (b Vec2) Vec2 { return Vec2{a.X - b.X, a.Y - b.Y} }
@Right
func (a Vec2) * (s float64) Vec2 { return Vec2{a.X * s, a.Y * s} }
func (a Vec2) - () Vec2          { return Vec2{-a.X, -a.Y} }
func (a Vec2) == (b Vec2) bool   { return a.X == b.X && a.Y == b.Y }
@Right
func (a Vec2) / (s float64) Vec2 { return Vec2{s / a.X, s / a.Y} }

type BigInt struct{ n []int }

func (a BigInt) + (b BigInt) BigInt { return BigInt{} }
func (b BigInt) Clone() BigInt      { return BigInt{} }
@Convert
func (b BigInt) Int64() int64 { return 0 }

func Sum[T interface {
	+ (T) T
	Clone
}](xs []T) T {
	acc := xs[0].Clone()
	for i := 1; i < len(xs); i++ {
		acc = acc + xs[i]
	}
	return acc
}

type Matrix struct {
	rows, cols int
	data       []float64
}

func (m Matrix) [] (i, j int) float64      { return m.data[i*m.cols+j] }
func (m *Matrix) []= (i, j int, v float64) { m.data[i*m.cols+j] = v }
func (m Matrix) * (o Matrix) Matrix        { return Matrix{} }
func (m Matrix) + (o Matrix) Matrix        { return Matrix{} }
func (m *Matrix) += (o Matrix)             {}

type Job struct{ id int }
type Queue struct{ jobs []Job }

func (q *Queue) <- (v Job) {}
func (q *Queue) <- () Job  { return Job{} }

type Meters float64
type Seconds float64
type Speed float64

const (
	M  Meters = 1
	Km Meters = 1000
)

func (a Meters) * (b Seconds) Speed { return 0 }

func main() {
	a := Vec2{1, 2}
	b := Vec2{3, 4}
	c := a + b
	d := -a * 2.0
	e := 2.0 * a
	f := 1.0 / a
	c += b
	ok := a != b
	_, _, _, _ = d, e, f, ok
	_ = Sum([]int{1, 2, 3})
	_ = Sum([]Vec2{{1, 2}, {3, 4}})
	_ = Sum([]BigInt{{}, {}})
	var m, n Matrix
	m[1, 2] = 5.0
	x := m[1, 2]
	m[1, 2] += 1.0
	m += n
	_ = x
	var q Queue
	q <- Job{}
	j := <-q
	_ = j
	dd := 10*Km + 500*M
	_ = dd
	var s Seconds = 2
	_ = M * s
	bi := BigInt{}
	_ = int64(bi)
	_ = bi.Int64()
}

type RS struct{ k int }

@Right
func (a RS) - (n int) RS { return a }
@Right
func (a RS) / (n int) RS { return a }
@Right
func (a RS) % (n int) RS { return a }
@Right
func (a RS) << (n int) RS { return a }
@Right
func (a RS) >> (n int) RS { return a }
@Right
func (a RS) &^ (n int) RS { return a }
@Right
func (a RS) <=> (n int) int     { return 0 }
func (a RS) - (n int) RS        { return a }
func (a RS) <=> (n float64) int { return 0 }

func rights(a RS) {
	_ = a - 1
	_ = 1 - a
	_ = 2 / a
	_ = 3 % a
	_ = 1 << a
	_ = 8 >> a
	_ = 7 &^ a
	_ = 1 <=> a
	_ = a <=> 2.5
	_ = 1 < a
}

type Box[T any] struct{ v T }

func (b Box[T]) + (c Box[T]) Box[T] { panic(1) }
func (b Box[T]) == (c Box[T]) bool  { return true }
func (b Box[T]) [] (i int) int      { return i }

func generic() {
	var a, b Box[int]
	_ = a + b
	_ = a == b
	_ = a[0]
	var s, t Box[string]
	_ = s + t
	_ = s != t
}

func units() {
	_ = 2 * Km
	_ = Km * 2
	_ = Km * Km
	_ = Km + 1000
	var sec Seconds = 3
	_ = Km * sec
	_ = 2.5 * M
}
