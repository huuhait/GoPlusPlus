// RUN: not %gopp check %s 2>&1 | FileCheck --implicit-check-not=error: %s
// Rule STM-7: `ch <- a` moves a into the channel: an owned local moves, a
// value in another place needs Clone or move.
package main

type Doc struct{ Title string }

func positive(ch chan Doc, p *Doc) {
	d := Doc{Title: "a"}
	ch <- d
	ch <- (*p).Clone()
	ch <- move(*p)
}

func negative(ch chan string, p *Doc) {
	// CHECK: [[@LINE+1]]:8: error: cannot send p.Title: it is a value in another place, and this needs ownership (OWN-R3a)
	ch <- p.Title
}
