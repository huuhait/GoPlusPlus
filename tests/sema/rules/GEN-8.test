// RUN: not %gopp check %s 2>&1 | FileCheck "--implicit-check-not=error[E" %s
// Rule GEN-8: type arguments of a generic method may be explicit or
// inferred: s.Map[string](f) or s.Map(f).
package main

type Set struct{}

func (s Set) Map[U any](f func(int) U) U { return f(0) }
func (s Set) Zero[U any]() Option[U]  { var z Option[U]; return z }

func positive(s Set) {
	_ = s.Map[string](func(int) string { return "" })
	_ = s.Map(func(int) string { return "" })
	_ = s.Zero[int]()
}

func negative(s Set) {
	// CHECK: [[@LINE+1]]:12: error{{\[E[0-9]+\]}}: in call to s.Zero, cannot infer U (declared at {{.*}}GEN-8.test:9:19)
	_ = s.Zero()
}
