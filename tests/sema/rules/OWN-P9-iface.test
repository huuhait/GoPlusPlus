// RUN: not %gopp check --check-error-limit=0 %s 2>&1 | FileCheck "--implicit-check-not=error[E" %s
// Rule OWN-P9 for funcs and interfaces (P03.18, ADR-0018 amendment 3): a func
// type and an interface with methods (other than `error`) are never nil and
// have no zero value; Option[Logger] and Option[func()] are the "maybe".
// error and its aliases, any (the empty interface, also named), maps, slices,
// channels and unsafe.Pointer keep nil. A defined `type MyErr error` and an
// interface that embeds error and adds methods are never nil. A nil Option[T]
// converts to a nil any / error and to an Option[I]. Functions named
// positive* have no error; each negative line has a CHECK.
package main

import "unsafe"

type Logger interface{ Log(s string) }
type MyErr error
type Coded interface {
	error
	Code() int
}
type E = error
type Thing interface{}
type Alias = any

type Impl struct{}

func (Impl) Log(s string) {}

type Fail struct{}

func (Fail) Error() string { return "fail" }

type Server struct {
	Log    Logger
	OnStop Option[func()]
}

type Holder struct {
	F func()
}

type Keeper struct {
	Err error
	A   any
	M   map[string]int
	S   []int
	C   chan int
	P   unsafe.Pointer
}

func positiveNilable(e E, t Thing, a Alias, m map[string]int, s []int, c chan int, p unsafe.Pointer) bool {
	var err error
	var e2 E
	var x any
	var th Thing
	var al Alias
	var mm map[string]int
	var ss []int
	var cc chan int
	var up unsafe.Pointer
	x = nil
	err = nil
	_ = make([]any, 3)
	_ = make([]error, 3)
	_ = map[string]any{}["k"]
	_, _, _, _, _, _, _, _ = err, e2, x, th, al, mm, ss, cc
	_ = up
	_ = recover()
	k := Keeper{}
	_ = k
	return err == nil && e == nil && x == nil && t == nil && a == nil && m == nil && s == nil && c == nil && p == nil
}

func positiveOption(f Option[func()], l Option[Logger], oi Option[Impl], of Option[Fail], ol Option[Logger]) {
	if f != nil {
		f()
	}
	if l == nil {
		return
	}
	l.Log("x")
	var a any = oi
	var e error = of
	var ol2 Option[Logger] = oi
	_, _, _ = a, e, ol2
	// Where the Option is known set, its value converts directly.
	if oi != nil {
		var lg Logger = oi
		lg.Log("y")
	}
	s := Server{Log: Impl{}}
	if s.OnStop != nil {
		_ = s.OnStop
	}
	_ = ol
}

func positiveUse(l Logger, f func(), mk func() Logger) {
	l.Log("x")
	f()
	g := f
	g()
	_ = mk().Log
	_ = []Logger{l}
	_ = []func(){f}
	ls := make([]Logger, 0, 4)
	ls = append(ls, l)
	_ = ls
	if m, ok := map[string]Logger{}["a"]; ok {
		m.Log("y")
	}
	fc := make(chan func(), 1)
	fc <- f
	if h, ok := <-fc; ok {
		h()
	}
}

func negativeZero() {
	// CHECK-DAG: [[@LINE+1]]:{{[0-9]+}}: error{{\[E[0-9]+\]}}: cannot declare l without a value: Logger has no zero value (interfaces with methods are never nil)
	var l Logger
	// CHECK-DAG: [[@LINE+1]]:{{[0-9]+}}: error{{\[E[0-9]+\]}}: cannot declare f without a value: func() has no zero value (funcs are never nil)
	var f func()
	// CHECK-DAG: [[@LINE+1]]:{{[0-9]+}}: error{{\[E[0-9]+\]}}: cannot declare me without a value: MyErr has no zero value (interfaces with methods are never nil)
	var me MyErr
	// CHECK-DAG: [[@LINE+1]]:{{[0-9]+}}: error{{\[E[0-9]+\]}}: cannot declare c without a value: Coded has no zero value (interfaces with methods are never nil)
	var c Coded
	// CHECK-DAG: [[@LINE+1]]:{{[0-9]+}}: error{{\[E[0-9]+\]}}: cannot declare h without a value: Holder has no zero value (field F of type func() has none: funcs are never nil)
	var h Holder
	// CHECK-DAG: [[@LINE+1]]:{{[0-9]+}}: error{{\[E[0-9]+\]}}: cannot declare s without a value: Server has no zero value (field Log of type Logger has none: interfaces with methods are never nil)
	var s Server
	_, _, _, _, _, _ = l, f, me, c, h, s
}

func negativeNil(l Logger, f func(), me MyErr, c Coded) {
	// CHECK-DAG: [[@LINE+1]]:{{[0-9]+}}: error{{\[E[0-9]+\]}}: Logger is never nil: an interface with methods has no nil; use Option[Logger] for "maybe" (OWN-P9)
	_ = l == nil
	// CHECK-DAG: [[@LINE+1]]:{{[0-9]+}}: error{{\[E[0-9]+\]}}: func() is never nil: a func has no nil; use Option[func()] for "maybe" (OWN-P9)
	_ = f != nil
	// CHECK-DAG: [[@LINE+1]]:{{[0-9]+}}: error{{\[E[0-9]+\]}}: MyErr is never nil: an interface with methods has no nil; use Option[MyErr] for "maybe" (OWN-P9)
	_ = me == nil
	// CHECK-DAG: [[@LINE+1]]:{{[0-9]+}}: error{{\[E[0-9]+\]}}: Coded is never nil: an interface with methods has no nil; use Option[Coded] for "maybe" (OWN-P9)
	_ = nil == c
	// CHECK-DAG: [[@LINE+1]]:{{[0-9]+}}: error{{\[E[0-9]+\]}}: invalid operation: f == f (a func is never nil and cannot be compared (TYP-3))
	_ = f == f
	// CHECK-DAG: [[@LINE+1]]:{{[0-9]+}}: error{{\[E[0-9]+\]}}: Logger is never nil: an interface with methods has no nil; use Option[Logger] for "maybe" (OWN-P9)
	l = nil
	// CHECK-DAG: [[@LINE+1]]:{{[0-9]+}}: error{{\[E[0-9]+\]}}: func() is never nil: a func has no nil; use Option[func()] for "maybe" (OWN-P9)
	f = nil
	// CHECK-DAG: [[@LINE+1]]:{{[0-9]+}}: error{{\[E[0-9]+\]}}: Logger is never nil: an interface with methods has no nil; use Option[Logger] for "maybe" (OWN-P9)
	_ = Server{Log: nil}
	// CHECK-DAG: [[@LINE+1]]:{{[0-9]+}}: error{{\[E[0-9]+\]}}: cannot convert nil to type Logger
	_ = Logger(nil)
}

func negativeResult() Logger {
	// CHECK-DAG: [[@LINE+1]]:{{[0-9]+}}: error{{\[E[0-9]+\]}}: Logger is never nil: an interface with methods has no nil; use Option[Logger] for "maybe" (OWN-P9)
	return nil
}

func negativePair(s string) (Logger, error) {
	// CHECK-DAG: [[@LINE+1]]:{{[0-9]+}}: error{{\[E[0-9]+\]}}: cannot return nil for the Logger result of a function not declared with !: declare it with ! or return Option[Logger]
	return nil, Fail{}
}

func negativeFuncPair(s string) (func(), error) {
	// CHECK-DAG: [[@LINE+1]]:{{[0-9]+}}: error{{\[E[0-9]+\]}}: cannot return nil for the func() result of a function not declared with !: declare it with ! or return Option[func()]
	return nil, Fail{}
}

func positiveFails!(s string) Logger {
	return nil, Fail{}
}

func negativeOption(f Option[func()], l Option[Logger]) {
	// CHECK-DAG: [[@LINE+1]]:{{[0-9]+}}: error{{\[E[0-9]+\]}}: f may be nil; check f != nil first (OWN-P10)
	f()
	// CHECK-DAG: [[@LINE+1]]:{{[0-9]+}}: error{{\[E[0-9]+\]}}: l may be nil; check l != nil first (OWN-P10)
	l.Log("x")
	// CHECK-DAG: [[@LINE+1]]:{{[0-9]+}}: error{{\[E[0-9]+\]}}: cannot use any as the type argument of Option: it already has a nil (OWN-P9)
	var oa Option[any]
	// CHECK-DAG: [[@LINE+1]]:{{[0-9]+}}: error{{\[E[0-9]+\]}}: cannot use error as the type argument of Option: it already has a nil (OWN-P9)
	var oe Option[error]
	// CHECK-DAG: [[@LINE+1]]:{{[0-9]+}}: error{{\[E[0-9]+\]}}: cannot use error as the type argument of Option: it already has a nil (OWN-P9)
	var oal Option[E]
	// CHECK-DAG: [[@LINE+1]]:{{[0-9]+}}: error{{\[E[0-9]+\]}}: cannot use Thing as the type argument of Option: it already has a nil (OWN-P9)
	var ot Option[Thing]
	// CHECK-DAG: [[@LINE+1]]:{{[0-9]+}}: error{{\[E[0-9]+\]}}: cannot use unsafe.Pointer as the type argument of Option: it already has a nil (OWN-P9)
	var op Option[unsafe.Pointer]
	_, _, _, _, _ = oa, oe, oal, ot, op
}

func negativeUse(l Logger, mk func(n int) Logger, n int, ls map[string]Logger, fc chan func(), o Option[Impl]) {
	// CHECK-DAG: [[@LINE+1]]:{{[0-9]+}}: error{{\[E[0-9]+\]}}: make([]Logger, n) creates zero values: Logger has no zero value (interfaces with methods are never nil; use make([]Logger, 0, n) and append)
	_ = make([]Logger, n)
	// CHECK-DAG: [[@LINE+1]]:{{[0-9]+}}: error{{\[E[0-9]+\]}}: ls["a"] may not exist: a missing key or a closed channel would give a Logger, which has no zero value (interfaces with methods are never nil); use the comma-ok form `v, ok := ls["a"]`
	_ = ls["a"]
	// CHECK-DAG: [[@LINE+1]]:{{[0-9]+}}: error{{\[E[0-9]+\]}}: <-fc may not exist: a missing key or a closed channel would give a func(), which has no zero value (funcs are never nil); use the comma-ok form `v, ok := <-fc`
	g := <-fc
	g()
	// An unchecked Option[Impl] is not a Logger.
	// CHECK-DAG: [[@LINE+1]]:{{[0-9]+}}: error{{\[E[0-9]+\]}}: o may be nil; check o != nil first (OWN-P10)
	var lg Logger = o
	lg.Log("z")
}

type Pack struct {
	Log Logger
}

func negativeMove(p *Pack, move l Logger) {
	// CHECK-DAG: [[@LINE+1]]:{{[0-9]+}}: error{{\[E[0-9]+\]}}: cannot move p.Log: the place would be left as zero bytes, and Logger has no zero value; use mem.Replace(&p.Log, v)
	_ = move(p.Log)
	_ = move(l)
}

func main() {}
