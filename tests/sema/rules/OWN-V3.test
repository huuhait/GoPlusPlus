// RUN: not %gopp check %s 2>&1 | FileCheck "--implicit-check-not=error[E" %s
// Rule OWN-V3: owned to ref is implicit; ref to owned is an explicit copy,
// string(v) or []T(v); []T(v) needs elements that satisfy Clone.
package main

type H struct{ fd int }

func (h *H) drop() {}

func positive(s string, r View[string], rs View[[]int]) (string, []int) {
	var v View[string] = s
	_ = v
	return string(r), []int(rs)
}

func negative(r View[[]H]) []H {
	// CHECK: [[@LINE+1]]:13: error{{\[E[0-9]+\]}}: cannot convert r (variable of type View{{\[}}[]H]) to type []H: element type H does not satisfy Clone (OWN-V3)
	return []H(r)
}
