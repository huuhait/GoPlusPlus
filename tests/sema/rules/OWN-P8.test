// RUN: not %gopp check %s 2>&1 | FileCheck --implicit-check-not=error: %s
// Rule OWN-P8: Unique[T] is owning (move-only); Shared[T] and Weak[T] are
// shared handles (copies retain).
package main

type H struct {
	un Unique[int]
	sh Shared[int]
	wk Weak[int]
}

func positive(h *H) {
	s := h.sh
	w := h.wk
	_, _ = s, w
}

func negative(h *H) {
	// CHECK: [[@LINE+1]]:7: error: cannot initialize from h.un: it is a value in another place, and this needs ownership (OWN-R3a)
	u := h.un
	_ = u
}
