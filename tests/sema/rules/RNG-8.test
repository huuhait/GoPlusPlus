// RUN: not %gopp check %s 2>&1 | FileCheck --implicit-check-not=error: %s
// Rule RNG-8: a loop body (or a block or function literal in it) must not
// redeclare a loop variable: `u := u`, `var u = u.Clone()`, a parameter
// named u. Reported by the parser.
package main

type User struct{ Name string }

func fetch(u User) {}

func positive(users []User) {
	for _, u := range users {
		mine := u.Clone()
		go fetch(mine)
	}
}

func negative(users []User) {
	for _, u := range users {
		// CHECK: [[@LINE+1]]:3: error: 'u' redeclares a loop variable: give the copy another name
		u := u.Clone()
		_ = u
	}
	for _, u := range users {
		// CHECK: [[@LINE+1]]:7: error: 'u' redeclares a loop variable: give the copy another name
		var u = u.Clone()
		_ = u
	}
	for _, u := range users {
		// CHECK: [[@LINE+1]]:11: error: 'u' redeclares a loop variable: give the copy another name
		go func(u User) {}(u.Clone())
	}
	for i := 0; i < 3; i++ {
		{
			// CHECK: [[@LINE+1]]:4: error: 'i' redeclares a loop variable: give the copy another name
			i := 1
			_ = i
		}
	}
}
