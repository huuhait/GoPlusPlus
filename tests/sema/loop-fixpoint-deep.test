																															use(o)
																														}
																														// CHECK-DAG: [[@LINE+1]]:35: error{{\[E0329\]}}: o may be nil; check o != nil first (OWN-P10)
																														use(o)
																													}
																													// CHECK-DAG: [[@LINE+1]]:34: error{{\[E0329\]}}: o may be nil; check o != nil first (OWN-P10)
																													use(o)
																												}
																												// CHECK-DAG: [[@LINE+1]]:33: error{{\[E0329\]}}: o may be nil; check o != nil first (OWN-P10)
																												use(o)
																											}
																											// CHECK-DAG: [[@LINE+1]]:32: error{{\[E0329\]}}: o may be nil; check o != nil first (OWN-P10)
																											use(o)
																										}
																										// CHECK-DAG: [[@LINE+1]]:31: error{{\[E0329\]}}: o may be nil; check o != nil first (OWN-P10)
																										use(o)
																									}
																									// CHECK-DAG: [[@LINE+1]]:30: error{{\[E0329\]}}: o may be nil; check o != nil first (OWN-P10)
																									use(o)
																								}
																								// CHECK-DAG: [[@LINE+1]]:29: error{{\[E0329\]}}: o may be nil; check o != nil first (OWN-P10)
																								use(o)
																							}
																							// CHECK-DAG: [[@LINE+1]]:28: error{{\[E0329\]}}: o may be nil; check o != nil first (OWN-P10)
																							use(o)
																						}
																						// CHECK-DAG: [[@LINE+1]]:27: error{{\[E0329\]}}: o may be nil; check o != nil first (OWN-P10)
																						use(o)
																					}
																					// CHECK-DAG: [[@LINE+1]]:26: error{{\[E0329\]}}: o may be nil; check o != nil first (OWN-P10)
																					use(o)
																				}
																				// CHECK-DAG: [[@LINE+1]]:25: error{{\[E0329\]}}: o may be nil; check o != nil first (OWN-P10)
																				use(o)
																			}
																			// CHECK-DAG: [[@LINE+1]]:24: error{{\[E0329\]}}: o may be nil; check o != nil first (OWN-P10)
																			use(o)
																		}
																		// CHECK-DAG: [[@LINE+1]]:23: error{{\[E0329\]}}: o may be nil; check o != nil first (OWN-P10)
																		use(o)
																	}
																	// CHECK-DAG: [[@LINE+1]]:22: error{{\[E0329\]}}: o may be nil; check o != nil first (OWN-P10)
																	use(o)
																}
																// CHECK-DAG: [[@LINE+1]]:21: error{{\[E0329\]}}: o may be nil; check o != nil first (OWN-P10)
																use(o)
															}
															// CHECK-DAG: [[@LINE+1]]:20: error{{\[E0329\]}}: o may be nil; check o != nil first (OWN-P10)
															use(o)
														}
														// CHECK-DAG: [[@LINE+1]]:19: error{{\[E0329\]}}: o may be nil; check o != nil first (OWN-P10)
														use(o)
													}
													// CHECK-DAG: [[@LINE+1]]:18: error{{\[E0329\]}}: o may be nil; check o != nil first (OWN-P10)
													use(o)
												}
												// CHECK-DAG: [[@LINE+1]]:17: error{{\[E0329\]}}: o may be nil; check o != nil first (OWN-P10)
												use(o)
											}
											// CHECK-DAG: [[@LINE+1]]:16: error{{\[E0329\]}}: o may be nil; check o != nil first (OWN-P10)
											use(o)
										}
										// CHECK-DAG: [[@LINE+1]]:15: error{{\[E0329\]}}: o may be nil; check o != nil first (OWN-P10)
										use(o)
									}
									// CHECK-DAG: [[@LINE+1]]:14: error{{\[E0329\]}}: o may be nil; check o != nil first (OWN-P10)
									use(o)
								}
								// CHECK-DAG: [[@LINE+1]]:13: error{{\[E0329\]}}: o may be nil; check o != nil first (OWN-P10)
								use(o)
							}
							// CHECK-DAG: [[@LINE+1]]:12: error{{\[E0329\]}}: o may be nil; check o != nil first (OWN-P10)
							use(o)
						}
						// CHECK-DAG: [[@LINE+1]]:11: error{{\[E0329\]}}: o may be nil; check o != nil first (OWN-P10)
						use(o)
					}
					// CHECK-DAG: [[@LINE+1]]:10: error{{\[E0329\]}}: o may be nil; check o != nil first (OWN-P10)
					use(o)
				}
				// CHECK-DAG: [[@LINE+1]]:9: error{{\[E0329\]}}: o may be nil; check o != nil first (OWN-P10)
				use(o)
