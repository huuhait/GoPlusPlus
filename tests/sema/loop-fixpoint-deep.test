																									for range xs {
																										for range xs {
																											for range xs {
																												for range xs {
																													for range xs {
																														for range xs {
																															for range xs {
																																for range xs {
																																	// CHECK-DAG: [[@LINE+1]]:38: error{{\[E0329\]}}: o may be nil; check o != nil first (the loop assigns o, and a later pass comes back to this use with it unchecked) (OWN-P10)
																																	use(o)
																																	// CHECK-DAG: [[@LINE+1]]:44: error{{\[E0329\]}}: o may be nil; check o != nil first (the loop assigns o, and a later pass comes back to this use with it unchecked) (OWN-P10)
																																	o = nextO(o)
																																	// CHECK-DAG: [[@LINE+1]]:38: error{{\[E0329\]}}: o may be nil; check o != nil first (OWN-P10)
																																	use(o)
																																}
																																// CHECK-DAG: [[@LINE+1]]:37: error{{\[E0329\]}}: o may be nil; check o != nil first (OWN-P10)
																																use(o)
																															}
