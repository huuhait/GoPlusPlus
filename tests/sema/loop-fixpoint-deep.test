// P03.19 (OWN-P10 loop fixpoint): 32 nested loops that each assign the
// Option o and the checked result n. Whether a loop's assumption holds
// depends on the loops around it; deciding that is a walk over the loop
// regions with a set of the regions seen, linear in the nesting (asked once
// per path it was exponential: over a minute at this depth). Good side:
// every back edge checks, no error. Bad side: the innermost loop comes back
// unchecked, so every use of o is an error.
// RUN: not %gopp check --check-error-limit=0 %s 2>&1 | FileCheck "--implicit-check-not=error[E" %s
package main

type Node struct{ V int }

func firstO() Option[*Node]
func nextO(n *Node) Option[*Node]
func first() (*Node, error)
func next(n *Node) (*Node, error)
func use(n *Node) {}

func positive(xs []int) error {
	o := firstO()
	n, err := first()
	if o == nil || err != nil {
		return err
	}
	for range xs {
		for range xs {
			for range xs {
				for range xs {
					for range xs {
						for range xs {
							for range xs {
								for range xs {
									for range xs {
										for range xs {
											for range xs {
												for range xs {
													for range xs {
														for range xs {
															for range xs {
																for range xs {
																	for range xs {
																		for range xs {
																			for range xs {
																				for range xs {
																					for range xs {
																						for range xs {
																							for range xs {
																								for range xs {
																									for range xs {
																										for range xs {
																											for range xs {
																												for range xs {
																													for range xs {
																														for range xs {
																															for range xs {
																																for range xs {
																																	use(o)
																																	use(n)
																																	o = nextO(o)
																																	n, err = next(n)
																																	if o == nil || err != nil {
																																		return err
																																	}
																																	use(o)
																																}
																																use(o)
																															}
																															use(o)
																														}
																														use(o)
																													}
																													use(o)
																												}
																												use(o)
																											}
																											use(o)
																										}
																										use(o)
																									}
																									use(o)
																								}
																								use(o)
																							}
																							use(o)
																						}
																						use(o)
																					}
																					use(o)
																				}
																				use(o)
																			}
																			use(o)
																		}
																		use(o)
																	}
																	use(o)
																}
																use(o)
															}
															use(o)
														}
														use(o)
													}
													use(o)
												}
												use(o)
											}
											use(o)
										}
										use(o)
									}
									use(o)
								}
								use(o)
							}
							use(o)
						}
						use(o)
					}
					use(o)
				}
				use(o)
			}
			use(o)
		}
		use(o)
	}
	return nil
}

func negative(xs []int) {
	o := firstO()
	if o == nil {
		return
	}
	for range xs {
		for range xs {
			for range xs {
				for range xs {
					for range xs {
						for range xs {
							for range xs {
								for range xs {
									for range xs {
										for range xs {
											for range xs {
												for range xs {
													for range xs {
														for range xs {
															for range xs {
																for range xs {
																	for range xs {
																		for range xs {
																			for range xs {
																				for range xs {
																					for range xs {
																						for range xs {
																							for range xs {
