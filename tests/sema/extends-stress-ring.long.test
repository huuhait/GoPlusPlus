// REQUIRES: long
// P03.22: a ring of 200000 types gives one cycle error, in near-linear time.
// RUN: %python %S/Inputs/check-linear.py --label extends-stress-ring --out %t.lin1 --n 200000 --gen "%S/Inputs/gen-extends-stress.py ring {n}" --status 1 --output %t.out -- %gopp check -check-j=1 {file}
// RUN: %python -c "import sys; t=open(sys.argv[1]).read(); assert t.count('error[') == 1 and 'extends cycle: R0 extends R1' in t.replace('\x60', '')" %t.out
package main
