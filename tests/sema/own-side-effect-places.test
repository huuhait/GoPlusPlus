// RUN: not %gopp check %s 2>&1 | FileCheck --implicit-check-not=error: %s
// OWN-R3a, OWN-R4: two places are the same only when every index and selector
// operand is free of side effects. `xs[f()]` twice may be two elements.
package main

func f() int { return 0 }

func a(xs [][]string, i int, move s string) {
	xs[i] = append(xs[i], s)
	// CHECK: [[@LINE+1]]:19: error: append to xs[f()] needs ownership
	xs[f()] = append(xs[f()], "q")
}

func b(xs []string) {
	xs[0], xs[1] = xs[1], xs[0]
	// CHECK: [[@LINE+2]]:21: error: cannot assign from xs[f()]: {{.*}}(OWN-R3a)
	// CHECK: [[@LINE+1]]:30: error: cannot assign from xs[f()]: {{.*}}(OWN-R3a)
	xs[f()], xs[f()] = xs[f()], xs[f()]
}
func main() {}
