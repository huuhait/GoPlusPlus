// REQUIRES: long
// P03.24 round 3 (R16, R17): operands nested as deep as the parser allows:
// `a[a[...]]` 950 deep, `a(a(...))` 600 deep and `a + (a + ...)` 450 deep (the
// parser's limit is 1024 levels of nesting). Every operand of an operator call
// is checked once, so the time is linear (20, 100 and 950 levels: 0.06, 0.02
// and 0.02 s), and the operator path adds little stack over a method call, so
// the default stack is enough (R17: 700 levels overflowed before; 950 pass in
// the Dev build, and 600 is the most that an ASan build passes, so the test
// stays at 600 for both).
// RUN: %python %S/Inputs/gen-ops-stress.py nestidx 950 > %t.ni.gopp
// RUN: timeout 20 %gopp check -check-j=1 --check-error-limit=0 %t.ni.gopp
// RUN: %python %S/Inputs/gen-ops-stress.py nestcall 600 > %t.nc.gopp
// RUN: timeout 20 %gopp check -check-j=1 --check-error-limit=0 %t.nc.gopp
// RUN: timeout 20 %gopp check -check-j=8 --check-error-limit=0 %t.nc.gopp
// RUN: %python %S/Inputs/gen-ops-stress.py nestplus 450 > %t.np.gopp
// RUN: timeout 20 %gopp check -check-j=1 --check-error-limit=0 %t.np.gopp
package main
