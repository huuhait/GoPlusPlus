// RUN: %gopp check %s 2>&1 | FileCheck --allow-empty "--implicit-check-not=error[E" %s
// SLC-8, OWN-V1: a `View[string]` / `View[[]T]` (variable, parameter or field)
// can be sliced; the result is a ref again.
package main

@View
type N struct{ Text View[string] }
@View
type P struct{ src View[string] }

func a(src View[string], xs View[[]int], p *P) {
	_ = src[1:]
	_ = xs[1:]
	var r View[string] = src
	_ = r[1:]
	n := N{}
	n.Text = p.src[1:2]
	_ = p.src[1:]
	var t View[[]int] = xs[1:2]
	_ = t
}
func main() {}
