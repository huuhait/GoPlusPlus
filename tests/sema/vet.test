// RUN: %gopp vet --check-error-limit=0 %s 2>&1 | FileCheck "--implicit-check-not=warning[E" "--implicit-check-not=error[E" %s
// RUN: %gopp vet --check-diag-format=json %s 2>&1 | FileCheck --check-prefix=JSON %s
// RUN: %gopp check %s 2>&1 | not grep warning
// RUN: %gopp vet %s
// RUN: not %gopp vet -Werror %s 2>/dev/null
// P03.12: `gopp vet` reports four lints as warnings (the exit status stays 0
// unless -Werror); `gopp check` reports none. Both sides: the flagged forms
// warn, the nearby good forms are silent (--implicit-check-not).
package lib

type File struct{ n int }

func (f *File) Close() error { return nil }
func (f *File) Stop()        {}

func open(name string) (File, error) { return File{}, nil }

// OWN-V5 is a check error now (err_view_field_without_attr, OWN-V5.test).
func first(s string) View[string] { return s[:1] }

// OWN-R5: drop runs on the zero value too.
type Res struct {
	f error
	n int
}

func (r *Res) drop() {
	// CHECK: vet.test:[[@LINE+1]]:2: warning{{\[E[0-9]+\]}}: drop may run on a zero value: field f is used without a nil check (OWN-R5)
	r.f.Error()
}

// A method that is not named drop is not a drop method.
func (r *Res) release() { r.f.Error() }

type Guarded struct {
	f error
}

func (r *Guarded) drop() {
	if r.f != nil {
		r.f.Error()
	}
}

type Guarded2 struct{ f error }

func (g *Guarded2) drop() {
	if g.f == nil {
		return
	}
	g.f.Error()
}

// A pointer is never nil (ADR-0018), so a pointer field needs no check.
type Ptr struct{ f *File }

func (p *Ptr) drop() { p.f.Stop() }

type Owner struct{ f error }

func (o *Owner) drop() {
	// CHECK: vet.test:[[@LINE+1]]:2: warning{{\[E[0-9]+\]}}: drop may run on a zero value: field f is used without a nil check (OWN-R5)
	o.f.Error()
}

// A @Required error field is never nil (ADR-0016 point 8, drop glue skips a
// moved-from value), so it needs no check either. A func or an interface with
// methods is never nil by its type (ADR-0018 amendment point 3).
type Req struct {
	e error                      @Required
	f func()
	c interface{ Close() error }
}

func (r *Req) drop() {
	_ = r.e.Error()
	r.f()
	_ = r.c.Close()
}

type Iface struct{ c error }

func (i *Iface) drop() {
	// CHECK: vet.test:[[@LINE+1]]:6: warning{{\[E[0-9]+\]}}: drop may run on a zero value: field c is used without a nil check (OWN-R5)
	_ = i.c.Error()
}

type Plain struct {
	n int
	m map[string]int
}

// An int field has a harmless zero value, and a nil map can be read.
func (p *Plain) drop() {
	p.n = 0
	_ = p.m["k"]
}

type NoField struct{ n int }

func (n *NoField) drop() {}

// ERR-10: a ! that panics, outside package main (more in vet-bang.test).
func g() (int, error) { return 1, nil }

func cannotFail() int {
	// CHECK: vet.test:[[@LINE+1]]:8: warning{{\[E[0-9]+\]}}: this ! panics if the call fails: the enclosing function cannot return an error, and package lib is not main
	x := g!()
	return x
}

func canFail!() int {
	x := g!()
	return x
}

// D3.9: defer in a loop body.
func inLoop(names []string) {
	for _, n := range names {
		f, _ := open(n)
		// CHECK: vet.test:[[@LINE+1]]:3: warning{{\[E[0-9]+\]}}: defer in a loop body runs when the function returns
		defer f.Close()
	}
	for i := 0; i < 3; i++ {
		f, _ := open("x")
		// CHECK: vet.test:[[@LINE+1]]:3: warning{{\[E[0-9]+\]}}: defer in a loop body runs when the function returns
		defer f.Close()
	}
	h, _ := open("x")
	defer h.Close()
	for range names {
		func() {
			k, _ := open("y")
			defer k.Close()
		}()
	}
}

// JSON: {"severity":"warning","id":"warn_vet_drop_zero","code":"E{{[0-9]+}}"
// JSON: {"severity":"warning","id":"warn_vet_bang_panics","code":"E{{[0-9]+}}"
// JSON: {"severity":"warning","id":"warn_vet_defer_in_loop","code":"E{{[0-9]+}}"
