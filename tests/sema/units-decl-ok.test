// RUN: %gopp check %s
// P03.25 (UNI-1 to UNI-5, UNI-13): accepted declarations: base units, derived
// units with a literal or parenthesized factor, a group, a chain, a name used
// before its declaration, a unit made of units declared later, @Symbol with a
// valid text, a unit and a type that do not share a scope clash only by name.
package main

@Symbol("m")
unit M
unit S
unit KG
unit A
unit KM = 1000 M
unit N = KG * M / S ^ 2
unit MI = (1609344 / 1000) M
unit HZ = 1 / S
unit (
	MIN = 60 S
	H = 60 MIN
	DAY = 24 H
)
unit LATE = 2 EARLY
unit EARLY = 3 M
unit INCH = 2.54e-2 M
unit THIRD = (1 / 3) M
unit CELSIUSISH = 1 A

// A constant that a factor names is checked as Go checks it: `/` of two
// integer constants is Go's integer division there (Seven2 is 3), only the
// factor expression itself divides exactly.
const Seven2 = 7 / 2
unit THREE = (Seven2) M
unit THREEHALF = (7 / 2) M
var _ [Seven2]int = [3]int{}
var _ float64[THREE] = 1.0[EARLY]                 // one unit: 3 M
var _ float64[THREEHALF] = 1.0[M].In[THREEHALF]() // 7/2 M, exact

// identical types: the same canonical unit written four ways
var a1 float64[KM/H] = 1.0[KM/H]
var a2 float64[KM*H^-1] = a1
var a3 float64[(KM)/(H)] = a2
var _ = a3

func main() {}
