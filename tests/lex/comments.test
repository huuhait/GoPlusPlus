// RUN: %gopp parse -dump-tokens -dump-comments %S/Inputs/comments.gopp | FileCheck --match-full-lines --strict-whitespace %s

// CHECK:1:1 kw_package 'package'
// CHECK-NEXT:1:9 ident 'p'
// CHECK-NEXT:1:10 semi '\n'
// CHECK-NEXT:2:1 comment '// line comment'
// CHECK-NEXT:3:1 comment '/* block */'
// CHECK-NEXT:3:13 ident 'x'
// CHECK-NEXT:3:15 comment '/* between */'
// CHECK-NEXT:3:29 ident 'y'
// CHECK-NEXT:3:30 semi '\n'
// CHECK-NEXT:4:1 comment '/* multi\n   line */'
// CHECK-NEXT:6:1 ident 'z'
// CHECK-NEXT:6:3 comment '// trailing'
// CHECK-NEXT:6:14 semi '\n'
// CHECK-NEXT:7:1 comment '//go:build ignore'
// CHECK-NEXT:8:1 comment '/**/'
// CHECK-NEXT:8:6 comment '/***/'
// CHECK-NEXT:8:12 comment '/* * / */'
// CHECK-NEXT:9:1 eof
