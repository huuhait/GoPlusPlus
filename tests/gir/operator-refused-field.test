// RUN: not %gopp build -emit=llvm %s -o %t.ll 2>&1 | FileCheck --implicit-check-not=error[E %s
// RUN: not %gopp build -emit=llvm %S/../sema/operators-places-dump.test -o %t.2.ll 2>&1 | FileCheck --check-prefix=PLACES %s
// A field of an operator call's result, `(a + b).x`, while operator methods
// are not lowered (P04.23): the operator is refused with E0439 and nothing
// more; the lowering went on with the refused operand's stand-in and asserted
// on its field (Builder.cpp, FuncBuilder::field: "no such field"). The second
// line is the program where the review found it.
package main

type V struct{ x int }

func (a V) + (b V) V { return a }

func inner(n int, a, b V) {
	n += (a + b).x
	_ = n
}

func main() {}

// CHECK: :12:1: error[E0439]: an operator method (P04.23) is not supported
// CHECK: :15:8: error[E0439]: an operator method (P04.23) is not supported
// PLACES: error[E0439]: an operator method (P04.23) is not supported
// PLACES-NOT: Assertion
