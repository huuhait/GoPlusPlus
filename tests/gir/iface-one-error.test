// RUN: %gopp build -emit=gir %s 2>&1 | FileCheck --implicit-check-not=error[E %s
// P04.06 review R4, R6: what the lowering refuses is reported once, naming
// the task, and what follows it does not report again. Since P04.07 and
// P04.10 nothing in this file is refused any more, so it is all the other
// side: a func value and a func literal boxed in an interface (`funcs`), an
// interface with a method that fails with `!` (P04.10 lowers it like
// `Load(p int) (int, error)`: its conversion, a call with the results taken
// apart, the nil check of the error, an assertion to it, a type switch case
// of it, a comparison of two of them) and the interface `M` next to it lower
// and report nothing.
package main

type L interface{ Load!(p int) int }

type M interface{ Get() int }

type X struct{}

func (X) Load(p int) (int, error) { return p, nil }
func (X) Get() int                 { return 1 }

func g() {}

func funcs() {
	var a any = g
	var b any = func() {}
	_, _ = a, b
}

func fails() {
	var l L = X{}
	n, err := l.Load(3)
	if err == nil {
		println(n)
	}
	var x any = X{}
	if k, ok := x.(L); ok {
		_ = k
	}
	switch x.(type) {
	case L:
		println("L")
	}
	var l2 L = X{}
	println(l == l2)
	var m M = X{}
	println(m.Get())
}

func main() {
	funcs()
	fails()
}

// CHECK: fn _GPF4mainE5funcs(
// CHECK: fn _GPF4mainE5fails(
