// RUN: not %gopp build -emit=gir %s 2>&1 | FileCheck %s
// P04.11/P04.18 (D4.4): what C and Go++ cannot yet exchange. A callback is a
// parameter of an @Extern function (callback.test); a function
// RETURNED from C, a function inside an Option or a struct, and a function
// parameter of an @Export function are function values, which have an
// environment C cannot carry: each is one E0439 naming P07.08 (P07.13 for
// the @Export one), at the declaration. The C
// function next to them, which takes only what Go++ passes by value, and the
// callback and @Export that work, are fine (extern.test, cabi-kinds.test).
package main

type HasFunc struct{ f func() }

@Extern("C")
func qsortlike(cmp func(a, b int32) int32)

@Extern("C")
func registrar() func()

@Export("C")
func callback(x int32) int32 {
	return x
}

@Export("C")
func takesFunc(f func(int32) int32) int32 {
	return 0
}

@Extern("C")
func callbackOpt(f Option[func()])

@Extern("C")
func callbackField(h HasFunc)

@Extern("C")
func fine(x int32) int32

func main() {
	_ = fine(1)
	_ = callback(2)
}

// CHECK: :17:1: error[E0439]: a function returned from C (P07.08) is not supported by code generation yet (P04)
// CHECK: :25:1: error[E0439]: a function parameter of an @Export function (P07.13) is not supported by code generation yet (P04)
// CHECK: :30:1: error[E0439]: a func value passed to C (P07.08) is not supported by code generation yet (P04)
// CHECK: :33:1: error[E0439]: a func value inside a C type (P07.08) is not supported by code generation yet (P04)
// CHECK-NOT: error
