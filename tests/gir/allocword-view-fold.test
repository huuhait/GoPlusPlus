// RUN: %gopp build -emit=gir -gir-no-locs %s | FileCheck %s
// RUN: %gopp build -emit=llvm %s | FileCheck --check-prefix=LL %s
// RUN: %gopp build -opt=2 -emit=llvm %s | FileCheck --check-prefix=O2 %s
// P04.25 (ADR-0029): an owned `[]T` is Slice(ptr, len, cap, alloc). The word is
// null (the global allocator) for what `make`, a literal and a conversion
// build; `append` reads the slice's own word, passes it to grow_slice and keeps
// it in the result; passing an owned slice to a borrowed parameter or making a
// view drops the word (a pair, no read of field 3), and a `move` parameter
// passes the whole header. Both sides: each CHECK-NOT below fails when the
// word is read where it must not be, and the `.3` reads and the 4-word
// aggregates must be there where the word must be kept. (allocword-borrow.test
// has the borrowed and `move` parameters of a function that appends.)
package main

func borrowed(xs []int) int { return xs[0] }

func moved(move xs []int) int { return len(xs) }

func main() {
	s := []int{1, 2, 3}
	println(borrowed(s))
	v := s[1:]
	println(len(v))
	s = append(s, 4)
	k := make([]int, 2)
	println(moved(k))
}

// A borrowed parameter is the pair (ptr, len); the callee builds its own
// header with cap = len and a null word.
// CHECK-LABEL: fn _GPF4mainE8borrowed(_1: (*i64, u64)) -> i64
// CHECK: slice []i64 {copy _1.0, copy _1.1, copy _1.1, const null: *u8}
// A move parameter keeps all four words.
// CHECK-LABEL: fn _GPF4mainE5moved(_1: []i64) -> i64
// CHECK-LABEL: fn _GPF4mainE4main()
// A literal has the null word.
// CHECK: [[LIT:_[0-9]+]] = slice []i64 {copy _{{[0-9]+}}, const 3: u64, const 3: u64, const null: *u8}
// CHECK: [[S:_[0-9]+]] = copy [[LIT]]
// Borrowing: the pair is built from the pointer and the length only.
// CHECK-NOT: [[S]].3
// CHECK: [[PAIR:_[0-9]+]] = tuple (*i64, u64) {copy [[S]].0, copy [[S]].1}
// CHECK-NOT: [[S]].3
// CHECK: call const fn @_GPF4mainE8borrowed(copy [[PAIR]])
// A view is a pair: nothing reads the word (the slicing reads fields 0 to 2).
// CHECK-NOT: .3
// CHECK: tuple (*i64, u64) {copy _{{[0-9]+}}, copy _{{[0-9]+}}}
// append reads the word, passes it to grow_slice first, and the result slice
// keeps it.
// CHECK: call const fn @_GPF4goppE10grow_slice(copy [[H:_[0-9]+]].3,
// CHECK: [[W:_[0-9]+]] = copy [[H]].3
// CHECK: slice []i64 {copy _{{[0-9]+}}, copy _{{[0-9]+}}, copy _{{[0-9]+}}, copy [[W]]}
// make has the null word, and a `move` argument passes the header whole.
// CHECK: slice []i64 {{{.*}}, const null: *u8}
// CHECK: call const fn @_GPF4mainE5moved(copy {{_[0-9]+}})

// The global allocator is a direct call where the word is known to be null
// (a literal); append's growth passes the slice's word to grow_slice, whose
// allocation goes through mem_resize_in: a null word is mem_resize, another
// one the table of the allocator object, called with the C ABI of its scalar
// signature (the `zero` flag is extended as a C `bool`). Only the table's
// alloc is called: no resize call (P04.25 review R5, resize is P05.05).
// LL: call ptr @_GPF4goppE10mem_resize(ptr null, i64 24, i1 zeroext true)
// LL: call void @_GPF4goppE10grow_slice(ptr nonnull {{%[0-9]+}}, ptr null, ptr nonnull
// LL-LABEL: define internal ptr @_GPF4goppE13mem_resize_in(ptr %0, ptr %1, i64 %2, i64 %3, i1 zeroext %4)
// LL: call ptr @_GPF4goppE10mem_resize(ptr %1, i64 %3, i1 zeroext %4)
// LL: call ptr %{{[0-9]+}}(ptr {{.*}}%0, i64 {{.*}}, i1 zeroext %4)
// LL-NOT: call ptr %{{[0-9]+}}(ptr {{.*}}%0, ptr {{.*}}%1, i64 {{.*}}, i64 {{.*}}, i1 zeroext %4)
// LL: call void @_GPF4goppE10panic_text(
// LL-LABEL: define internal void @_GPF4goppE10grow_slice(
// LL: call ptr @_GPF4goppE13mem_resize_in(ptr %1, ptr null, i64 0,

// At opt 2 the null-word path is inlined and folds: append's growth of the
// literal is a bare calloc, with no call of the dispatch or the table.
// O2-NOT: call ptr @_GPF4goppE13mem_resize_in(
// O2: tail call ptr @calloc(i64 1, i64 48)
// O2-NOT: call ptr @_GPF4goppE13mem_resize_in(
