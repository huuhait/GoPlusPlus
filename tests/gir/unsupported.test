// RUN: not %gopp build -emit=gir %s 2>&1 | FileCheck %s
// RUN: not %gopp build -emit=gir %S/Inputs/unsupported-more.gopp 2>&1 | FileCheck --check-prefix=MORE %s
// P04.01: what M0 cannot lower is reported with E0439 where it is, once per
// construct (an unsupported type at its first use), and the module never
// reaches the printer. Both sides: `type Celsius int` and `ok` are in the
// subset and draw no error, and neither do the map, the range loop and the
// slice (P04.05). (Two files: the driver stops after 10 errors.)
package main

type T struct{ x int }

type MM map[string]int

func (m MM) method() {}

func maps() {
	var m map[string]int
	_ = m
}

func ranges() {
	for i := range 3 {
		_ = i
	}
}

func slices() {
	s := []int{1}
	_ = s
}

func defers() {
	defer println("x")
}

func heap() {
	_ = new_unique(T{1})
}

type Celsius int

func ok(c Celsius) int { return int(c) + 1 }

func main() {
	println(ok(20))
}

// CHECK: :14:1: error[E0439]: a method on a map type (P04.18) is not supported by code generation yet (P04)
// CHECK: :33:2: error[E0439]: a defer statement (P04.07) is not supported by code generation yet (P04)
// CHECK: :37:6: error[E0439]: Unique, Shared and Weak pointers (P05, P04.09) is not supported by code generation yet (P04)
// CHECK-NOT: error
// CHECK-NOT: fn {{.*}}2ok

// The declarations are lowered before the bodies.
// MORE: :7:7: error[E0439]: a function value (P04.07) is not supported
// MORE-NOT: :8:
// MORE: :21:10: error[E0439]: printing a value of type Option<i64> is not supported
// MORE-NOT: error
