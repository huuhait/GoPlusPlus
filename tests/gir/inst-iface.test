// CHECK: inst-iface.gopp:12:6: note: formed here, in the generic body of W{{\[}}Option{{\[}}int8]].Show
// CHECK: inst-iface.gopp:26:17: error[E0446]: cannot instantiate W{{\[}}Option{{\[}}int]].Show
// CHECK: inst-iface.gopp:27:10: error[E0446]: cannot instantiate W{{\[}}Option{{\[}}int16]].Show
// CHECK: inst-iface.gopp:28:17: error[E0446]: cannot instantiate W{{\[}}Option{{\[}}int32]].Show
// CHECK: inst-iface.gopp:29:17: error[E0446]: cannot instantiate W{{\[}}Option{{\[}}int64]].Show
// CHECK: inst-iface.gopp:30:30: error[E0446]: cannot instantiate W{{\[}}Option{{\[}}uint64]].Show
// CHECK: inst-iface.gopp:31:14: error[E0446]: cannot instantiate W{{\[}}Option{{\[}}uint]].Show
