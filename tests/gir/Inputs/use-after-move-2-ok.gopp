package main

type Doc struct {
	Name string
	Tags []string
}

func take(move s []int) int { return len(s) }

func peek(s []int) int { return len(s) }

// The variable is assigned again: usable.
func reassign() int {
	xs := []int{1, 2, 3}
	n := take(xs)
	xs = []int{4}
	return n + len(xs)
}

// Moved on both branches, never read after.
func bothBranches(c bool) int {
	xs := []int{1, 2, 3}
	if c {
		return take(xs)
	}
	return take(xs) + 1
}

// A move in a loop that makes the variable again each round.
func loopFresh() int {
	t := 0
	for i := 0; i < 3; i++ {
		xs := []int{i}
		t += take(xs)
	}
	return t
}

// A borrow is no move.
func borrow() int {
	xs := []int{1, 2, 3}
	return peek(xs) + peek(xs) + len(xs)
}

// p = append(p, ...) moves p into the call and back (an implicit move).
func appendBack() int {
	p := []int{1}
	p = append(p, 2)
	p = append(p, 3)
	return len(p)
}

// A move with the variable assigned in the same statement.
func rebuild(move buf []int) []int {
	buf = append(buf, 1)
	return buf
}

func useRebuild() int {
	b := []int{}
	b = rebuild(b)
	return len(b)
}

// Moved on one branch, assigned again on it.
func branchAssign(c bool) int {
	xs := []int{1, 2, 3}
	if c {
		take(xs)
		xs = nil
	}
	return len(xs)
}

// A trivial value is copied, not moved.
func trivial() int {
	n := 5
	m := n
	return n + m
}

func main() {
	println(reassign(), bothBranches(true), loopFresh(), borrow(), appendBack(), useRebuild(), branchAssign(true), branchAssign(false), trivial())
}
