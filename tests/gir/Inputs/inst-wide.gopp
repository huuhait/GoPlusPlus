package main

// A chain of generics that each call the next with Pair[T, T]: the type
// argument of F_k has 2^(k+1) - 1 parts as a tree, so F12 has 8191, past the
// limit of 4096 (F11 has 4095: inst-wide-ok.gopp). One error, at the call in
// F11, with the chain of instantiations that led there.
type P[A, B any] struct {
	a []A
	b []B
}

func F0[T any](x []T) int { return F1([]P[T, T]{}) + len(x) }
func F1[T any](x []T) int { return F2([]P[T, T]{}) + len(x) }
func F2[T any](x []T) int { return F3([]P[T, T]{}) + len(x) }
func F3[T any](x []T) int { return F4([]P[T, T]{}) + len(x) }
func F4[T any](x []T) int { return F5([]P[T, T]{}) + len(x) }
func F5[T any](x []T) int { return F6([]P[T, T]{}) + len(x) }
func F6[T any](x []T) int { return F7([]P[T, T]{}) + len(x) }
func F7[T any](x []T) int { return F8([]P[T, T]{}) + len(x) }
func F8[T any](x []T) int { return F9([]P[T, T]{}) + len(x) }
func F9[T any](x []T) int { return F10([]P[T, T]{}) + len(x) }
func F10[T any](x []T) int { return F11([]P[T, T]{}) + len(x) }
func F11[T any](x []T) int { return F12([]P[T, T]{}) + len(x) }
func F12[T any](x []T) int { return len(x) }

func main() { println(F0([]int{1})) }
