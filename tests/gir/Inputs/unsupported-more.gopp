package main

type T struct{ name string }

// A func value, and the call of it (no second error for the call).
func values() {
	f := func() {}
	f()
}

// A string that is not a constant in a struct is in the subset (it leaks
// until P04.09).
func owners() T {
	ok := T{"constant"}
	_ = ok
	s := "x"
	return T{s}
}

func opt(o Option[int]) {
	println(o)
}

type Celsius int

func ok(c Celsius) int { return int(c) + 1 }

func main() {
	var t T
	_ = t
	println(ok(20))
}
