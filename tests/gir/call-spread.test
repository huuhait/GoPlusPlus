// RUN: not %gopp build -emit=gir %s 2>&1 | FileCheck --implicit-check-not=error %s
// P04.06 (the call lowering of P04.04, met while porting `f(g())` with
// interface parameters): the results of a call spread over a variadic
// parameter (`vf(g())`, Go packs the ones past the fixed parameters) are
// refused with one E0439 naming P04.18, which packs them (TODO P04.18), where
// the call is; they were an internal error (V062: the second result passed
// as the `[]int`). The other side: the spread into plain parameters,
// `two(pair())`, and a variadic call with only its fixed argument, `vf(1)`
// (core-variadic.test runs both), draw no error.
package main

func vf(a int, rest ...int) int { return a + len(rest) }

func two(a, b int) int { return a*10 + b }

func pair() (int, int) { return 3, 4 }

func main() {
	println(two(pair()), vf(1))
	println(vf(pair()))
}

// CHECK: call-spread.test:20:10: error[E0439]: spreading the results of a call over a variadic parameter (P04.18) is not supported by code generation yet (P04)
