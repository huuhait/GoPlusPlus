// RUN: %gopp build -emit=gir %s | FileCheck %s
// P04.18 (moved from P04.06, review R5): the results of a call spread over a
// variadic parameter, `vf(g())`, bind the fixed parameters to the first
// results and fill the variadic slice with the rest, as Go does. P04.06
// refused it (one E0439 naming P04.18); before that it was an internal error
// (V062: the second result passed as the `[]int`). The spread into plain
// parameters, `two(pair())`, and a variadic call with only its fixed
// argument, `vf(1)`, are as they were. run/core-variadic.test runs these and
// more (three results, none left for the slice, `...any`) against Go.
package main

func vf(a int, rest ...int) int { return a + len(rest) }

func two(a, b int) int { return a*10 + b }

func pair() (int, int) { return 3, 4 }

func main() {
	println(two(pair()), vf(1))
	println(vf(pair()))
}

// CHECK-LABEL: fn _GPF4mainE4main(
// CHECK: [[T:_[0-9]+]] = call const fn @_GPF4mainE4pair()
// CHECK: call const fn @_GPF4mainE3two(copy [[T]].0, copy [[T]].1)
// CHECK: call const fn @_GPF4mainE2vf(const 1: i64,
// CHECK: [[U:_[0-9]+]] = call const fn @_GPF4mainE4pair()
// CHECK: (*{{_[0-9]+}})[0] = copy [[U]].1
// CHECK: [[S:_[0-9]+]] = slice []i64 {{{.*}}, const 1: u64, const 1: u64,
// CHECK: [[V:_[0-9]+]] = tuple (*i64, u64) {copy [[S]].0, copy [[S]].1}
// CHECK: call const fn @_GPF4mainE2vf(copy [[U]].0, copy [[V]])
