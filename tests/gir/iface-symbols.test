// RUN: %gopp build -emit=obj %s -o %t.o
// RUN: llvm-nm %t.o | FileCheck --check-prefix=NM %s
// RUN: llvm-nm %t.o | FileCheck --check-prefix=OUT %s
// RUN: %gopp build -emit=obj %s -o %t.again.o
// RUN: cmp %t.o %t.again.o
// RUN: %gopp demangle _GPTiN4mainE1T _GPTmN4mainE1T _GPTnN4mainE1J _GPTaN4mainE1TN4mainE1I _GPTIM1MN4mainE1T | FileCheck --check-prefix=DEM %s
// P04.06 review R7: the static data of interfaces is named by P04.17's
// grammar (appendix A.4, A.5): the type descriptor `Ti`, the method table
// `Tm`, the interface descriptor `Tn` (the method keys an assertion to an
// interface walks), the itab `Ta` and the thunk `TI`; `gopp demangle` reads
// each back, two builds give the same object, and no symbol falls outside
// the grammar (no `$`, no `idesc:` key).
package main

type I interface{ M() int }
type J interface{ N() int }
type T struct{ n int }

func (t T) M() int { return t.n }

func main() {
	var i I = T{1}
	var x any = i
	_, ok := x.(J)
	println(i.M(), ok)
}

// OUT-NOT: {{\$|idesc}}
// NM-DAG: _GPTiN4mainE1T
// NM-DAG: _GPTmN4mainE1T
// NM-DAG: _GPTnN4mainE1J
// NM-DAG: _GPTaN4mainE1TN4mainE1I
// NM-DAG: _GPTIM1MN4mainE1T
// DEM: typeinfo for main.T
// DEM-NEXT: method table for main.T
// DEM-NEXT: interface descriptor for main.J
// DEM-NEXT: itab for main.T as main.I
// DEM-NEXT: interface thunk for main.T.M
