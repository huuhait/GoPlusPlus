// RUN: not %gopp build -emit=gir %s 2>&1 | FileCheck --implicit-check-not=error %s
// P04.10: a `!` call that needs a feature of another task is reported ONCE,
// naming that task (E0439), and nothing follows from it. When the task lands
// the form lowers and this test moves into run/bang-return.test (the checks
// below are the "before" side; bang.test and bang-return.test the "after"):
//   - a call through a func value (P04.07, closures): the func value itself
//     is refused where it is made, so the call after it says nothing more;
//   - a generic function (P04.08): refused where it is declared, the `!` call
//     of it says nothing more, with or without the explicit instantiation
//     `gen[int]!(2)` (an instantiation used as a callee is P04.08, not a
//     func value).
package main

type e1 struct{}

func (e1) Error() string { return "x" }

func g(n int) (int, error) { return n, nil }

func gen[T any]!(x T) int { return 1 }

func viaValue() {
	fv := g
	println(fv!(1))
}

func generic() int {
	return gen!(1) + gen[int]!(2)
}

func main() {
	viaValue()
	println(generic())
}

// CHECK: bang-bad-pending.test:{{[0-9]+}}:1: error[E0439]: a generic function (P04.08) is not supported
// CHECK: bang-bad-pending.test:{{[0-9]+}}:8: error[E0439]: a function value (P04.07) is not supported
