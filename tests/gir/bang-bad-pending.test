// RUN: %gopp build -emit=gir %s 2>&1 | FileCheck --allow-empty --implicit-check-not=error %s
// P04.10: a `!` call that needs a feature of another task is reported ONCE,
// naming that task (E0439), and nothing follows from it. When the task lands
// the form lowers and its case moves into a run test (the checks of this file
// are the "before" side; bang.test and bang-return.test the "after"). None is
// pending now:
//   - a call through a func value was here until P04.07 lowered func values:
//     it is the "after" side in run/bang-funcvalue.test (`viaValue` below
//     lowers and draws no error);
//   - a generic function with `!`, `gen!(1)` and `gen[int]!(2)`, was here
//     until P04.08: run/generic-bang.test and Inputs/panics-bang/generic.gopp
//     have both paths.
package main

type e1 struct{}

func (e1) Error() string { return "x" }

func g(n int) (int, error) { return n, nil }

func viaValue() {
	fv := g
	println(fv!(1))
}

func main() {
	viaValue()
}
