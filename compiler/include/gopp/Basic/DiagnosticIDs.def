DIAG(err_own_append_spread, Error, "append(a, b...) with non-trivial elements needs move(b) or b.Clone() on the source (OWN-R4)")
DIAG(err_own_copy_source, Error, "copy(dst, src) with non-trivial elements needs src.Clone() (OWN-R4)")
DIAG(err_own_pinned_copy, Error, "cannot copy %0: type %1 is @Pinned (OWN-R10)")
DIAG(err_own_pinned_move, Error, "cannot move %0: type %1 is @Pinned (OWN-R10)")
