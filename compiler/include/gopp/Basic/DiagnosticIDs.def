// Generics (P03.06)
DIAG(err_got_n_type_args, 239, Error, "%0 type arguments for type %1: have %2, want %3")
DIAG(err_got_n_type_args_func, 240, Error, "got %0 type arguments but %1 has %2 type parameters")
DIAG(err_cannot_use_constraint_outside, 241, Error, "cannot use type %0 outside a type constraint: %1")
