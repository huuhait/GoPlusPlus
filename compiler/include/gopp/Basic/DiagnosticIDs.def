DIAG(err_own_drop_called, Error, "cannot use %0: a drop method runs only when its owner ends, it cannot be called directly (OWN-R7)")
DIAG(err_own_variadic_owning, Error, "a variadic parameter of the owning type %0 must be written `move ...%0` (PAR-5)")
DIAG(err_own_variadic_generic, Error, "variadic parameter of type parameter %0 needs `move` or a Copy constraint (PAR-5)")
DIAG(err_own_return_ref_local, Error, "cannot return a ref into local %0: it dies at the return (OWN-V7)")
DIAG(err_own_return_ref_temp, Error, "cannot return a ref into a temporary: it is freed at the return (OWN-V7)")
DIAG(err_own_return_addr_local, Error, "cannot return the address of local %0: it dies at the return (EXP-11)")
DIAG(err_own_ref_into_temp, Error, "cannot store %0 in %1: it is a ref into a temporary that is freed at the end of the statement (OWN-V6)")
DIAG(err_own_range_var_write, Error, "cannot assign to %0: range variable is a borrowed read-only variable (RNG-1)")
DIAG(err_own_range_alias_invalid, Error, "cannot use & when ranging over %0: there is no element to alias (RNG-1a)")
DIAG(err_own_range_alias_index, Error, "cannot use & on the index or key of %0: & marks the element variable (RNG-1a)")
DIAG(err_own_range_alias_borrowed, Error, "cannot use & on the elements of %0: the array is held by value in borrowed variable %1 (RNG-1a)")
DIAG(err_own_range_alias_func, Error, "`&` needs an iterator that yields pointers (RNG-6a)")
DIAG(err_own_range_mutation, Error, "cannot %0 %1 inside a range over it: it can reallocate the ranged collection (RNG-3)")
DIAG(err_own_range_map_insert, Error, "cannot write %0 inside a range over %1: it may insert a key; only %1[k] with the range key k writes the current entry (RNG-3)")
