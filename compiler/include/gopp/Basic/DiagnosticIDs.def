//===- gopp/Basic/DiagnosticIDs.def - Diagnostic table ----------*- C++ -*-===//
//
// Part of the Go++ project, under the Apache License v2.0 with LLVM Exceptions.
// See LICENSE for license information.
// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
//
//===----------------------------------------------------------------------===//
//
// Every diagnostic the compiler reports (D2.5), in the style of Clang's
// Diagnostic*Kinds.td: DIAG(Name, Code, Severity, Text).
//   - Name is stable: JSON output and tests refer to it. Prefixes: err_,
//     warn_, note_.
//   - Code is the number of the error code E<Code> (D3.11), printed as
//     `error[E0042]: ...` and explained by `gopp explain E0042`. A code never
//     changes and is never reused: docs/errors/codes.lock holds the table and
//     the `check-diag-codes` test fails when an entry is removed, renumbered
//     or its number is taken by another name. A new entry takes the next free
//     number (the test prints it); `custom` has no code (0).
//   - Text may use %0..%9 for the arguments given with `<<` and %% for a
//     percent sign.
// The lexer and parser messages are go/scanner's and go/parser's, so that Go
// programmers see the errors they know (Copyright 2009 The Go Authors;
// BSD-style license, see NOTICE). The tailored messages of P02.07 have their
// own section at the end.
//
//===----------------------------------------------------------------------===//

#ifndef DIAG
#define DIAG(Name, Code, Sev, Text)
#endif

// A message given as a string (tests and tools); compiler code adds an entry.
DIAG(custom, 0, Error, "%0")

//===----------------------------------------------------------------------===//
// Engine
//===----------------------------------------------------------------------===//

DIAG(err_too_many_errors, 1, Error, "too many errors")

//===----------------------------------------------------------------------===//
// Lexer (go/scanner)
//===----------------------------------------------------------------------===//

DIAG(err_lex_illegal_nul, 2, Error, "illegal character NUL")
DIAG(err_lex_utf16, 3, Error, "illegal UTF-8 encoding (got UTF-16)")
DIAG(err_lex_illegal_utf8, 4, Error, "illegal UTF-8 encoding")
DIAG(err_lex_illegal_bom, 5, Error, "illegal byte order mark")
DIAG(err_lex_illegal_char, 6, Error, "illegal character %0")
DIAG(err_lex_curly_quote, 7, Error, "curly quotation mark '%0' (use neutral '\"')")
DIAG(err_lex_comment_unterminated, 8, Error, "comment not terminated")
DIAG(err_lex_radix_point, 9, Error, "invalid radix point in %0")
DIAG(err_lex_no_digits, 10, Error, "%0 has no digits")
DIAG(err_lex_exponent_needs_decimal, 11, Error,
     "'%0' exponent requires decimal mantissa")
DIAG(err_lex_exponent_needs_hex, 12, Error,
     "'%0' exponent requires hexadecimal mantissa")
DIAG(err_lex_exponent_no_digits, 13, Error, "exponent has no digits")
DIAG(err_lex_hex_mantissa_needs_p, 14, Error,
     "hexadecimal mantissa requires a 'p' exponent")
DIAG(err_lex_invalid_digit, 15, Error, "invalid digit '%0' in %1")
DIAG(err_lex_bad_separator, 16, Error, "'_' must separate successive digits")
DIAG(err_lex_escape_unterminated, 17, Error, "escape sequence not terminated")
DIAG(err_lex_escape_unknown, 18, Error, "unknown escape sequence")
DIAG(err_lex_escape_illegal_char, 19, Error,
     "illegal character %0 in escape sequence")
DIAG(err_lex_escape_bad_code_point, 20, Error,
     "escape sequence is invalid Unicode code point")
DIAG(err_lex_rune_unterminated, 21, Error, "rune literal not terminated")
DIAG(err_lex_rune_illegal, 22, Error, "illegal rune literal")
DIAG(err_lex_string_unterminated, 23, Error, "string literal not terminated")
DIAG(err_lex_raw_string_unterminated, 24, Error,
     "raw string literal not terminated")

//===----------------------------------------------------------------------===//
// Parser (go/parser, plus the Go++ grammar)
//===----------------------------------------------------------------------===//

// %0 is what was expected ("';'", "type", "1 expression", ...), %1 the token
// that was found.
DIAG(err_expected, 25, Error, "expected %0")
DIAG(err_expected_found, 26, Error, "expected %0, found %1")
DIAG(err_expected_found_complit, 27, Error,
     "expected %0, found %1 (missing parentheses around composite literal?)")
// %0 is the list: "parameter list", "argument list", "composite literal", ...
DIAG(err_missing_comma, 28, Error, "missing ',' in %0")
DIAG(err_missing_comma_newline, 29, Error, "missing ',' before newline in %0")
DIAG(err_nesting_too_deep, 30, Error, "exceeded max nesting depth")
DIAG(err_expression_too_deeply_nested, 31, Error,
     "expression too deeply nested (limit %0)")
DIAG(err_unexpected_comma_rbrack, 32, Error, "unexpected comma; expecting ]")
DIAG(err_paren_embedded_type, 33, Error, "cannot parenthesize embedded type")
DIAG(err_paren_complit_type, 34, Error,
     "cannot parenthesize type in composite literal")
DIAG(err_missing_type_constraint, 35, Error, "missing type constraint")
DIAG(err_missing_type_param_name, 36, Error, "missing type parameter name")
DIAG(err_missing_type_param_name_or_len, 37, Error,
     "missing type parameter name or invalid array length")
DIAG(err_missing_param_type, 38, Error, "missing parameter type")
DIAG(err_missing_param_name, 39, Error, "missing parameter name")
DIAG(err_dots_not_final, 40, Error, "can only use ... with final parameter")
DIAG(err_dots_invalid, 41, Error, "invalid use of ...")
DIAG(err_empty_type_params, 42, Error, "empty type parameter list")
DIAG(err_func_type_type_params, 43, Error,
     "function type must have no type parameters")
DIAG(err_method_type_params, 44, Error, "method must have no type parameters")
DIAG(err_interface_method_type_params, 45, Error,
     "interface method must have no type parameters")
DIAG(err_slice3_middle_index, 46, Error, "middle index required in 3-index slice")
DIAG(err_slice3_final_index, 47, Error, "final index required in 3-index slice")
DIAG(err_illegal_label, 48, Error, "illegal label declaration")
// %0 is "go" or "defer".
DIAG(err_call_parenthesized, 49, Error,
     "expression in %0 must not be parenthesized")
DIAG(err_call_expected, 50, Error, "expression in %0 must be function call")
DIAG(err_missing_if_condition, 51, Error, "missing condition in if statement")
DIAG(err_var_in_if_init, 52, Error, "var declaration not allowed in if initializer")
DIAG(err_newline_after_if_clause, 53, Error,
     "unexpected newline, expecting { after if clause")
DIAG(err_newline_before_lbrace, 54, Error,
     "unexpected semicolon or newline before {")
DIAG(err_import_path_not_string, 55, Error, "import path must be a string")
DIAG(err_missing_import_path, 56, Error, "missing import path")
DIAG(err_import_after_decl, 57, Error,
     "imports must appear before other declarations")

// Go++: range `&` (D1.21), macros and attributes (D1.14).
DIAG(err_range_alias_assign, 58, Error,
     "'&' on a range variable is only allowed with ':='")
DIAG(err_range_alias_key, 59, Error,
     "'&' is not allowed on the key variable of a range loop")
DIAG(err_macro_args_unterminated, 60, Error,
     "unterminated macro arguments: expected ')'")
DIAG(err_macro_args_mismatched, 61, Error, "mismatched '%0' in macro arguments")
DIAG(err_macro_args_mismatched_expected, 62, Error,
     "mismatched '%0' in macro arguments, expected '%1'")
DIAG(note_to_match_this, 63, Note, "to match this '%0'")
DIAG(err_macro_name_lowercase, 64, Error,
     "macro name '%0' must start with an upper-case letter")
DIAG(err_unknown_macro_kind, 65, Error, "unknown macro parameter kind '%0'")
DIAG(err_attr_on_stmt, 66, Error, "attributes are not allowed on statements")
DIAG(err_attr_on_import, 67, Error,
     "attributes are not allowed on import declarations")

//===----------------------------------------------------------------------===//
// Parser: tailored messages for common mistakes (P02.07)
//===----------------------------------------------------------------------===//
//
// Go habits, habits from other languages and typos that the parser can see.
// Each explains the Go++ way; a fix-it is given only where the fix is exact
// (`gopp parse -fixit` applies them). The table, with one test per row, is
// tests/parse/recovery/README.md.

// Go++ rules on syntax that is valid Go: reported only with
// ParseOptions::CheckLanguageRules (`gopp fmt` turns it off).
DIAG(err_addr_of_complit, 68, Error,
     "allocation is explicit in Go++: use new_unique(T{...}) instead of "
     "&T{...}")
DIAG(err_fails_returns_error, 69, Error,
     "'!' already adds the error result: remove 'error' from the result list")
DIAG(err_loop_var_redeclared, 70, Error,
     "'%0' redeclares a loop variable: give the copy another name")
DIAG(note_loop_var_declared_here, 71, Note, "loop variable '%0' declared here")
DIAG(err_gopp_directive_in_source, 72, Error,
     "'//gopp:%0' is not allowed in a source file: move it to gopp.mod")
DIAG(note_gopp_mod_line, 73, Note, "gopp.mod takes the line '%0 ...'")

// Go++ words used the wrong way.
DIAG(err_move_type_not_shared, 74, Error,
     "'%0' needs its own type: a 'move' parameter does not share its type with "
     "the names before it")
DIAG(err_view_for_ref, 75, Error,
     "there is no 'view' type: a read-only borrow is spelled View[T]")
DIAG(err_own_for_move, 76, Error,
     "there is no '%0' mark: a parameter that takes ownership is marked "
     "'move'")
DIAG(err_ref_bad_elem, 77, Error,
     "'ref' applies to 'string' and slices only (ref string, ref []T)")

// Go habits and typos.
DIAG(err_define_at_top_level, 78, Error,
     "':=' is not allowed outside a function: use 'var %0 = ...'")
DIAG(err_stmt_outside_func, 79, Error,
     "non-declaration statement outside function body")
DIAG(err_else_on_new_line, 80, Error,
     "'else' must be on the same line as the closing '}'")
DIAG(err_newline_after_for_clause, 81, Error,
     "unexpected newline, expecting { after for clause")
DIAG(err_expected_lbrace_after, 82, Error, "expected '{' after %0, found %1")
DIAG(err_assign_in_condition, 83, Error,
     "cannot use an assignment as %0: did you mean '=='?")
DIAG(err_define_in_condition, 84, Error,
     "cannot use a short variable declaration as %0: put it before a ';'")
DIAG(err_define_in_var_decl, 85, Error,
     "':=' is not allowed in a %0 declaration: use '='")
DIAG(err_comma_between_imports, 86, Error,
     "imports are separated by a newline or ';', not by ','")

// Habits from other languages.
DIAG(err_lex_single_quote_string, 87, Error,
     "single quotes make a rune: use double quotes for a string")
DIAG(err_lex_ternary, 88, Error, "Go++ has no '?:' operator: use an if statement")
DIAG(err_incdec_expression, 89, Error,
     "'%0' is a statement in Go++, not an expression")
DIAG(err_prefix_incdec, 90, Error,
     "Go++ has no prefix '%0': write it after the operand")
DIAG(err_while_loop, 91, Error, "Go++ has no 'while': use 'for' with a condition")
DIAG(err_for_in, 92, Error,
     "Go++ has no 'for ... in': write 'for _, x := range ...'")
DIAG(err_elif, 93, Error, "Go++ has no '%0': write 'else if'")
DIAG(err_fn_keyword, 94, Error, "functions are declared with 'func', not '%0'")
DIAG(err_let_decl, 95, Error,
     "Go++ has no '%0': declare with 'var x = v' or 'x := v'")
DIAG(err_decl_without_var, 96, Error,
     "'%0 %1' is not a declaration: write 'var name Type' or 'name := value'")
DIAG(err_struct_decl, 97, Error,
     "Go++ has no '%0' declaration: write 'type %1 struct { ... }'")
DIAG(err_angle_type_params, 98, Error,
     "type parameters use square brackets: 'func %0[T any](...)'")
DIAG(err_arrow_before_result, 99, Error,
     "there is no '->' before the result type: write it after the parameters")
DIAG(err_colon_before_type, 100, Error,
     "no ':' between a name and its type: write '%0 T'")
DIAG(err_brackets_after_type, 101, Error,
     "array and slice brackets go before the element type: write '[]%0'")

//===----------------------------------------------------------------------===//
// gopp fmt
//===----------------------------------------------------------------------===//

// A tree with an error node that no diagnostic explains: a guard that should
// never fire (the file is left as it is).
DIAG(err_fmt_unreported_syntax_error, 102, Error,
     "cannot format: the file has a syntax error")

//===----------------------------------------------------------------------===//
// Sema (P03): messages follow types2's wording so that Go programmers know
// them. Tailored Go++ messages are marked "Go++".
//===----------------------------------------------------------------------===//

// Packages and loading (P03.01)
DIAG(err_load_no_such_package, 103, Error, "package %0 is not in the module: no directory %1")
DIAG(err_load_no_go_files, 104, Error, "no Go++ source files in %0")
DIAG(err_load_mixed_packages, 105, Error, "found packages %0 and %1 in %2")
DIAG(err_load_import_cycle, 106, Error, "import cycle not allowed: %0")
DIAG(err_load_internal_import, 107, Error, "use of internal package %0 not allowed")
DIAG(err_load_bad_build_constraint, 108, Error, "malformed //gopp:build constraint: %0")
DIAG(err_load_bad_import_path, 109, Error, "invalid import path %0")
DIAG(err_load_cannot_read, 110, Error, "cannot read %0: %1")

// Declarations and scopes (P03.03)
DIAG(err_undefined, 111, Error, "undefined: %0")
DIAG(err_redeclared, 112, Error, "%0 redeclared in this block")
DIAG(note_other_declaration, 113, Note, "other declaration of %0")
DIAG(err_declared_not_used, 114, Error, "declared and not used: %0")
DIAG(err_label_not_used, 115, Error, "label %0 declared and not used")
DIAG(err_label_redeclared, 116, Error, "label %0 already declared")
DIAG(err_label_undeclared, 117, Error, "label %0 not declared")
DIAG(err_invalid_break_label, 118, Error, "invalid break label %0")
DIAG(err_invalid_continue_label, 119, Error, "invalid continue label %0")
DIAG(err_goto_jumps_over, 120, Error, "goto %0 jumps over variable declaration at line %1")
DIAG(err_goto_jumps_into, 121, Error, "goto %0 jumps into block")
DIAG(err_not_in_loop_break, 122, Error, "break not in for, switch, or select statement")
DIAG(err_not_in_loop_continue, 123, Error, "continue not in for statement")
DIAG(err_fallthrough_misplaced, 124, Error, "fallthrough statement out of place")
DIAG(err_fallthrough_final, 125, Error, "cannot fallthrough final case in switch")
DIAG(err_fallthrough_type_switch, 126, Error, "cannot fallthrough in type switch")
DIAG(err_unexported_name, 127, Error, "name %0 not exported by package %1")
DIAG(err_package_without_selector, 128, Error, "use of package %0 without selector")
DIAG(err_cannot_use_blank, 129, Error, "cannot use _ as value")
DIAG(err_cannot_use_blank_type, 130, Error, "cannot use _ as value or type")
DIAG(err_init_signature, 131, Error, "func %0 must have no arguments and no return values")
DIAG(err_init_with_body, 132, Error, "missing function body")
DIAG(err_init_type_params, 133, Error, "func %0 must have no type parameters")
DIAG(err_duplicate_method, 134, Error, "method %0.%1 already declared at %2")
DIAG(err_field_and_method, 135, Error, "field and method with the same name %0")
DIAG(err_import_unresolved, 136, Error, "could not import %0 (%1)")

// Types and declarations (P03.04)
DIAG(err_not_a_type, 137, Error, "%0 is not a type")
DIAG(err_not_an_expression, 138, Error, "%0 is not an expression")
DIAG(err_invalid_recursive_type, 139, Error, "invalid recursive type %0")
DIAG(err_invalid_recursive_type_self, 140, Error, "invalid recursive type: %0 refers to itself")
DIAG(err_invalid_cycle, 141, Error, "invalid cycle in declaration of %0")
DIAG(err_init_cycle, 142, Error, "initialization cycle for %0")
DIAG(err_init_cycle_self, 143, Error, "initialization cycle: %0 refers to itself")
DIAG(err_invalid_array_length, 144, Error, "invalid array length %0")
DIAG(err_array_length_not_constant, 145, Error, "array length %0 must be constant")
DIAG(err_array_length_negative, 146, Error, "invalid array length %0")
DIAG(err_array_length_untyped, 147, Error, "array length %0 must be integer")
DIAG(err_invalid_map_key, 148, Error, "invalid map key type %0%1")
DIAG(err_embedded_field_pointer_iface, 149, Error, "embedded field type cannot be a pointer to an interface")
DIAG(err_embedded_field_pointer, 150, Error, "embedded field type cannot be a pointer")
DIAG(err_embedded_field_unsafe_pointer, 151, Error, "embedded field type cannot be unsafe.Pointer")
DIAG(err_embedded_field_type_param, 152, Error, "embedded field type cannot be a (pointer to a) type parameter")
DIAG(err_duplicate_field, 153, Error, "%0 redeclared")
DIAG(err_invalid_receiver, 154, Error, "invalid receiver type %0")
DIAG(err_receiver_method_pkg, 155, Error, "cannot define new methods on non-local type %0")
DIAG(err_receiver_count, 156, Error, "method has multiple receivers")
DIAG(err_receiver_missing, 157, Error, "method has no receiver")
DIAG(err_invalid_method_type_params, 158, Error, "interface method must have no type parameters")
DIAG(err_use_of_untyped_nil, 159, Error, "use of untyped nil in %0")
DIAG(err_cannot_convert, 160, Error, "cannot convert %0 to type %1")
DIAG(err_cannot_convert_cause, 161, Error, "cannot convert %0 to type %1: %2")
DIAG(err_constant_overflows, 162, Error, "constant %0 overflows %1")
DIAG(err_value_truncated, 163, Error, "%0 truncated to %1")
DIAG(err_value_overflows, 164, Error, "%0 overflows %1")
DIAG(err_generic_without_instantiation, 165, Error, "cannot use generic %0 %1 without instantiation%2")

// Expressions (P03.05)
DIAG(err_operator_not_defined, 166, Error, "invalid operation: operator %0 not defined on %1")
DIAG(err_mismatched_types, 167, Error, "invalid operation: %0 (mismatched types %1 and %2)")
DIAG(err_cannot_compare, 168, Error, "invalid operation: %0 (%1)")
DIAG(err_division_by_zero, 169, Error, "invalid operation: division by zero")
DIAG(err_shift_count_negative, 170, Error, "negative shift count %0")
DIAG(err_shift_operand_invalid, 171, Error, "invalid operation: shifted operand %0 must be integer")
DIAG(err_shift_too_large, 172, Error, "invalid shift count %0")
DIAG(err_constant_expression_overflow, 173, Error, "constant %0overflow")
DIAG(err_not_constant, 174, Error, "%0 is not constant")
DIAG(err_no_value, 175, Error, "%0 (no value) used as value")
DIAG(err_multi_value_in_single, 176, Error, "multiple-value %0 (value of type %1) in single-value context")
DIAG(err_builtin_not_used_as_value, 177, Error, "%0 (built-in) must be called")
DIAG(err_undefined_field_or_method, 178, Error, "%0.%1 undefined (%2)")
DIAG(err_not_enough_arguments, 179, Error, "not enough arguments in call to %0\n\thave %1\n\twant %2")
DIAG(err_too_many_arguments, 180, Error, "too many arguments in call to %0\n\thave %1\n\twant %2")
DIAG(err_not_enough_arguments_return, 181, Error, "not enough return values\n\thave %0\n\twant %1")
DIAG(err_too_many_arguments_return, 182, Error, "too many return values\n\thave %0\n\twant %1")
DIAG(err_cannot_index, 183, Error, "invalid operation: cannot index %0")
DIAG(err_cannot_slice, 184, Error, "cannot slice %0")
DIAG(err_cannot_slice_unaddressable, 185, Error, "invalid operation: %0 (slice of unaddressable value)")
DIAG(err_slice_3_string, 186, Error, "invalid operation: 3-index slice of string")
DIAG(err_slice_indices_inverted, 187, Error, "invalid slice indices: %0 < %1")
DIAG(err_index_out_of_bounds, 188, Error, "invalid argument: index %0 out of bounds [0:%1]")
DIAG(err_literal_too_few, 189, Error, "too few values in struct literal of type %0")
DIAG(err_literal_too_many, 190, Error, "too many values in struct literal of type %0")
DIAG(err_literal_mixture, 191, Error, "mixture of field:value and value elements in struct literal")
DIAG(err_literal_duplicate_field, 192, Error, "duplicate field name %0 in struct literal")
DIAG(err_literal_missing_key, 193, Error, "missing key in map literal")
DIAG(err_literal_duplicate_key, 194, Error, "duplicate key %0 in map literal")
DIAG(err_literal_duplicate_index, 195, Error, "duplicate index %0 in array or slice literal")
DIAG(err_literal_index_not_constant, 196, Error, "index %0 must be integer constant")
DIAG(err_literal_unexported_field, 197, Error, "implicit assignment to unexported field %0 in struct literal of type %1")
DIAG(err_literal_invalid_field_name, 198, Error, "invalid field name %0 in struct literal")
DIAG(err_literal_array_too_long, 199, Error, "index %0 is out of bounds (>= %1)")
DIAG(err_literal_missing_type, 200, Error, "invalid composite literal type: missing type")
DIAG(err_type_assertion_non_interface, 201, Error, "invalid operation: %0 is not an interface")
DIAG(err_type_assertion_impossible, 202, Error, "impossible type assertion: %0\n\t%1 does not implement %2 %3")
DIAG(err_type_switch_outside, 203, Error, "invalid syntax tree: use of .(type) outside type switch")
DIAG(err_deref_non_pointer, 204, Error, "invalid operation: cannot indirect %0")
DIAG(err_address_of_unaddressable, 205, Error, "invalid operation: cannot take address of %0")
DIAG(err_cannot_assign, 206, Error, "cannot assign to %0 (neither addressable nor a map index expression)")
DIAG(err_cannot_assign_to, 207, Error, "cannot assign to %0")
DIAG(err_assign_mismatch, 208, Error, "assignment mismatch: %0 but %1")
DIAG(err_returns_mismatch, 209, Error, "assignment mismatch: %0 but %1 returns %2")
DIAG(err_define_no_new_vars, 210, Error, "no new variables on left side of :=")
DIAG(err_non_name_on_left_of_define, 211, Error, "non-name %0 on left side of :=")
DIAG(err_missing_init_expr, 212, Error, "missing init expr for %0")
DIAG(err_extra_init_expr, 213, Error, "extra init expr %0")
