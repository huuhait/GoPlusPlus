DIAG(err_unknown_attribute, 372, Error, "unknown attribute @%0: %1")
DIAG(err_view_copy_pointer, 373, Error, "cannot copy %0 out of a view: %1 holds a raw pointer by value (a *T, a named pointer type, unsafe.Pointer, or a type parameter that may be one), and the copy would share its target, so it could write what the view only reads (OWN-V3); hold the target as Unique[*T] (cloned deeply) or Shared[*T] (read-only), or keep reading it through the view")

