//===- gopp/Basic/DiagnosticIDs.def - Diagnostic table ----------*- C++ -*-===//
//
// Part of the Go++ project, under the Apache License v2.0 with LLVM Exceptions.
// See LICENSE for license information.
// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
//
//===----------------------------------------------------------------------===//
//
// Every diagnostic the compiler reports (D2.5), in the style of Clang's
// Diagnostic*Kinds.td: DIAG(Name, Severity, Text).
//   - Name is stable: JSON output and tests refer to it, and P03.14 attaches
//     the numbered error codes to it (D3.11). Prefixes: err_, warn_, note_.
//   - Text may use %0..%9 for the arguments given with `<<` and %% for a
//     percent sign.
// The lexer and parser messages are go/scanner's and go/parser's, so that Go
// programmers see the errors they know (Copyright 2009 The Go Authors;
// BSD-style license, see NOTICE). The tailored messages of P02.07 have their
// own section at the end.
//
//===----------------------------------------------------------------------===//

#ifndef DIAG
#define DIAG(Name, Sev, Text)
#endif

// A message given as a string (tests and tools); compiler code adds an entry.
DIAG(custom, Error, "%0")

//===----------------------------------------------------------------------===//
// Engine
//===----------------------------------------------------------------------===//

DIAG(err_too_many_errors, Error, "too many errors")

//===----------------------------------------------------------------------===//
// Lexer (go/scanner)
//===----------------------------------------------------------------------===//

DIAG(err_lex_illegal_nul, Error, "illegal character NUL")
DIAG(err_lex_utf16, Error, "illegal UTF-8 encoding (got UTF-16)")
DIAG(err_lex_illegal_utf8, Error, "illegal UTF-8 encoding")
DIAG(err_lex_illegal_bom, Error, "illegal byte order mark")
DIAG(err_lex_illegal_char, Error, "illegal character %0")
DIAG(err_lex_curly_quote, Error, "curly quotation mark '%0' (use neutral '\"')")
DIAG(err_lex_comment_unterminated, Error, "comment not terminated")
DIAG(err_lex_radix_point, Error, "invalid radix point in %0")
DIAG(err_lex_no_digits, Error, "%0 has no digits")
DIAG(err_lex_exponent_needs_decimal, Error,
     "'%0' exponent requires decimal mantissa")
DIAG(err_lex_exponent_needs_hex, Error,
     "'%0' exponent requires hexadecimal mantissa")
DIAG(err_lex_exponent_no_digits, Error, "exponent has no digits")
DIAG(err_lex_hex_mantissa_needs_p, Error,
     "hexadecimal mantissa requires a 'p' exponent")
DIAG(err_lex_invalid_digit, Error, "invalid digit '%0' in %1")
DIAG(err_lex_bad_separator, Error, "'_' must separate successive digits")
DIAG(err_lex_escape_unterminated, Error, "escape sequence not terminated")
DIAG(err_lex_escape_unknown, Error, "unknown escape sequence")
DIAG(err_lex_escape_illegal_char, Error,
     "illegal character %0 in escape sequence")
DIAG(err_lex_escape_bad_code_point, Error,
     "escape sequence is invalid Unicode code point")
DIAG(err_lex_rune_unterminated, Error, "rune literal not terminated")
DIAG(err_lex_rune_illegal, Error, "illegal rune literal")
DIAG(err_lex_string_unterminated, Error, "string literal not terminated")
DIAG(err_lex_raw_string_unterminated, Error,
     "raw string literal not terminated")

//===----------------------------------------------------------------------===//
// Parser (go/parser, plus the Go++ grammar)
//===----------------------------------------------------------------------===//

// %0 is what was expected ("';'", "type", "1 expression", ...), %1 the token
// that was found.
DIAG(err_expected, Error, "expected %0")
DIAG(err_expected_found, Error, "expected %0, found %1")
DIAG(err_expected_found_complit, Error,
     "expected %0, found %1 (missing parentheses around composite literal?)")
// %0 is the list: "parameter list", "argument list", "composite literal", ...
DIAG(err_missing_comma, Error, "missing ',' in %0")
DIAG(err_missing_comma_newline, Error, "missing ',' before newline in %0")
DIAG(err_nesting_too_deep, Error, "exceeded max nesting depth")
DIAG(err_expression_too_deeply_nested, Error,
     "expression too deeply nested (limit %0)")
DIAG(err_unexpected_comma_rbrack, Error, "unexpected comma; expecting ]")
DIAG(err_paren_embedded_type, Error, "cannot parenthesize embedded type")
DIAG(err_paren_complit_type, Error,
     "cannot parenthesize type in composite literal")
DIAG(err_missing_type_constraint, Error, "missing type constraint")
DIAG(err_missing_type_param_name, Error, "missing type parameter name")
DIAG(err_missing_type_param_name_or_len, Error,
     "missing type parameter name or invalid array length")
DIAG(err_missing_param_type, Error, "missing parameter type")
DIAG(err_missing_param_name, Error, "missing parameter name")
DIAG(err_dots_not_final, Error, "can only use ... with final parameter")
DIAG(err_dots_invalid, Error, "invalid use of ...")
DIAG(err_empty_type_params, Error, "empty type parameter list")
DIAG(err_func_type_type_params, Error,
     "function type must have no type parameters")
DIAG(err_method_type_params, Error, "method must have no type parameters")
DIAG(err_interface_method_type_params, Error,
     "interface method must have no type parameters")
DIAG(err_slice3_middle_index, Error, "middle index required in 3-index slice")
DIAG(err_slice3_final_index, Error, "final index required in 3-index slice")
DIAG(err_illegal_label, Error, "illegal label declaration")
// %0 is "go" or "defer".
DIAG(err_call_parenthesized, Error,
     "expression in %0 must not be parenthesized")
DIAG(err_call_expected, Error, "expression in %0 must be function call")
DIAG(err_missing_if_condition, Error, "missing condition in if statement")
DIAG(err_var_in_if_init, Error, "var declaration not allowed in if initializer")
DIAG(err_newline_after_if_clause, Error,
     "unexpected newline, expecting { after if clause")
DIAG(err_newline_before_lbrace, Error,
     "unexpected semicolon or newline before {")
DIAG(err_import_path_not_string, Error, "import path must be a string")
DIAG(err_missing_import_path, Error, "missing import path")
DIAG(err_import_after_decl, Error,
     "imports must appear before other declarations")

// Go++: range `&` (D1.21), macros and attributes (D1.14).
DIAG(err_range_alias_assign, Error,
     "'&' on a range variable is only allowed with ':='")
DIAG(err_range_alias_key, Error,
     "'&' is not allowed on the key variable of a range loop")
DIAG(err_macro_args_unterminated, Error,
     "unterminated macro arguments: expected ')'")
DIAG(err_macro_args_mismatched, Error, "mismatched '%0' in macro arguments")
DIAG(err_macro_args_mismatched_expected, Error,
     "mismatched '%0' in macro arguments, expected '%1'")
DIAG(note_to_match_this, Note, "to match this '%0'")
DIAG(err_macro_name_lowercase, Error,
     "macro name '%0' must start with an upper-case letter")
DIAG(err_unknown_macro_kind, Error, "unknown macro parameter kind '%0'")
DIAG(err_attr_on_stmt, Error, "attributes are not allowed on statements")
DIAG(err_attr_on_import, Error,
     "attributes are not allowed on import declarations")

//===----------------------------------------------------------------------===//
// Parser: tailored messages for common mistakes (P02.07)
//===----------------------------------------------------------------------===//
//
// Go habits, habits from other languages and typos that the parser can see.
// Each explains the Go++ way; a fix-it is given only where the fix is exact
// (`gopp parse -fixit` applies them). The table, with one test per row, is
// tests/parse/recovery/README.md. P03.14 attaches error codes to these names.

// Go++ rules on syntax that is valid Go: reported only with
// ParseOptions::CheckLanguageRules (`gopp fmt` turns it off).
DIAG(err_addr_of_complit, Error,
     "allocation is explicit in Go++: use new_unique(T{...}) instead of "
     "&T{...}")
DIAG(err_fails_returns_error, Error,
     "'!' already adds the error result: remove 'error' from the result list")
DIAG(err_loop_var_redeclared, Error,
     "'%0' redeclares a loop variable: give the copy another name")
DIAG(note_loop_var_declared_here, Note, "loop variable '%0' declared here")
DIAG(err_gopp_directive_in_source, Error,
     "'//gopp:%0' is not allowed in a source file: move it to gopp.mod")
DIAG(note_gopp_mod_line, Note, "gopp.mod takes the line '%0 ...'")

// Go++ words used the wrong way.
DIAG(err_move_type_not_shared, Error,
     "'%0' needs its own type: a 'move' parameter does not share its type with "
     "the names before it")
DIAG(err_view_for_ref, Error,
     "there is no 'view' type: a borrowed string or slice is spelled 'ref'")
DIAG(err_own_for_move, Error,
     "there is no '%0' mark: a parameter that takes ownership is marked "
     "'move'")
DIAG(err_ref_bad_elem, Error,
     "'ref' applies to 'string' and slices only (ref string, ref []T)")

// Go habits and typos.
DIAG(err_define_at_top_level, Error,
     "':=' is not allowed outside a function: use 'var %0 = ...'")
DIAG(err_stmt_outside_func, Error,
     "non-declaration statement outside function body")
DIAG(err_else_on_new_line, Error,
     "'else' must be on the same line as the closing '}'")
DIAG(err_newline_after_for_clause, Error,
     "unexpected newline, expecting { after for clause")
DIAG(err_expected_lbrace_after, Error, "expected '{' after %0, found %1")
DIAG(err_assign_in_condition, Error,
     "cannot use an assignment as %0: did you mean '=='?")
DIAG(err_define_in_condition, Error,
     "cannot use a short variable declaration as %0: put it before a ';'")
DIAG(err_define_in_var_decl, Error,
     "':=' is not allowed in a %0 declaration: use '='")
DIAG(err_comma_between_imports, Error,
     "imports are separated by a newline or ';', not by ','")

// Habits from other languages.
DIAG(err_lex_single_quote_string, Error,
     "single quotes make a rune: use double quotes for a string")
DIAG(err_lex_ternary, Error, "Go++ has no '?:' operator: use an if statement")
DIAG(err_incdec_expression, Error,
     "'%0' is a statement in Go++, not an expression")
DIAG(err_prefix_incdec, Error,
     "Go++ has no prefix '%0': write it after the operand")
DIAG(err_while_loop, Error, "Go++ has no 'while': use 'for' with a condition")
DIAG(err_for_in, Error,
     "Go++ has no 'for ... in': write 'for _, x := range ...'")
DIAG(err_elif, Error, "Go++ has no '%0': write 'else if'")
DIAG(err_fn_keyword, Error, "functions are declared with 'func', not '%0'")
DIAG(err_let_decl, Error,
     "Go++ has no '%0': declare with 'var x = v' or 'x := v'")
DIAG(err_decl_without_var, Error,
     "'%0 %1' is not a declaration: write 'var name Type' or 'name := value'")
DIAG(err_struct_decl, Error,
     "Go++ has no '%0' declaration: write 'type %1 struct { ... }'")
DIAG(err_angle_type_params, Error,
     "type parameters use square brackets: 'func %0[T any](...)'")
DIAG(err_arrow_before_result, Error,
     "there is no '->' before the result type: write it after the parameters")
DIAG(err_colon_before_type, Error,
     "no ':' between a name and its type: write '%0 T'")
DIAG(err_brackets_after_type, Error,
     "array and slice brackets go before the element type: write '[]%0'")

//===----------------------------------------------------------------------===//
// gopp fmt
//===----------------------------------------------------------------------===//

// A tree with an error node that no diagnostic explains: a guard that should
// never fire (the file is left as it is).
DIAG(err_fmt_unreported_syntax_error, Error,
     "cannot format: the file has a syntax error")

//===----------------------------------------------------------------------===//
// Sema (P03): messages follow types2's wording so that Go programmers know
// them. Tailored Go++ messages are marked "Go++".
//===----------------------------------------------------------------------===//

// Packages and loading (P03.01)
DIAG(err_load_no_such_package, Error, "package %0 is not in the module: no directory %1")
DIAG(err_load_no_go_files, Error, "no Go++ source files in %0")
DIAG(err_load_mixed_packages, Error, "found packages %0 and %1 in %2")
DIAG(err_load_import_cycle, Error, "import cycle not allowed: %0")
DIAG(err_load_internal_import, Error, "use of internal package %0 not allowed")
DIAG(err_load_bad_build_constraint, Error, "malformed //gopp:build constraint: %0")
DIAG(err_load_bad_import_path, Error, "invalid import path %0")
DIAG(err_load_cannot_read, Error, "cannot read %0: %1")

// Declarations and scopes (P03.03)
DIAG(err_undefined, Error, "undefined: %0")
DIAG(err_redeclared, Error, "%0 redeclared in this block")
DIAG(note_other_declaration, Note, "other declaration of %0")
DIAG(err_declared_not_used, Error, "declared and not used: %0")
DIAG(err_label_not_used, Error, "label %0 declared and not used")
DIAG(err_label_redeclared, Error, "label %0 already declared")
DIAG(err_label_undeclared, Error, "label %0 not declared")
DIAG(err_invalid_break_label, Error, "invalid break label %0")
DIAG(err_invalid_continue_label, Error, "invalid continue label %0")
DIAG(err_goto_jumps_over, Error, "goto %0 jumps over variable declaration at line %1")
DIAG(err_goto_jumps_into, Error, "goto %0 jumps into block")
DIAG(err_not_in_loop_break, Error, "break not in for, switch, or select statement")
DIAG(err_not_in_loop_continue, Error, "continue not in for statement")
DIAG(err_fallthrough_misplaced, Error, "fallthrough statement out of place")
DIAG(err_fallthrough_final, Error, "cannot fallthrough final case in switch")
DIAG(err_fallthrough_type_switch, Error, "cannot fallthrough in type switch")
DIAG(err_unexported_name, Error, "name %0 not exported by package %1")
DIAG(err_package_without_selector, Error, "use of package %0 without selector")
DIAG(err_cannot_use_blank, Error, "cannot use _ as value")
DIAG(err_cannot_use_blank_type, Error, "cannot use _ as value or type")
DIAG(err_init_signature, Error, "func %0 must have no arguments and no return values")
DIAG(err_init_with_body, Error, "missing function body")
DIAG(err_init_type_params, Error, "func %0 must have no type parameters")
DIAG(err_duplicate_method, Error, "method %0.%1 already declared at %2")
DIAG(err_field_and_method, Error, "field and method with the same name %0")
DIAG(err_import_unresolved, Error, "could not import %0 (%1)")

// Types and declarations (P03.04)
DIAG(err_not_a_type, Error, "%0 is not a type")
DIAG(err_not_an_expression, Error, "%0 is not an expression")
DIAG(err_invalid_recursive_type, Error, "invalid recursive type %0")
DIAG(err_invalid_recursive_type_self, Error, "invalid recursive type: %0 refers to itself")
DIAG(err_invalid_cycle, Error, "invalid cycle in declaration of %0")
DIAG(err_init_cycle, Error, "initialization cycle for %0")
DIAG(err_init_cycle_self, Error, "initialization cycle: %0 refers to itself")
DIAG(err_invalid_array_length, Error, "invalid array length %0")
DIAG(err_array_length_not_constant, Error, "array length %0 must be constant")
DIAG(err_array_length_negative, Error, "invalid array length %0")
DIAG(err_array_length_untyped, Error, "array length %0 must be integer")
DIAG(err_invalid_map_key, Error, "invalid map key type %0%1")
DIAG(err_embedded_field_pointer_iface, Error, "embedded field type cannot be a pointer to an interface")
DIAG(err_embedded_field_pointer, Error, "embedded field type cannot be a pointer")
DIAG(err_embedded_field_unsafe_pointer, Error, "embedded field type cannot be unsafe.Pointer")
DIAG(err_embedded_field_type_param, Error, "embedded field type cannot be a (pointer to a) type parameter")
DIAG(err_duplicate_field, Error, "%0 redeclared")
DIAG(err_invalid_receiver, Error, "invalid receiver type %0")
DIAG(err_receiver_method_pkg, Error, "cannot define new methods on non-local type %0")
DIAG(err_receiver_count, Error, "method has multiple receivers")
DIAG(err_receiver_missing, Error, "method has no receiver")
DIAG(err_invalid_method_type_params, Error, "interface method must have no type parameters")
DIAG(err_use_of_untyped_nil, Error, "use of untyped nil in %0")
DIAG(err_cannot_convert, Error, "cannot convert %0 to type %1")
DIAG(err_cannot_convert_cause, Error, "cannot convert %0 to type %1: %2")
DIAG(err_constant_overflows, Error, "constant %0 overflows %1")
DIAG(err_value_truncated, Error, "%0 truncated to %1")
DIAG(err_value_overflows, Error, "%0 overflows %1")
DIAG(err_generic_without_instantiation, Error, "cannot use generic %0 %1 without instantiation%2")

// Expressions (P03.05)
DIAG(err_operator_not_defined, Error, "invalid operation: operator %0 not defined on %1")
DIAG(err_mismatched_types, Error, "invalid operation: %0 (mismatched types %1 and %2)")
DIAG(err_cannot_compare, Error, "invalid operation: %0 (%1)")
DIAG(err_division_by_zero, Error, "invalid operation: division by zero")
DIAG(err_shift_count_negative, Error, "negative shift count %0")
DIAG(err_shift_operand_invalid, Error, "invalid operation: shifted operand %0 must be integer")
DIAG(err_shift_too_large, Error, "invalid shift count %0")
DIAG(err_constant_expression_overflow, Error, "constant %0overflow")
DIAG(err_not_constant, Error, "%0 is not constant")
DIAG(err_no_value, Error, "%0 (no value) used as value")
DIAG(err_multi_value_in_single, Error, "multiple-value %0 (value of type %1) in single-value context")
DIAG(err_builtin_not_used_as_value, Error, "%0 (built-in) must be called")
DIAG(err_undefined_field_or_method, Error, "%0.%1 undefined (%2)")
DIAG(err_not_enough_arguments, Error, "not enough arguments in call to %0\n\thave %1\n\twant %2")
DIAG(err_too_many_arguments, Error, "too many arguments in call to %0\n\thave %1\n\twant %2")
DIAG(err_not_enough_arguments_return, Error, "not enough return values\n\thave %0\n\twant %1")
DIAG(err_too_many_arguments_return, Error, "too many return values\n\thave %0\n\twant %1")
DIAG(err_cannot_index, Error, "invalid operation: cannot index %0")
DIAG(err_cannot_slice, Error, "cannot slice %0")
DIAG(err_cannot_slice_unaddressable, Error, "invalid operation: %0 (slice of unaddressable value)")
DIAG(err_slice_3_string, Error, "invalid operation: 3-index slice of string")
DIAG(err_slice_indices_inverted, Error, "invalid slice indices: %0 < %1")
DIAG(err_index_out_of_bounds, Error, "invalid argument: index %0 out of bounds [0:%1]")
DIAG(err_literal_too_few, Error, "too few values in struct literal of type %0")
DIAG(err_literal_too_many, Error, "too many values in struct literal of type %0")
DIAG(err_literal_mixture, Error, "mixture of field:value and value elements in struct literal")
DIAG(err_literal_duplicate_field, Error, "duplicate field name %0 in struct literal")
DIAG(err_literal_missing_key, Error, "missing key in map literal")
DIAG(err_literal_duplicate_key, Error, "duplicate key %0 in map literal")
DIAG(err_literal_duplicate_index, Error, "duplicate index %0 in array or slice literal")
DIAG(err_literal_index_not_constant, Error, "index %0 must be integer constant")
DIAG(err_literal_unexported_field, Error, "implicit assignment to unexported field %0 in struct literal of type %1")
DIAG(err_literal_invalid_field_name, Error, "invalid field name %0 in struct literal")
DIAG(err_literal_array_too_long, Error, "index %0 is out of bounds (>= %1)")
DIAG(err_literal_missing_type, Error, "invalid composite literal type: missing type")
DIAG(err_type_assertion_non_interface, Error, "invalid operation: %0 is not an interface")
DIAG(err_type_assertion_impossible, Error, "impossible type assertion: %0\n\t%1 does not implement %2 %3")
DIAG(err_type_switch_outside, Error, "invalid syntax tree: use of .(type) outside type switch")
DIAG(err_deref_non_pointer, Error, "invalid operation: cannot indirect %0")
DIAG(err_address_of_unaddressable, Error, "invalid operation: cannot take address of %0")
DIAG(err_cannot_assign, Error, "cannot assign to %0 (neither addressable nor a map index expression)")
DIAG(err_cannot_assign_to, Error, "cannot assign to %0")
DIAG(err_assign_mismatch, Error, "assignment mismatch: %0 but %1")
DIAG(err_returns_mismatch, Error, "assignment mismatch: %0 but %1 returns %2")
DIAG(err_define_no_new_vars, Error, "no new variables on left side of :=")
DIAG(err_non_name_on_left_of_define, Error, "non-name %0 on left side of :=")
DIAG(err_missing_init_expr, Error, "missing init expr for %0")
DIAG(err_extra_init_expr, Error, "extra init expr %0")
DIAG(err_missing_return, Error, "missing return")
DIAG(err_misplaced_default, Error, "multiple defaults in switch")
DIAG(err_duplicate_case, Error, "duplicate case %0 in expression switch")
DIAG(err_duplicate_type_case, Error, "duplicate case %0 in type switch")
DIAG(err_switch_tag_not_comparable, Error, "cannot switch on %0")
DIAG(err_select_case_invalid, Error, "select case must be receive, send or assign recv")
DIAG(err_range_cannot, Error, "cannot range over %0")
DIAG(err_go_defer_needs_call, Error, "expression in %0 must be function call")
DIAG(err_inc_dec_non_numeric, Error, "invalid operation: %0 (non-numeric type %1)")
DIAG(err_builtin_not_enough_args, Error, "not enough arguments for %0 (expected %1, found %2)")
DIAG(err_builtin_too_many_args, Error, "too many arguments for %0 (expected %1, found %2)")
DIAG(err_builtin_invalid_arg, Error, "invalid argument: %0")
DIAG(err_builtin_invalid_arg_type, Error, "invalid argument: %0 for built-in %1")
DIAG(err_cannot_use_ellipsis, Error, "cannot use ... in call to non-variadic %0")
DIAG(err_cannot_use_ellipsis_builtin, Error, "invalid use of ... with built-in %0")
DIAG(err_cannot_use_ellipsis_with_multi, Error, "cannot use ... with multi-valued expression %0")
DIAG(err_invalid_use_of_dots, Error, "invalid use of ...")
DIAG(err_dots_not_last, Error, "can only use ... with final parameter in list")
DIAG(err_unexpected_type_switch, Error, "%0 is not an interface")
DIAG(err_not_a_generic_type, Error, "%0 is not a generic type")
DIAG(err_shadowed_result, Error, "result parameter %0 not in scope at return")
DIAG(err_iota_outside_const, Error, "cannot use iota outside constant declaration")
DIAG(err_invalid_constant_type, Error, "invalid constant type %0")
DIAG(err_method_expr_ptr_recv, Error, "invalid method expression %0 (needs pointer receiver (*%1).%2)")
DIAG(err_ambiguous_selector, Error, "ambiguous selector %0")

// Generics (P03.06)
DIAG(err_got_n_type_args, Error, "%0 type arguments for type %1: have %2, want %3")
DIAG(err_got_n_type_args_func, Error, "got %0 type arguments but %1 has %2 type parameters")
DIAG(err_cannot_use_constraint_outside, Error, "cannot use type %0 outside a type constraint: %1")
DIAG(err_interface_contains_type_constraints, Error, "cannot use type %0 outside a type constraint: interface contains type constraints")
DIAG(err_interface_is_comparable, Error, "cannot use type %0 outside a type constraint: interface is (or embeds) comparable")
DIAG(err_union_with_interface, Error, "cannot use %0 in union (%1 contains methods)")
DIAG(err_union_comparable, Error, "cannot use comparable in union")
DIAG(err_union_type_param, Error, "term cannot be a type parameter")
DIAG(err_union_overlapping, Error, "overlapping terms %0 and %1")
DIAG(err_union_tilde_underlying, Error, "invalid use of ~ (underlying type of %0 is %1)")
DIAG(err_union_tilde_interface, Error, "invalid use of ~ (%0 is an interface)")
DIAG(err_type_param_bound_not_interface, Error, "cannot use a type parameter as constraint")
DIAG(err_invalid_receiver_type_params, Error, "receiver declares %0, but receiver base type declares %1")
DIAG(err_cannot_use_type_param_as_rhs, Error, "cannot use a type parameter as RHS in type declaration")

// Go++ ownership (P03.07). The rule ID at the end names the spec rule.
DIAG(err_own_r3a_needs_ownership, Error, "cannot %0 %1: it is %2, and this needs ownership (OWN-R3a)")
DIAG(err_own_box_needs_ownership, Error, "cannot %0 %1: it borrows the shared box of an interface value, and this needs ownership (TYP-9)")
DIAG(note_own_fix_clone, Note, "fix-it: %0.Clone() (copy it)")
DIAG(note_own_fix_move, Note, "or move(%0) (take it, leave the zero value)")
DIAG(note_own_fix_move_param, Note, "or make the parameter `move` (a borrowed parameter cannot be moved out of)")
DIAG(note_own_fix_alias, Note, "or declare the range variable with &: for _, &%0 := range ...")
DIAG(err_own_borrowed_read_only, Error, "cannot %0 %1: it is a borrowed variable and read-only at the top level (OWN-R3b)")
DIAG(err_own_binding_read_only, Error, "cannot %0 %1: the binding borrows the shared box of an interface value and is read-only (TYP-9)")
