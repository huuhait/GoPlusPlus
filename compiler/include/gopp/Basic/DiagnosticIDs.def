DIAG(err_unit_dimension, 424, Error, "unit %0 has no dimension: %1 (UNI-2)")
DIAG(err_unit_not_unit, 425, Error, "%0 is %1, not a unit (UNI-3)")
DIAG(err_unit_is_not_expr, 426, Error, "%0 is a unit, not an expression (UNI-1); a unit is valid only inside [ ] after a number literal or a numeric type, in a unit declaration, or as a unit argument")
DIAG(err_unit_expr, 427, Error, "invalid unit expression: %0 (UNI-4)")
DIAG(err_unit_type, 428, Error, "invalid unit type %0: %1 (UNI-6)")
DIAG(err_unit_mismatch, 429, Error, "invalid operation: %0: cannot %1 %2 and %3 (different dimensions) (EXP-34)")
DIAG(err_unit_plain, 430, Error, "invalid operation: %0: cannot %1 a number without a unit %2 a value in %3; write %4 (EXP-35)")
DIAG(err_unit_inexact, 431, Error, "%0: the conversion needs the ratio %1, which cannot be exact for an integer; %2 (EXP-35)")
DIAG(err_unit_conv, 432, Error, "cannot convert %0 to %1: %2 (EXP-32)")
DIAG(err_unit_op, 433, Error, "invalid operation: %0: %1 (EXP-36)")
DIAG(err_unit_symbol, 434, Error, "invalid @Symbol: %0 (UNI-13)")
DIAG(err_unit_scale, 435, Error, "unit factor out of range: %0 (UNI-2)")
DIAG(err_unit_op_method, 436, Error, "cannot declare the operator method %0 on %1: the operators of a unit type are the built-in ones (UNI-15)")
DIAG(err_unit_in, 437, Error, "invalid use of .In: %0 (EXP-32)")
DIAG(err_unit_generic, 438, Error, "invalid unit argument or parameter: %0 (GEN-14)")
DIAG(err_gir_unsupported, 439, Error, "%0 is not supported by code generation yet (P04)")
DIAG(err_gir_verify, 440, Error, "internal error: the generated GIR is invalid: %0")
DIAG(err_codegen, 441, Error, "code generation failed: %0")
DIAG(err_gir_extern_bad, 442, Error, "invalid @Extern on %0: %1")
DIAG(err_gir_no_main, 443, Error, "function main is undeclared in the main package")

DIAG(err_no_stack, 444, Error, "nesting too deep: could not get stack for %0 levels")

#undef DIAG
