DIAG(err_own_case_ref_unreachable, Error, "unreachable case %0: case %1 above also matches a %0 (TYP-9)")
DIAG(err_own_append_borrowed, Error, "append to %0 needs ownership: write append(%1.Clone(), ...) or append(move(%1), ...) (OWN-R4)")
