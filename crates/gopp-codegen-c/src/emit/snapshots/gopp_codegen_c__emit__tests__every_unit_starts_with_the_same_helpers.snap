void _gopp_print_int(int64_t value);
void _gopp_print_uint(uint64_t value);
void _gopp_print_float(double value);
void _gopp_print_string(gopp_string value);
void _gopp_print_pointer(uint8_t *value);
void _gopp_print_space(void);
void _gopp_print_newline(void);
