---
source: crates/gopp-gir/src/lower/tests.rs
expression: "gir(\"package main\n\ntype point struct{ x, y int32 }\n\nfunc made(n int) map[string]int {\n\tages := make(map[string]int, n)\n\tages[\\\"ann\\\"] = n\n\tages[\\\"ann\\\"] += 2\n\tages[\\\"bob\\\"]++\n\tage, ok := ages[\\\"cat\\\"]\n\tif ok {\n\t\tdelete(ages, \\\"cat\\\")\n\t}\n\treturn map[string]int{\\\"one\\\": age, \\\"all\\\": len(ages)}\n}\n\nfunc owner(m map[point]float64, p *map[point]float64) float64 {\n\tn := m\n\tn[point{1, 2}] = p[point{3, 4}]\n\tp[point{5, 6}] = 1.5\n\tclear(n)\n\tif m == nil {\n\t\treturn 0\n\t}\n\treturn n[point{}]\n}\n\")"
