---
source: crates/gopp-syntax/src/parser/tests.rs
expression: "tree(\"package p\n\nimport (\n\t. \\\"dot\\\"\n\t_ \\\"blank\\\"\n\tname \\\"path\\\"\n)\n\nconst (\n\tA = iota\n\tB\n)\n\ntype (\n\tArr    [N]int\n\tSlice  []int\n\tDots   [...]int\n\tGen[P any, Q interface{ ~int | ~string }] struct{}\n\tPtr[P *T,]  struct{}\n\tAlias = map[string]chan<- int\n\tRecv  <-chan <-chan int\n)\n\nfunc f(a, b int, c ...string) (x int, err error) {\n\tif v, ok := m[k]; ok && v == (T{1, 2}) {\n\t}\n\tfor i := 0; i < 10; i++ {\n\t}\n\tfor {\n\t}\n\tswitch x := v.(type) {\n\tcase []int, *T:\n\tdefault:\n\t}\n\tswitch {\n\tcase a < b:\n\t\tfallthrough\n\tcase a > b:\n\t}\n\tselect {\n\tcase v := <-ch:\n\tcase ch <- 1:\n\tdefault:\n\t}\nL:\n\tfor range ch {\n\t\tbreak L\n\t}\n\tgo func() {}()\n\tdefer mu.Unlock()\n\ts = a[1:2:3]\n\ts = a[:]\n\tg := G[int, string]{k: {1, 2}, 3: v}\n\tx, y = y, x\n\tx <<= 2\n\tp := &T{}\n\treturn *p, nil\n}\n\")"
