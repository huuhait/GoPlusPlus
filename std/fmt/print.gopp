// Package fmt formats values and writes them.
package fmt

import "internal/sys"

// Stringer is what a value that says how it is printed has.
type Stringer interface {
	String() string
}

// A writeError is the error of a write that the system refused.
type writeError struct{}

func (writeError) Error() string { return "fmt: the write failed" }

// Print writes its operands to standard output, in the default format
// of each, with a space between two operands when neither is a string.
// It gives the number of bytes that were written.
func Print(a ...any) (n int, err error) {
	return write(appendAll([]byte{}, a, false))
}

// Println writes its operands to standard output, in the default format
// of each, with a space between operands and a newline at the end. It
// gives the number of bytes that were written.
func Println(a ...any) (n int, err error) {
	return write(appendAll([]byte{}, a, true))
}

func write(out []byte) (n int, err error) {
	n = sys.Write(sys.Stdout, out)
	if n < 0 {
		return 0, writeError{}
	}
	return n, nil
}

// appendAll adds the operands to out as Println does (line) or as Print
// does.
func appendAll(out []byte, a []any, line bool) []byte {
	wasString := false
	for i, arg := range a {
		_, isString := arg.(string)
		if i > 0 && (line || !isString && !wasString) {
			out = append(out, ' ')
		}
		out = appendValue(out, arg)
		wasString = isString
	}
	if line {
		out = append(out, '\n')
	}
	return out
}

// appendValue adds the default format of the value to out.
func appendValue(out []byte, arg any) []byte {
	switch v := arg.(type) {
	case nil:
		return append(out, "<nil>"...)
	case string:
		return append(out, v...)
	case bool:
		if v {
			return append(out, "true"...)
		}
		return append(out, "false"...)
	case int:
		return appendInt(out, int64(v))
	case int8:
		return appendInt(out, int64(v))
	case int16:
		return appendInt(out, int64(v))
	case int32:
		return appendInt(out, int64(v))
	case int64:
		return appendInt(out, v)
	case uint:
		return appendUint(out, uint64(v))
	case uint8:
		return appendUint(out, uint64(v))
	case uint16:
		return appendUint(out, uint64(v))
	case uint32:
		return appendUint(out, uint64(v))
	case uint64:
		return appendUint(out, v)
	case uintptr:
		return appendUint(out, uint64(v))
	case error:
		return append(out, v.Error()...)
	case Stringer:
		return append(out, v.String()...)
	}
	return append(out, "?"...)
}

func appendInt(out []byte, v int64) []byte {
	if v < 0 {
		out = append(out, '-')
		// The least int64 has no positive of its own.
		return appendUint(out, uint64(-(v+1))+1)
	}
	return appendUint(out, uint64(v))
}

func appendUint(out []byte, v uint64) []byte {
	var digits [20]byte
	at := len(digits)
	for {
		at--
		digits[at] = byte('0' + v%10)
		v /= 10
		if v == 0 {
			break
		}
	}
	return append(out, digits[at:]...)
}
